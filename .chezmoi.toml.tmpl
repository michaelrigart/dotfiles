{{/*
Chezmoi's OWN config, rendered by `chezmoi init` into ~/.config/chezmoi/chezmoi.toml.

It lives at the source ROOT, not under dot_config/, and that placement is load-bearing.
As a normal target it was a chicken-and-egg: `chezmoi init` generates no config, so the
first `chezmoi apply` ran with an empty [data] and died on the first template needing it
(dot_config/git/allowed_signers.tmpl -> `map has no entry for key "email"`). chezmoi
aborts at the first failing template, and provision.sh runs under `set -e`, so a fresh
machine stopped dead before the Brewfile. At the root, init writes this file BEFORE any
apply and the data is there from the first pass.

Consequence: edits here take effect on `chezmoi init`, NOT on `chezmoi apply`. To pick
up a change on a machine that is already provisioned, re-run `chezmoi init`.
*/ -}}
{{- $name := "Michaël Rigart" -}}
{{- $email := "michael@netronix.be" -}}
{{- $hostname := output "scutil" "--get" "ComputerName" | trim -}}

[edit]
    command = "nvim"

[diff]
    # Builtin unified diff piped through delta (same colorizer as git) so it
    # renders cleanly during `chezmoi apply` prompts. `nvim -d` is kept for
    # [merge], which chezmoi runs fully interactively.
    # --paging=never dumps the diff into the terminal's normal scrollback
    # (instead of an alt-screen `less`), so it stays fully scrollable and
    # selectable for copy.
    pager = "delta --paging=never"
    # Exclude certain paths from diffs
    exclude = ["scripts"]

[merge]
    command = "nvim"
    args = ["-d"]

[data]
    # User information
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    hostname = {{ $hostname | quote }}

    # System information
    is_darwin = {{ eq .chezmoi.os "darwin" }}
    is_linux = {{ eq .chezmoi.os "linux" }}
    is_arm = {{ eq .chezmoi.arch "arm64" }}

    # XDG directories
    xdg_config_home = "{{ .chezmoi.homeDir }}/.config"
    xdg_data_home = "{{ .chezmoi.homeDir }}/.local/share"
    xdg_cache_home = "{{ .chezmoi.homeDir }}/.cache"
    xdg_state_home = "{{ .chezmoi.homeDir }}/.local/state"

[git]
    # Auto-commit and auto-push changes
    autoCommit = false
    autoPush = false

[status]
    # Exclude certain entries from status
    exclude = ["scripts"]

[template]
    options = ["missingkey=error"]

[update]
    # Update configuration
    command = "git"
    args = ["pull", "--rebase"]

# 1Password integration
[onepassword]
    # Use 1Password CLI for secrets
    command = "op"
