#!/usr/bin/python3 -I
"""merge-state <destination> <head> <declared facts>

Print the first three fields of a merge request's merge state (`Merge`, `Checked`, `Check by
hand`). It measures what a tool on the machine records: the review ledger's own gate decision,
`change-facts` for the sizes, the `Checks` line of AGENTS.md on origin's default branch, and the
paths of the change. Every other fact is a required argument that it prints as given. It gates
nothing: the exit status is 0 whenever a block is printed, whatever its state, and 2 for a usage
error, a directory that is not a git repository or a commit that does not exist. It reads
`origin/<destination>` and never fetches, writes nothing and calls no forge.
Pinned to the system Python 3.9 (`/usr/bin/python3`), and nothing newer is used. Git is pinned
too (`/usr/bin/git`, never found through PATH) and runs in an environment built from scratch, so
nothing the caller exports can change the report.
"""
import json
import os
import re
import subprocess
import sys
import unicodedata

ENV = {
    "PATH": "/usr/bin:/bin", "LC_ALL": "C", "GIT_GRAFT_FILE": os.devnull,
    "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_SYSTEM": os.devnull, "GIT_CONFIG_NOSYSTEM": "1",
}
for _name in ("HOME", "XDG_STATE_HOME"):
    if _name in os.environ:
        ENV[_name] = os.environ[_name]
GIT = ["/usr/bin/git", "--no-pager", "--no-replace-objects", "--no-lazy-fetch", "-c", "core.fsmonitor=false"]
DIFF = [
    "diff", "--no-ext-diff", "--no-textconv", "--text", "--no-color", "--no-relative",
    "--diff-algorithm=myers", "--ignore-submodules=none", "-O/dev/null", "--no-renames",
]
HERE = os.path.dirname(os.path.realpath(__file__))

USAGE = """usage: merge-state <destination> <head> --claude-review <type>:<commit> | none
    --suite <passed>/<total> | none  --lint pass | fail | not-run | none
    --ci green | pending | failed | none
    --spec <path> | none  --boundary <what> | none  --check <what> | none
    [--hold <reason>]
       merge-state --help"""
SHORT = "usage: merge-state <destination> <head> <options>; merge-state --help lists them"
CONDITIONS = """The state is `hold` when --hold is given. Otherwise it is `check first` when any condition
below holds, and each one that holds prints one numbered item under `Check by hand`, in this
order. Otherwise it is `safe to merge`, or `safe to merge once CI is green` with --ci pending.

 1. the ledger does not approve this change for this destination
 2. --claude-review none, or its commit is not the head
 3. --suite none, passed < total, or total 0
 4. --lint fail or not-run
 5. --ci failed; or --ci none where the Checks line requires CI
 6. the tier is weak
 7. the change touches a Checks line
 8. the change touches instruction text
 9. any --boundary but none
10. any dependency line
11. code over the limit (2000 with --spec, 150 with --spec none), or size unknown
12. test lines deleted not 0
13. any --check but none

The Checks line is read from origin's default branch, never from the change. Instruction text is
a changed AGENTS.md, CLAUDE.md or SKILL.md, a path under .chezmoitemplates/agents/, or a path
under an `agents` directory directly inside .claude, dot_claude, .codex or dot_codex."""
SINGLE = ("--claude-review", "--suite", "--lint", "--ci", "--spec", "--hold")
REPEAT = ("--boundary", "--check")
TYPES = ("sp-reviewer", "sp-architect")
CHOICES = {"--lint": ("pass", "fail", "not-run", "none"), "--ci": ("green", "pending", "failed", "none")}
SPEC_DIR = "docs/superpowers/specs/"
CHECKS = re.compile(r"\*\*Checks:\*\* (strong|weak) — (.+); CI required to merge: (yes|no)$")
NONCE = re.compile(r"xr-[A-Za-z0-9-]+")
INSTRUCTION_NAMES = ("AGENTS.md", "CLAUDE.md", "SKILL.md")
INSTRUCTION_PARENTS = (".claude", "dot_claude", ".codex", "dot_codex")


class Fail(Exception):
    pass


def run(cmd):
    try:
        return subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, env=ENV,
        )
    except OSError:
        return None


def git(*args):
    done = run(GIT + list(args))
    if done is None:
        raise Fail("cannot run git")
    if done.returncode:
        raise Fail("git %s failed" % args[0])
    return done.stdout


def resolve(side):
    try:
        return git("rev-parse", "--verify", "--quiet", "--end-of-options", side + "^{commit}").strip().decode()
    except Fail:
        raise Fail("no commit named %r" % side)


def printable(data, keep_tab=False):
    """The bytes with every control character and every byte that is not UTF-8 shown as ?."""
    text = data.decode("utf-8", "surrogateescape")
    text = "".join(
        "?" if unicodedata.category(ch) in ("Cc", "Cf", "Cs", "Zl", "Zp") and not (keep_tab and ch == "\t") else ch
        for ch in text
    )
    return text.encode("utf-8")


def show(text, keep_tab=False):
    return printable(os.fsencode(text), keep_tab).decode("utf-8")


def parse(argv):
    """The destination, the head and the options, each checked for form."""
    pos, opts, i = [], {}, 0
    while i < len(argv):
        arg = argv[i]
        if not arg.startswith("--"):
            pos.append(arg)
            i += 1
            continue
        if arg not in SINGLE + REPEAT:
            raise Fail("unknown option %r" % arg)
        if i + 1 >= len(argv) or not argv[i + 1]:
            raise Fail("%s needs a value" % arg)
        value, i = argv[i + 1], i + 2
        if arg in REPEAT:
            opts.setdefault(arg, []).append(value)
        elif arg in opts:
            raise Fail("%s given twice" % arg)
        else:
            opts[arg] = value
    if len(pos) != 2 or pos[0].startswith("-") or not pos[0] or not pos[1]:
        raise Fail(SHORT)
    for name in SINGLE + REPEAT:
        if name not in opts and name != "--hold":
            raise Fail("missing %s" % name)
    for name in REPEAT:
        if "none" in opts[name] and len(opts[name]) > 1:
            raise Fail("%s: none beside another value" % name)
    for name, allowed in CHOICES.items():
        if opts[name] not in allowed:
            raise Fail("%s must be one of %s" % (name, ", ".join(allowed)))
    suite = opts["--suite"]
    if suite != "none" and not re.fullmatch(r"[0-9]+/[0-9]+", suite):
        raise Fail("--suite must be <passed>/<total> or none")
    review = opts["--claude-review"]
    if review != "none":
        kind, _, commit = review.partition(":")
        if kind not in TYPES or not commit:
            raise Fail("--claude-review must be sp-reviewer:<commit>, sp-architect:<commit> or none")
    return pos[0], pos[1], opts


def codex(dest, head):
    """(nonce, None) when the ledger approves this change, else (None, what to tell Michael)."""
    if run(GIT + ["rev-parse", "--verify", "--quiet", "--end-of-options", "refs/remotes/origin/%s^{commit}" % dest]).returncode:
        return None, "origin/%s is not available locally; fetch it" % dest
    ledger = os.environ.get("XREVIEW_LEDGER") or os.path.expanduser("~/.claude/xreview-ledger.py")
    if not os.path.isfile(ledger):
        return None, "no review ledger script at %s" % ledger
    done = run(["/usr/bin/python3", ledger, "decide", ".", dest, "origin/" + dest, head])
    try:
        answer = json.loads(done.stdout)
        reason = answer["reason"]
        approved = answer["allow"] is True
        assert isinstance(reason, str)
    except (AttributeError, KeyError, TypeError, ValueError, AssertionError):
        return None, "the review ledger gave no usable answer"
    if not approved:
        return None, reason or "the review ledger gave no reason"
    nonce = NONCE.search(reason)
    return (nonce.group(), None) if nonce else (None, "the ledger approved without a nonce: " + reason)


def sizes(dest, head):
    """({code, test, deleted, deps}, None), or (None, why) when change-facts cannot answer."""
    for name in ("change-facts", "executable_change-facts"):
        path = os.path.join(HERE, name)
        if os.path.isfile(path):
            break
    else:
        return None, "change-facts is not beside merge-state"
    done = run([path, "origin/%s...%s" % (dest, head)])
    if done is None or done.returncode:
        return None, "change-facts failed"
    text = done.stdout.decode("utf-8", "replace")
    try:
        found = {
            key: int(re.search(pattern, text, re.M).group(1))
            for key, pattern in (
                ("code", r"^code: (\d+) lines"), ("test", r"^test: (\d+) lines"),
                ("deleted", r"^test lines deleted: (\d+)$"),
            )
        }
    except AttributeError:
        return None, "change-facts printed a report merge-state cannot read"
    tail = text.split("\ndependency lines:\n", 1)[1:]
    found["deps"] = [l for l in tail[0].split("\n") if l.startswith("  ")] if tail else []
    return found, None


def checks_line():
    """(tier, CI required) from AGENTS.md on origin's default branch; weak, no CI when unreadable."""
    try:
        ref = git("symbolic-ref", "--quiet", "refs/remotes/origin/HEAD").strip().decode()
        text = git("cat-file", "blob", "%s:AGENTS.md" % ref).decode("utf-8", "replace")
    except Fail:
        return "weak", False
    found = [m for m in map(CHECKS.match, text.split("\n")) if m]
    return (found[0].group(1), found[0].group(3) == "yes") if len(found) == 1 else ("weak", False)


def instruction_text(path):
    parts = path.split("/")
    if parts[-1] in INSTRUCTION_NAMES or path.startswith(".chezmoitemplates/agents/"):
        return True
    return any(a in INSTRUCTION_PARENTS and b == "agents" for a, b in zip(parts[:-2], parts[1:-1]))


def edits_checks(span, path):
    body = False
    for line in git("--literal-pathspecs", *DIFF, "-U0", span, "--", path).split(b"\n"):
        if line.startswith(b"@@"):
            body = True
        elif body and line[:1] in (b"+", b"-") and line[1:].startswith(b"**Checks:**"):
            return True
    return False


def change(dest, head):
    """(paths touching a Checks line, instruction text paths), or None when the change is unreadable."""
    span = "origin/%s...%s" % (dest, head)
    try:
        names = git(*DIFF, "--name-only", "-z", span, "--").split(b"\0")
        paths = sorted(p.decode("utf-8", "surrogateescape") for p in names if p)
        edited = [p for p in paths if p.rsplit("/", 1)[-1] == "AGENTS.md" and edits_checks(span, p)]
    except Fail:
        return None
    return edited, [p for p in paths if instruction_text(p)]


def items_of(dest, head, opts, facts):
    nonce, reason, review, size, why, tier, ci_required, touched = facts
    items = []
    suite = opts["--suite"]
    passed, _, total = suite.partition("/")
    if nonce is None:
        items.append(("Codex pre-merge: " + reason, []))
    if review is None:
        items.append(("Claude review: none", []))
    elif review[1] != head:
        items.append(("Claude review read %s, not the head" % review[1], []))
    if suite == "none" or int(passed) < int(total) or int(total) == 0:
        items.append(("suite: " + suite, []))
    if opts["--lint"] in ("fail", "not-run"):
        items.append(("lint: " + opts["--lint"], []))
    if opts["--ci"] == "failed" or (opts["--ci"] == "none" and ci_required):
        items.append(("CI: " + opts["--ci"], []))
    if tier == "weak":
        items.append(("no Checks: strong line on origin's default branch: the missing check", []))
    if touched is None:
        items.append(("the change against origin/%s cannot be read" % dest, []))
    else:
        if touched[0]:
            items.append(("the change edits a Checks line: " + ", ".join(touched[0]), []))
        if touched[1]:
            items.append(("agent instruction text: " + ", ".join(touched[1]), []))
    items += [("safety boundary: " + b, []) for b in opts["--boundary"] if b != "none"]
    if size and size["deps"]:
        items.append(("new dependency lines:", size["deps"]))
    limit = 150 if opts["--spec"] == "none" else 2000
    if size is None:
        items.append(("size: unknown, %s (limit %d)" % (why, limit), []))
    elif size["code"] > limit:
        items.append(("size: %d code lines, over %d" % (size["code"], limit), []))
    if size and size["deleted"]:
        items.append(("%d test lines deleted: look at each" % size["deleted"], []))
    items += [(c, []) for c in opts["--check"] if c != "none"]
    return items


def main(argv):
    if "--help" in argv:
        sys.stdout.write(USAGE + "\n\n" + CONDITIONS + "\n")
        return 0
    try:
        dest, rev, opts = parse(argv)
        try:
            git("rev-parse", "--git-dir")
        except Fail:
            raise Fail("not a git repository")
        head = resolve(rev)
        review = None
        if opts["--claude-review"] != "none":
            kind, _, commit = opts["--claude-review"].partition(":")
            review = (kind, resolve(commit))
        spec = opts["--spec"]
        if spec != "none":
            try:
                if not spec.startswith(SPEC_DIR) or git("cat-file", "-t", "%s:%s" % (head, spec)).strip() != b"blob":
                    raise Fail("")
            except Fail:
                raise Fail("--spec %r is not a file under %s at the head" % (spec, SPEC_DIR))
    except Fail as err:
        sys.stderr.write("merge-state: %s\n" % err)
        return 2
    nonce, reason = codex(dest, head)
    size, why = sizes(dest, head)
    tier, ci_required = checks_line()
    items = items_of(dest, head, opts, (nonce, reason, review, size, why, tier, ci_required, change(dest, head)))
    boundaries = [b for b in opts["--boundary"] if b != "none"]
    if "--hold" in opts:
        state = "hold: " + opts["--hold"]
    elif items:
        state = "check first"
    else:
        state = "safe to merge once CI is green" if opts["--ci"] == "pending" else "safe to merge"
    lines = [
        "**Merge:** " + state,
        "**Checked:** Codex pre-merge %s; Claude review %s; suite %s; lint %s; CI %s; Checks %s; size %s / %s lines; "
        "tests deleted %s; new dependencies %s; spec %s; safety boundary %s" % (
            "approve %s on %s into %s" % (nonce, head, dest) if nonce else "none",
            "approve (%s, on %s, whole range)" % review if review else "none",
            opts["--suite"], opts["--lint"], opts["--ci"], tier,
            size["code"] if size else "unknown", size["test"] if size else "unknown",
            size["deleted"] if size else "unknown",
            ("%d lines" % len([d for d in size["deps"] if d.startswith("    ")]) if size["deps"] else "none") if size else "unknown",
            spec, ", ".join(boundaries) or "none",
        ),
    ]
    if not items:
        lines.append("**Check by hand:** nothing")
    else:
        lines.append("**Check by hand:**")
        for number, (text, extra) in enumerate(items, 1):
            lines.append("%d. %s" % (number, text))
            lines.extend(extra)
    out = "\n".join(
        show(line, keep_tab=line.startswith("  ")) for line in lines
    ) + "\n"
    try:
        sys.stdout.buffer.write(out.encode("utf-8"))
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
