#!/usr/bin/env bash
# xreview - dispatch a cold review to the repository's Codex pane and collect the answer.
#
# Design: docs/superpowers/specs/2026-09-26-xreview-codex-daemon-design.md, section 7, with
# the pane handling of docs/superpowers/specs/2026-10-01-xreview-reliable-codex-pane-design.md.
# Reviews run on Codex's shared app-server daemon. Dispatch takes the pane's lock (one dispatch
# per pane at a time), then OBSERVES the pane: its foreground process (herdr process-info) and
# whether that TUI holds a connection to the daemon (lsof). Before any keystroke it refuses if
# a thread the pane is on or about to open is running a turn, or cannot be checked. A pane
# already showing the checkpoint thread on a connected TUI is kept as it is. Any other pane is
# FIRST freed with a bounded ladder of ctrl+c pairs - refusing if it will not free - THEN the
# review turn starts, and only THEN is the pane best-effort resumed onto that thread with
# `-C <review root>`; the TUI replays the turn from its start and streams the rest live (F22).
# No keystroke (send-keys) ever reaches the pane once the turn exists: it would interrupt the
# review itself. A pane that fails to resume only warns - the review still runs and collect
# still works. A refusal or warning about the pane carries its screen, as evidence. Two
# PreToolUse guards read the receipts (pre-merge gate, apply window); neither is proven
# enough to be an authorization boundary - treat findings as evidence.
set -euo pipefail
# Without this, a `die` inside a function called via $(...) from ANOTHER function that is
# itself invoked via $(...) (pane_command from inside pane_prepare, say) silently loses its
# exit status: bash historically runs command substitutions with -e off inside them unless
# told to inherit it. Guarded because it is a bash-4.4+ builtin and this must not itself
# abort an ancient system /bin/bash under `set -e`.
shopt -s inherit_errexit 2>/dev/null || true

CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
XR_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
SCHEMA="${XREVIEW_SCHEMA:-$XR_CONFIG/xreview/findings.schema.json}"
REVIEWER="${XREVIEW_REVIEWER:-$XR_CONFIG/xreview/reviewer.md}"
PANE_CMD_FILE="$XR_CONFIG/herdr/codex-pane-command"
# Codex ALWAYS truncates the title's thread-id item to 29 characters plus "..." (F11/F21),
# so this only ever carries a PREFIX (29-36 chars), never a guaranteed full id. A full id
# appears only as thread-title's fallback, for a thread that is not yet named. A prefix is
# resolved to a full id through `xreview-rpc thread-resolve`, never guessed.
ID_RE='^[[:space:]]*([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{5,12})'

die() { printf 'xreview: %s\n' "$1" >&2; exit 1; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

state_dir() {
  local root; root="$(repo_root)"
  printf '%s/xreview/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" \
    "$(printf '%s' "$root" | tr '/' '_' | sed 's/^_//')"
}

# Ids reach file names and command arguments. Thread and turn ids come from Codex and nonces
# are minted below; anything else, including a leading dash, is refused before use.
assert_id() {
  is_safe_id "$1" || die "refusing unsafe identifier: $1"
}

# The non-dying form of assert_id's check, for a caller that has its own recovery path
# for a malformed id (F27) instead of wanting to die on the spot.
is_safe_id() {
  case "$1" in
    ""|-*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# pane_root - the directory whose Codex pane serves this repository (spec 2026-10-01 §4.2). A
# harness worktree (<W>/.claude/worktrees/<name>) is served by the registered worktree W that
# holds it - the main checkout, or a wt sibling with its own pane - and the longest such W
# wins. Anything else is served by its own root.
pane_root() {
  local root w best=""
  root="$(repo_root)"
  while IFS= read -r w; do
    [ -n "$w" ] && [ "$w" != "$root" ] || continue
    case "$root/" in
      "$w/.claude/worktrees/"*) [ "${#w}" -gt "${#best}" ] && best="$w" ;;
    esac
  done < <(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  printf '%s\n' "${best:-$root}"
}

# --- the Codex pane ----------------------------------------------------------------
# The repository's one herdr pane running Codex in the pane root (the repository root, or the
# main checkout's for a harness worktree under .claude/worktrees/). It is the reviewer's
# screen: dispatch frees it before the turn starts, then best-effort resumes it onto the
# review thread once the turn is running.

find_pane() {
  local root snap ids n
  root="$(pane_root)"
  snap="$(herdr pane list 2>/dev/null || true)"
  [ -n "$snap" ] || die "cannot list herdr panes - is herdr running?"
  ids="$(printf '%s' "$snap" | jq -r --arg cwd "$root" \
    '.result.panes[]? | select(.agent == "codex" and ((.cwd | type) == "string") and (.cwd == $cwd or (.cwd | startswith($cwd + "/.claude/worktrees/")))) | .pane_id' 2>/dev/null)" \
    || die "cannot read herdr's pane list"
  # XREVIEW_PANE picks AMONG the valid Codex panes for this root; it does not replace
  # validation. A typo or a stale id pointing at some other pane (the idle Claude Code
  # pane, say) would otherwise get up to three ctrl+c pairs and a `codex …` command typed into it.
  if [ -n "${XREVIEW_PANE:-}" ]; then
    if printf '%s\n' "$ids" | grep -Fqx -- "$XREVIEW_PANE"; then
      printf '%s\n' "$XREVIEW_PANE"; return 0
    fi
    die "XREVIEW_PANE=$XREVIEW_PANE is not a Codex pane in $root"
  fi
  n="$(printf '%s' "$ids" | grep -c . || true)"
  case "$n" in
    1) printf '%s\n' "$ids" ;;
    0) die "no Codex pane for $root. Apply the project layout, or set XREVIEW_PANE" ;;
    *) die "several Codex panes for $root: $(printf '%s' "$ids" | tr '\n' ' ' | sed 's/ $//') - set XREVIEW_PANE to one of them" ;;
  esac
}

pane_field() { # pane_field <pane> <jq-path>
  herdr pane get "$1" 2>/dev/null | jq -r ".result.pane | $2 // empty" 2>/dev/null || true
}

title_id_from() { # title_id_from <raw-title>: the thread id PREFIX at its start, if any
  local t="$1"
  if [[ "$t" =~ $ID_RE ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; fi
}

pane_title_id() { # the thread id PREFIX at the start of the pane's title, if any (29-36 chars)
  title_id_from "$(pane_field "$1" '(.terminal_title_stripped // .terminal_title)')"
}

pane_obj() { # pane_obj <pane>: herdr's pane object, as compact JSON, on a genuinely successful
  # read (exit 0). Exit 1: the READ ITSELF failed - herdr errored or printed nothing, or it
  # exited 0 with an `{"error":…}` envelope or anything else that is not a pane. A failed
  # read is never an observation of anything (I-1).
  local out rc=0
  out="$(herdr pane get "$1" 2>/dev/null)" || rc=$?
  [ "$rc" -eq 0 ] && [ -n "$out" ] || return 1
  printf '%s' "$out" | jq -ce '.result.pane | objects' 2>/dev/null || return 1
}

title_of() { # title_of <pane-json>: the pane's raw title text, or nothing
  printf '%s' "$1" | jq -r '(.terminal_title_stripped // .terminal_title) // empty' 2>/dev/null
}

pane_raw_title() { # pane_raw_title <pane>: prints the raw title text on a genuinely
  # successful, non-empty read (exit 0). Exit 1: the READ ITSELF failed (pane_obj) - never an
  # observation of anything (I-1): pane_resume's wait loop must not read a transient herdr
  # hiccup as "the title does not show the thread yet" and let it count against the wait.
  # Exit 2: the read SUCCEEDED and returned a pane, but its title reads back empty - a real
  # observation, distinct from exit 1. The wait loop treats 1 and 2 alike (both mean "no
  # thread id yet"; only exit 1 additionally checks pane_gone).
  local obj title
  obj="$(pane_obj "$1")" || return 1
  title="$(title_of "$obj")"
  [ -n "$title" ] || return 2
  printf '%s\n' "$title"
}

pane_gone() { # pane_gone <pane>: true (exit 0) when herdr reports the pane closed, called
  # after a failed read. herdr answers a closed pane with exit 1 and a `pane_not_found`
  # envelope on stderr - distinct from any other read failure, which just keeps waiting.
  local err
  err="$(herdr pane get "$1" 2>&1 >/dev/null)" || true
  case "$err" in
    *'"pane_not_found"'*) return 0 ;;
  esac
  return 1
}

# --- observing the pane's process (spec 2026-10-01 §4.3/§4.4; G1, G3) -------------------
pane_proc() { # pane_proc <pane>: herdr's process info for the pane, as compact JSON, on a
  # genuinely successful read; exit 1 on any failure, which is never an observation. Every
  # foreground process must be fully described - an object with a name and a non-empty argv
  # - or the read failed too: a Codex process without them would be passed over by the
  # guard, which could then never check the thread it resumes.
  local out
  out="$(herdr pane process-info --pane "$1" 2>/dev/null)" || return 1
  printf '%s' "$out" | jq -e '.result.process_info
    | (.shell_pid | type == "number")
      and (.foreground_processes | type == "array"
           and all(type == "object" and (.name | type == "string")
                   and (.argv | type == "array" and length > 0)))' >/dev/null 2>&1 || return 1
  printf '%s' "$out" | jq -c '.result.process_info'
}

proc_codex() { # proc_codex <proc-json>: the pane's foreground Codex process, preferring the
  # process-group leader (the TUI) over any codex child in its group; nothing when there is none.
  printf '%s' "$1" | jq -c '.foreground_process_group_id as $g
    | [.foreground_processes[]? | select(.name == "codex" or .argv0 == "codex")]
    | (map(select(.pid == $g)) + .) | .[0] // empty' 2>/dev/null
}

proc_freed() { # proc_freed <proc-json>: the pane's shell is back in the foreground
  printf '%s' "$1" | jq -e '.foreground_process_group_id == .shell_pid' >/dev/null 2>&1
}

resume_target() { # resume_target <codex-proc-json>: the thread id this Codex process resumes.
  # Only three shapes are readable: no positional at all (a fresh session), `resume <id>`, and
  # `fork` or `fork <id>`. Nothing for the first and last; the id for the middle one. Exit 1 for
  # anything else - `resume --last`, a picker, a name, a prompt (`codex "fix it"`), another
  # subcommand (`codex exec …`), anything after the id, a `--` anywhere, or `resume` after
  # another positional (the value of a flag this list does not know, say).
  # Values of the value-taking flags are skipped, so `codex -m resume` is no resume.
  local r
  r="$(printf '%s' "$1" | jq -r '
    ["-m","--model","-p","--profile","-s","--sandbox","-a","--ask-for-approval","-C","--cd",
     "--add-dir","-c","--config","--enable","--disable","--remote","--remote-auth-token-env",
     "--local-provider","-i","--image"] as $vf
    | ((.argv // [])[1:]) as $a
    | (reduce range(0; $a | length) as $i ({skip: false, pos: []};
        if .skip then .skip = false
        elif ($vf | index([$a[$i]])) then .skip = true
        elif ($a[$i] | startswith("-")) then .
        else .pos += [$a[$i]] end)).pos as $p
    | if ($a | any(. == "--")) then "bad"
      elif ($p | length) == 0 then "none"
      elif $p[0] == "resume" and ($p | length) == 2
           and ($p[1] | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) then "id " + $p[1]
      elif $p[0] == "fork" and ($p | length) <= 2 then "none"
      else "bad" end' 2>/dev/null)" || return 1
  case "$r" in
    none) return 0 ;;
    "id "*) printf '%s\n' "${r#id }" ;;
    *) return 1 ;;
  esac
}

daemon_pid() { # the daemon server's pid from daemon.pid (G3), or nothing
  sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$CODEX_HOME_DIR/app-server-daemon/daemon.pid" 2>/dev/null | head -1
}

connected_to_daemon() { # connected_to_daemon <pid>: does <pid> hold a unix socket whose peer is
  # one of the daemon's own sockets (G3)? A TUI left from before a daemon restart, or one
  # running an embedded server (-c, --no-daemon), has none. Any failed read is "no".
  local dpid mine peers
  dpid="$(daemon_pid)"; [ -n "$dpid" ] || return 1
  mine="$(lsof -a -U -p "$dpid" -F d 2>/dev/null | sed -n 's/^d//p' | sort -u)"
  peers="$(lsof -a -U -p "$1" -F n 2>/dev/null | sed -n 's/^n->//p' | sort -u)"
  [ -n "$mine" ] && [ -n "$peers" ] || return 1
  [ -n "$(comm -12 <(printf '%s\n' "$mine") <(printf '%s\n' "$peers"))" ]
}

thread_state_or_die() { # thread_state_or_die <pane> <thread>: die if <thread> is running a
  # turn, or if whether it is cannot be read (spec 2026-10-01 §4.4: fail closed).
  local out
  if ! out="$(xreview-rpc thread-status --thread "$2" 2>/dev/null)" \
     || ! printf '%s' "$out" | jq -e '.running | type == "boolean"' >/dev/null 2>&1; then
    die "cannot read whether thread $2 in the Codex pane $1 is running; no review was started"
  fi
  if printf '%s' "$out" | jq -e '.running == true' >/dev/null 2>&1; then
    die "the Codex pane $1's thread $2 is mid-turn; wait for it to finish, then dispatch again"
  fi
}

# pane_guard <pane> <proc-json> - spec 2026-10-01 §4.4 step 1, before any keystroke: every
# thread the pane's TUI is on (its title) or about to open (its argv: a TUI held on a
# pre-session screen has no title yet) must be known not to be running a turn. herdr's
# agent field never substitutes for an unreadable process.
pane_guard() {
  local pane="$1" proc="$2" obj status prefix t rrc=0 codex target
  # One successful read serves both the status and the title: a read that fails is a check
  # that could not be completed, never an idle pane or an empty title.
  obj="$(pane_obj "$pane")" \
    || die "cannot read the Codex pane $pane (herdr pane get); no review was started"
  status="$(printf '%s' "$obj" | jq -r '.agent_status // empty' 2>/dev/null)"
  case "$status" in
    working|blocked) die "the Codex pane $pane is mid-turn; wait for it to finish, then dispatch again" ;;
  esac
  # The title only ever carries a prefix (F11/F21). Resolve exit 1 - no loaded thread starts
  # with it (or several do) - does not block, as before. Any other failure means the daemon
  # could not be asked, and that refuses.
  prefix="$(title_id_from "$(title_of "$obj")")"
  if [ -n "$prefix" ]; then
    t="$(xreview-rpc thread-resolve --prefix "$prefix" 2>/dev/null)" || rrc=$?
    case "$rrc" in
      0) is_safe_id "$t" \
           || die "cannot read whether thread $prefix in the Codex pane $pane is running; no review was started"
         thread_state_or_die "$pane" "$t" ;;
      1) ;;
      *) die "cannot read whether thread $prefix in the Codex pane $pane is running; no review was started" ;;
    esac
  fi
  codex="$(proc_codex "$proc")"
  # A foreground group that is not the shell and holds no Codex process is no observation: it
  # could be a TUI on a pre-session screen, resuming a thread the guard cannot read.
  if [ -z "$codex" ] && ! proc_freed "$proc"; then
    die "cannot read the Codex pane $pane's process (herdr pane process-info); no review was started"
  fi
  if [ -n "$codex" ]; then
    target="$(resume_target "$codex")" \
      || die "the Codex pane $pane is resuming something other than a thread id; no review was started"
    [ -z "$target" ] || thread_state_or_die "$pane" "$target"
  fi
}

# --- the screen, as evidence (spec 2026-10-01 §4.6) ---------------------------------------
pane_screen() { # pane_screen <pane>: the bottom of the pane's visible screen - its last 12
  # lines, and of those the last 1,000 bytes, since the bottom rows hold the prompt that is
  # waiting - control characters stripped, trailing blank lines dropped, each line indented
  # under the message. Prints nothing when the read fails. Untrusted text: evidence only.
  local out
  out="$(herdr pane read "$1" --source visible --lines 12 --format text 2>/dev/null)" || return 0
  # `tail -c` can cut the first kept line short. The prefix is added by awk, which ends every
  # line it prints with a newline, so whatever follows on stdout or stderr (the nonce, under
  # 2>&1) always starts on a line of its own.
  # The byte cut can also land inside a multi-byte character; the continuation bytes it leaves
  # at the start of the first line are dropped, so the excerpt never opens on a stray one.
  { printf '%s\n' "$out" | LC_ALL=C tr -d '\000-\010\013-\037\177' \
      | awk '{ l[NR] = $0 } NF { last = NR } END { for (i = 1; i <= last; i++) print l[i] }' \
      | tail -n 12 | tail -c 1000 \
      | LC_ALL=C awk 'NR == 1 { sub(/^[\200-\277]+/, "") } { print "  | " $0 }'; } || true
}

die_with_screen() { # die_with_screen <pane> <message>: die, then show the pane's screen
  printf 'xreview: %s\n' "$2" >&2
  pane_screen "$1" >&2
  exit 1
}

warn_pane_unwatched() { # warn_pane_unwatched <pane>: pane_resume's one failure signal. By
  # the time this runs the turn has already started (spec 7.3 step 5), so a pane failure
  # costs only the live view, never the review - never die here. The screen follows, so an
  # unknown screen that stopped the resume is named the first time it appears (§4.6).
  printf 'xreview: the review is running but not shown in pane %s\n' "$1" >&2
  pane_screen "$1" >&2
}

epoch_now() { # a wall-clock reading as plain seconds with a '.' radix, never the locale's
  # own decimal separator (N1: under e.g. nl_BE, $EPOCHREALTIME itself is "S,ssssss", which
  # `LC_ALL=C awk` then truncates at the comma to whole seconds) and never unset (bash < 5
  # lacks EPOCHREALTIME; under `set -u` with it exported empty, every deadline check would
  # read as "0 < wait", forever, and the wait would never bound anything).
  local t="${EPOCHREALTIME:-}"
  if [ -n "$t" ]; then
    printf '%s\n' "${t/[!0-9]/.}"
  else
    date +%s
  fi
}

# prefix_is_of <prefix> <full-id>: does <full-id> start with <prefix>? Empty prefix never
# matches. Both sides are hex-and-dash only (never a shell glob character), so plain
# parameter-expansion prefix removal is exact, not a pattern match.
prefix_is_of() {
  [ -n "$1" ] && [ "${2#"$1"}" != "$2" ]
}

pane_command() {
  local c
  c="$(grep -v '^[[:space:]]*#' "$PANE_CMD_FILE" 2>/dev/null | grep . | head -1 || true)"
  [ -n "$c" ] || die "missing $PANE_CMD_FILE - the Codex pane command is defined there"
  printf '%s\n' "$c"
}

thread_running() { # thread_running <thread>: 0 when xreview-rpc thread-status reports a live
  # turn, 1 when it reports none. Dies when thread-status itself fails (non-zero exit, e.g. the
  # daemon is unreachable) or prints no boolean `.running`, so those never read as "not
  # running". A daemon-side thread/read error is mapped by `xreview-rpc thread-status` to
  # {"running":false} with exit 0, which reads as "not running": a thread the daemon cannot
  # read cannot be running on it (controller Ruling 10).
  local out
  if ! out="$(xreview-rpc thread-status --thread "$1" 2>/dev/null)" \
     || ! printf '%s' "$out" | jq -e '.running | type == "boolean"' >/dev/null 2>&1; then
    die "cannot read whether the review thread $1 is running; no review was started"
  fi
  printf '%s' "$out" | jq -e '.running == true' >/dev/null 2>&1
}

# pane_free <pane> <thread> <proc-json> - spec 2026-10-01 §4.3/§4.4, BEFORE any turn exists.
# Prints 0 when the pane already shows <thread> and its TUI is connected to the running daemon
# (fast path: an observation, not a record). Otherwise runs the ctrl+c ladder and prints 1:
# the caller must pane_resume it once the turn exists. DIES when the pane will not free. Its
# ladder is the ONLY place that may ever send-keys to the pane (C1).
pane_free() {
  local pane="$1" thread="$2" proc="$3" title pid
  title="$(pane_title_id "$pane" 2>/dev/null || true)"
  pid="$(proc_codex "$proc" | jq -r '.pid // empty' 2>/dev/null)"
  if [ -n "$pid" ] && prefix_is_of "$title" "$thread" && connected_to_daemon "$pid"; then
    printf '0\n'; return 0
  fi
  pane_quit "$pane"
  printf '1\n'
}

pane_is_free() { # pane_is_free <pane>: 0 when the shell is back in the foreground. 1 when it
  # is not, or the read failed (never "freed"). DIES when herdr reports the pane closed.
  local proc
  if proc="$(pane_proc "$1")"; then proc_freed "$proc"; return; fi
  pane_gone "$1" && die "the Codex pane $1 closed while being freed; no review was started"
  return 1
}

elapsed_lt() { # elapsed_lt <start> <secs>: less than <secs> have passed since <start>
  LC_ALL=C awk -v s="$1" -v e="$(epoch_now)" -v m="$2" 'BEGIN{exit !(e-s<m)}'
}

# pane_quit <pane> - the ctrl+c ladder (spec 2026-10-01 §4.4 step 2). On a pre-session screen
# one pair lets the session start, and the next pair quits it (G8). So send up to three
# pairs, polling up to XREVIEW_RUNG_WAIT after each, all inside XREVIEW_PANE_WAIT.
pane_quit() {
  local pane="$1" wait="${XREVIEW_PANE_WAIT:-20}" poll="${XREVIEW_POLL_SECS:-1}" \
        rung_wait="${XREVIEW_RUNG_WAIT:-5}" gap start rstart _rung
  # LC_ALL=C: awk's numeric printf/parsing follows LC_NUMERIC, and a locale like nl_BE writes
  # "0,5", a decimal comma sleep(1) chokes on under set -e (I-2).
  gap="$(LC_ALL=C awk -v p="$poll" 'BEGIN{printf "%g", p/2}')"
  start="$(epoch_now)"
  pane_is_free "$pane" && return 0
  for _rung in 1 2 3; do
    herdr pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || true
    sleep "$gap"
    herdr pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || true
    rstart="$(epoch_now)"
    while :; do
      pane_is_free "$pane" && return 0
      elapsed_lt "$start" "$wait" || break 2
      elapsed_lt "$rstart" "$rung_wait" || break
      sleep "$poll"
    done
  done
  die_with_screen "$pane" "the Codex pane $pane did not exit its session within ${wait}s; no review was started"
}

# pane_resume <pane> <thread> <root> - spec 7.3 step 5 and 2026-10-01 §4.5, best effort,
# called ONLY when pane_free quit the pane's TUI. A turn already exists, so this never sends
# a keystroke - the one thing it does is run the Codex pane command with
# `-C <root> resume <thread>` into the now-idle shell (F22: the TUI replays the running turn,
# then streams live; -C makes the session's directory and the current one agree, so Codex
# shows no directory chooser). Never dies: a failure costs only the live view. Every failure
# warns and returns 1; the caller decides what that costs (only whether the superseded
# threads get archived).
pane_resume() {
  local pane="$1" thread="$2" root="$3" cmd raw brc now proc \
        wait="${XREVIEW_PANE_WAIT:-20}" poll="${XREVIEW_POLL_SECS:-1}" start
  # Fix round 2/D: pane_free's ladder already saw the shell back in the foreground before
  # this was ever called, but time passes between that and here (the turn itself). If
  # something - the operator, or the fix round 2/C relaunch racing this one - put a live TUI
  # back in the pane meanwhile, typing "resume ..." into it would be garbage input to a
  # running session, not a review command. A failed read is treated the same as "still
  # Codex": never type into a pane whose state could not be confirmed clear.
  proc="$(pane_proc "$pane")" && proc_freed "$proc" || { warn_pane_unwatched "$pane"; return 1; }
  cmd="$(pane_command)" || { warn_pane_unwatched "$pane"; return 1; }
  start="$(epoch_now)"
  herdr pane run "$pane" "$cmd -C $(printf '%q' "$root") resume $thread" >/dev/null 2>&1 \
    || { warn_pane_unwatched "$pane"; return 1; }
  while :; do
    raw=""; brc=0; now=""
    raw="$(pane_raw_title "$pane")" || brc=$?
    if [ "$brc" -eq 0 ] || [ "$brc" -eq 2 ]; then
      now="$(title_id_from "$raw")"
    else
      # A failed read is never an observation (I-1): only a genuine pane_not_found ends the
      # wait early; any other read failure just keeps waiting for the deadline.
      pane_gone "$pane" && { warn_pane_unwatched "$pane"; return 1; }
    fi
    if [ -n "$now" ] && prefix_is_of "$now" "$thread"; then
      report_to_herdr "$pane" "$thread"
      return 0
    fi
    LC_ALL=C awk -v s="$start" -v e="$(epoch_now)" -v m="$wait" 'BEGIN{exit !(e-s<m)}' \
      || { warn_pane_unwatched "$pane"; return 1; }
    sleep "$poll"
  done
}

_dispatch_exit_guard() { # _dispatch_exit_guard <pane>: the EXIT trap armed while pane_free
  # has quit the pane's TUI and no turn exists yet (spec 8). A refusal in that window -
  # turn-start refused, a failed mktemp or mkdir - would leave the pane at a bare shell, and
  # the next dispatch would find no Codex pane. Start a fresh Codex there, best effort; the
  # next dispatch resumes it onto the review thread. The pane comes in through the trap
  # string, not cmd_dispatch's locals: on an errexit exit bash 5 has already unwound those.
  local cmd
  cmd="$(pane_command 2>/dev/null)" || return 0
  herdr pane run "$1" "$cmd" >/dev/null 2>&1 || true
  return 0
}

report_to_herdr() { # report_to_herdr <pane> <thread>
  herdr pane report-agent-session "$1" --source herdr:codex --agent codex \
    --agent-session-id "$2" --seq "$(/usr/bin/python3 -c 'import time; print(time.time_ns())')" \
    >/dev/null 2>&1 || true
}

# --- one dispatch per pane (spec 2026-10-01 §4.9; G9) ----------------------------------
# A kernel flock on descriptor 9, taken by a python helper on the inherited descriptor. The
# lock belongs to the open file, so it holds until this process closes fd 9 or exits -
# crashes included. No stale lock is ever left behind to reclaim. The lock file is never
# deleted: a waiter could otherwise lock an unlinked inode while a newcomer locks a new one.
lock_pane() { # lock_pane <pane>: wait, bounded, for the pane's lock; dies at the bound
  local dir f rc=0 wait="${XREVIEW_LOCK_WAIT:-60}" re='^([0-9]+(\.[0-9]*)?|\.[0-9]+)$'
  [[ $wait =~ $re ]] || wait=60
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/xreview/locks"
  mkdir -p "$dir" 2>/dev/null && [ -d "$dir" ] || die "cannot create $dir; no review was started"
  f="$dir/$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_').lock"
  { exec 9>>"$f"; } 2>/dev/null || die "cannot open $f; no review was started"
  # Exit 75 only when the bound runs out with the lock still held; the helper's own other
  # failure exits 2. Bash trusts only 75 as contention: any other status (1, 2, 127, a signal -
  # no python, no flock on this filesystem) is "cannot lock", never reported as contention.
  /usr/bin/python3 -c '
import fcntl, sys, time
try:
    deadline = time.monotonic() + float(sys.argv[1])
    while True:
        try:
            fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
            sys.exit(0)
        except BlockingIOError:
            if time.monotonic() >= deadline:
                sys.exit(75)
            time.sleep(0.1)
except Exception:
    sys.exit(2)
' "$wait" 2>/dev/null || rc=$?
  case "$rc" in
    0) ;;
    75) die "another dispatch is using the Codex pane $1; no review was started" ;;
    *) die "cannot lock the Codex pane $1 ($f); no review was started" ;;
  esac
}

# A command-less exec makes its redirections permanent, so nothing but the fd is closed here.
unlock_pane() { exec 9>&-; }

# --- threads and checkpoints --------------------------------------------------------
# The review thread, in precedence order: XREVIEW_THREAD > an `xreview init` pin > this
# checkpoint's thread. Empty means the next dispatch starts one, in the pane.
target_thread() {
  local dir; dir="$(state_dir)"
  if [ -n "${XREVIEW_THREAD:-}" ]; then printf '%s\n' "$XREVIEW_THREAD"; return 0; fi
  if [ -r "$dir/pin" ]; then cat "$dir/pin"; return 0; fi
  if [ -r "$dir/review-thread" ]; then cat "$dir/review-thread"; fi
}

cmd_thread() {
  local t; t="$(target_thread)"
  [ -n "$t" ] || { printf 'xreview: no review thread for this checkpoint yet - the next dispatch starts one\n' >&2; return 1; }
  printf '%s\n' "$t"
}

# A pin is an instruction, not a cache entry: it outranks the checkpoint thread and is never
# archived. `xreview round --reset` drops it. Without an id, the pane's current thread.
cmd_init() {
  local dir id prefix pane root proot
  dir="$(state_dir)"
  id="${1:-}"
  if [ -z "$id" ]; then
    # A harness worktree shares its owner's pane, whose thread belongs to the owner: pinning
    # it here would bind the wrong review to this worktree's state (spec 2026-10-01 §4.2).
    root="$(repo_root)"; proot="$(pane_root)"
    [ "$proot" = "$root" ] || die "the Codex pane belongs to $proot; pass a thread id: xreview init <thread-id>"
    # find_pane is its own top-level assignment, not nested inside another command
    # substitution: a "no Codex pane" die() there must be the ONE error printed, not
    # swallowed by the outer call and followed by a second, misleading message here.
    pane="$(find_pane)"
    prefix="$(pane_title_id "$pane")"
    [ -n "$prefix" ] || die "the Codex pane shows no thread id; pass one: xreview init <thread-id>"
    id="$(xreview-rpc thread-resolve --prefix "$prefix" 2>/dev/null)" \
      || die "the Codex pane's thread id prefix could not be resolved; pass one: xreview init <thread-id>"
  fi
  assert_id "$id"
  mkdir -p "$dir" && printf '%s\n' "$id" > "$dir/pin"
  printf 'xreview: %s -> %s\n' "$(repo_root)" "$id"
}

# Archive every thread `round --reset` has superseded, once the pane has moved off them.
# $(state_dir)/superseded holds a LIST, one id per line, oldest first: `round --reset`
# APPENDS to it rather than overwriting, so a thread that a failed pane step left un-archived
# stays queued across however many later resets happen before a pane step finally succeeds -
# nothing is ever silently dropped.
archive_superseded() { # archive_superseded <current-thread>
  local f old; f="$(state_dir)/superseded"
  [ -r "$f" ] || return 0
  while IFS= read -r old || [ -n "$old" ]; do
    if [ -n "$old" ] && [ "$old" != "$1" ]; then
      xreview-rpc thread-archive --thread "$old" >/dev/null 2>&1 || true
    fi
  done < "$f"
  rm -f "$f"
  return 0
}

# A receipt is the only durable evidence that a review actually happened. It names the
# branch the review was dispatched on, not the one checked out at collect time: in a shared
# checkout another session may have switched branches in between. It records that branch's
# head at collection time so a reader can tell how far the branch has moved since;
# it deliberately does not try to invalidate itself, because applying a finding necessarily
# moves HEAD and a self-invalidating receipt would demand a second review of the fix.
# The tier is recorded, never enforced: which model and effort the reviewer runs at is
# Michael's setting, and a gate pinned to model names refuses every dispatch the day a new
# one ships. The checkpoint (spec, plan or pre-merge, named at dispatch) IS enforced:
# xreview-guard.sh admits an MR only on a pre-merge receipt whose verdict is approve.
record_receipt() { # record_receipt <thread> <nonce> <turn> <findings-json> <checkpoint> [branch]
  local dir tier verdict count branch head; dir="$(state_dir)"
  if ! mkdir -p "$dir" 2>/dev/null; then
    printf 'xreview: could not create %s - the receipt for %s was not recorded\n' "$dir" "$2" >&2
    return 0
  fi
  tier="$(codex_tier "$1" 2>/dev/null)" || tier=""
  verdict="$(printf '%s' "$4" | jq -r '.verdict // ""' 2>/dev/null)" || verdict=""
  count="$(printf '%s' "$4" | jq -r '(.findings // []) | length' 2>/dev/null)" || count=0
  # The branch from the turn record; a record written before it carried one falls back to
  # the branch checked out now. HEAD is a dispatch from a detached HEAD.
  branch="${6:-}"
  [ -n "$branch" ] || branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [ -n "$branch" ] && [ "$branch" != HEAD ]; then
    head="$(git rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null || true)"
  else
    head="$(git rev-parse HEAD 2>/dev/null || true)"
  fi
  if ! jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         --arg branch "$branch" \
         --arg head "$head" \
         --arg thread "$1" --arg nonce "$2" --arg tier "$tier" --arg turn "$3" \
         --arg verdict "$verdict" --argjson findings "${count:-0}" --arg checkpoint "${5:-}" \
    '{ts:$ts,branch:$branch,head:$head,thread:$thread,nonce:$nonce,tier:$tier,turn:$turn,verdict:$verdict,findings:$findings,checkpoint:$checkpoint}' \
    >> "$dir/reviews.jsonl" 2>/dev/null; then
    printf 'xreview: could not write the receipt for %s to %s/reviews.jsonl\n' "$2" "$dir" >&2
  fi
  return 0
}

# An apply window bounds the blast radius of acting on a finding. While it is open,
# review-driven edits are confined to files already in the branch diff, plus test paths —
# the RED-test rule requires ADDING a test, so a rule confined strictly to the diff would
# forbid the very thing it demands.
# Review rounds iterate until the models converge or genuinely disagree, so the stop
# condition cannot be "one round" — but it cannot be unbounded either. The cap is mechanical
# because a limit that depends on noticing you have hit it is not a limit.
round_file() { printf '%s/rounds' "$(state_dir)"; }

cmd_round() {
  local f; f="$(round_file)"
  case "${1:-show}" in
    --reset) # The checkpoint's thread is superseded, not forgotten: APPENDED to the list of
             # threads a later successful pane step will archive (Minor 3) - a reset that
             # lands while a pane step keeps failing must not lose track of an earlier
             # superseded thread. A pin is never archived. The legacy `thread` file (the old
             # queue-era herdr session cache) is dropped WITHOUT being archived: it was never
             # a checkpoint thread, so treating it as one would archive the operator's own
             # pane sessions.
             if [ -r "$(state_dir)/review-thread" ]; then
               mkdir -p "$(state_dir)" 2>/dev/null
               cat "$(state_dir)/review-thread" >> "$(state_dir)/superseded" 2>/dev/null || true
             fi
             rm -f "$f" "$(state_dir)/review-thread" "$(state_dir)/pin" "$(state_dir)/thread"
             printf 'xreview: round counter reset; cached thread and pin dropped\n' ;;
    show)    printf '%s\n' "$(current_round)" ;;
    *)       die "usage: xreview round [--reset]" ;;
  esac
}

# The branch is the dispatch's own: a shared checkout can switch branches mid-dispatch.
current_round() {
  local f b n; f="$(round_file)"
  if [ "$#" -ge 1 ]; then b="$1"; else b="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"; fi
  [ -r "$f" ] || { printf 0; return; }
  n="$(awk -v b="$b" '{ i = match($0, /=[^=]*$/) } i && substr($0, 1, i-1) == b { print substr($0, i+1); exit }' "$f" 2>/dev/null || true)"
  printf '%s' "${n:-0}"
}

bump_round() {
  local f b n; f="$(round_file)"
  if [ "$#" -ge 1 ]; then b="$1"; else b="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"; fi
  n=$(( $(current_round "$b") + 1 ))
  mkdir -p "$(dirname "$f")" || return 0
  { [ -r "$f" ] && awk -v b="$b" '{ i = match($0, /=[^=]*$/) } !i || substr($0, 1, i-1) != b' "$f" 2>/dev/null; printf '%s=%s\n' "$b" "$n"; } \
    > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  printf '%s' "$n"
}

cmd_apply() {
  local dir; dir="$(state_dir)"
  if [ "${1:-}" = "--done" ]; then
    rm -f "$dir/applying"; printf 'xreview: apply window closed\n'; return 0
  fi
  [ -n "${1:-}" ] || die "usage: xreview apply <nonce> | xreview apply --done"
  git rev-parse --show-toplevel >/dev/null 2>&1 \
    || die "not inside a git repository; an apply window is scoped to a branch's diff"
  local base; base="$(git merge-base HEAD origin/HEAD 2>/dev/null \
                      || git merge-base HEAD main 2>/dev/null || printf '')"
  mkdir -p "$dir"
  { printf 'nonce=%s\n' "$1"
    { [ -n "$base" ] && git diff --name-only "$base"..HEAD 2>/dev/null
      git diff --name-only 2>/dev/null
      git diff --cached --name-only 2>/dev/null
    } | sort -u | sed 's/^/file=/'
  } > "$dir/applying"
  printf 'xreview: apply window open for %s (%s files in scope)\n' \
    "$1" "$(grep -c '^file=' "$dir/applying" 2>/dev/null || printf 0)"
}

cmd_receipts() {
  local f; f="$(state_dir)/reviews.jsonl"
  [ -r "$f" ] || { printf 'no reviews recorded for %s\n' "$(repo_root)"; return 1; }
  if [ "${1:-}" = "--tiers" ]; then
    jq -r '(.tier // "") | if . == "" then "(unrecorded)" else . end' "$f" 2>/dev/null \
      | sort | uniq -c | sort -rn
    return 0
  fi
  cat "$f"
}

# A repo listed as trusted in ~/.codex/config.toml has its own .codex/config.toml applied,
# which can widen the reviewer's sandbox and register MCP servers. Until the trust entries
# are narrowed this stays a tripwire rather than a wall: refuse and let a human look.
guard_project_config() {
  local root; root="$(repo_root)"
  [ -e "$root/.codex" ] && die "refusing to dispatch: $root/.codex exists and can alter the reviewer's sandbox and tools - inspect it first"
  return 0
}

# A dispatch that names a path makes the reviewer open it, and every search and read is a
# full-context model step (measured 2026-09-01: ~16 steps and ~2.0M tokens per review).
# Refuse an oversized diff rather than truncating it: a reviewer handed half a change reviews
# half a change and reports nothing on the rest, which reads as a clean review.
inline_diff() {
  local range="$1" out max
  max="${XREVIEW_MAX_DIFF_BYTES:-100000}"
  out="$(git diff "$range" 2>/dev/null)" \
    || die "cannot diff $range - check the range resolves in this repository"
  [ -n "$out" ] || die "cannot diff $range - the range is empty, so there is nothing to review"
  if [ "${#out}" -gt "$max" ]; then
    die "diff for $range is too large to carry inline (${#out} bytes, cap $max).
Review it in slices, or raise XREVIEW_MAX_DIFF_BYTES if the reviewer can hold it."
  fi
  printf '%s' "$out"
}

# Codex writes one `turn_context` record per turn into the thread's rollout file, each
# carrying the model and effort that turn ran with; the LAST one is the current setting.
codex_tier() {
  local thread="$1" f
  case "$thread" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
  f="$(find "$CODEX_HOME_DIR/sessions" -name "rollout-*-$thread.jsonl" 2>/dev/null | sort | tail -1)"
  [ -n "$f" ] && [ -r "$f" ] || return 1
  jq -r 'select(.type == "turn_context") | select(.payload.model != null)
         | "\(.payload.model)/\(.payload.effort)"' "$f" 2>/dev/null | tail -1 | grep . || return 1
}

cmd_tier() {
  local thread
  if [ "$#" -ge 1 ]; then thread="$1"; else
    thread="$(target_thread)"; [ -n "$thread" ] || die "no review thread yet"
  fi
  codex_tier "$thread" || die "cannot read the reviewer tier for $thread"
}

cmd_dispatch() {
  local body_file diff_range="" diff_text="" dir pane proc thread nonce packet turn="" \
        need_resume checkpoint=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --diff) [ "$#" -ge 2 ] || die "--diff needs a range"; diff_range="$2"; shift 2 ;;
      --checkpoint) [ "$#" -ge 2 ] || die "--checkpoint needs spec, plan or pre-merge"
                    checkpoint="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  [ "$#" -eq 1 ] || die "usage: xreview dispatch --checkpoint spec|plan|pre-merge [--diff <range>] <body-file>"
  # Required, not defaulted: the receipt is what the pre-merge gate reads, and a review
  # dispatched without its checkpoint could only be found out at MR time, after the turn
  # was spent. Refused here, before anything is touched.
  case "$checkpoint" in
    spec|plan|pre-merge) ;;
    "") die "usage: xreview dispatch --checkpoint spec|plan|pre-merge [--diff <range>] <body-file>" ;;
    *) die "unknown checkpoint: $checkpoint (spec, plan or pre-merge)" ;;
  esac
  body_file="$1"
  [ -r "$body_file" ] || die "cannot read $body_file"
  dir="$(state_dir)"
  # Read once, now: the review is of this branch, and the receipt must name it even if the
  # shared checkout has moved to another branch by the time the verdict is collected.
  local branch; branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

  # Preconditions, before the pane is touched or anything is sent.
  guard_project_config
  [ -r "$SCHEMA" ] || die "missing findings schema $SCHEMA"
  [ -r "$REVIEWER" ] || die "missing reviewer instructions $REVIEWER"
  # A portable precondition, not reliant on inherit_errexit (bash 4.4+) to catch a
  # missing/empty codex-pane-command before the pane is touched (M2): called here as a
  # bare statement, not nested inside another $(...), its own die() works on any bash.
  pane_command >/dev/null
  [ -z "$diff_range" ] || diff_text="$(inline_diff "$diff_range")"
  codex-daemon ensure || die "the Codex daemon is not running; no review was started"
  codex-daemon check || die "refusing to dispatch while the daemon carries a pane's environment (see above)"
  xreview-rpc health || die "cannot reach the Codex daemon through xreview-rpc (see above); no review was started"
  pane="$(find_pane)"
  lock_pane "$pane"
  # Every pane check runs inside the lock, so it sees the state the previous holder left.
  # The process is read once, here: the guard and pane_free's fast path judge this same
  # observation, and a dispatch that cannot read it refuses before any keystroke.
  proc="$(pane_proc "$pane")" \
    || die "cannot read the Codex pane $pane's process (herdr pane process-info); no review was started"
  # A herdr-idle pane can still be mid-turn on the daemon side: a disconnected TUI keeps its
  # title's thread id prefix, and a TUI on a pre-session screen is about to open the thread
  # its argv resumes. The guard refuses on either, or when it cannot tell.
  pane_guard "$pane" "$proc"
  # The cap binds before the pane is touched at all: a round over the cap is refused
  # without so much as a ctrl+c, and the counter still advances so a retry stays refused.
  local max="${XREVIEW_MAX_ROUNDS:-10}" round
  round=$(( $(current_round "$branch") + 1 ))
  if [ "$round" -gt "$max" ]; then
    bump_round "$branch" >/dev/null
    die "round $round exceeds the cap of $max for this branch.
Two models circling the same point is Michael's call, not another turn.
Report the remaining disagreement, or: xreview round --reset"
  fi

  # Thread: XREVIEW_THREAD, then the pin, then the recorded checkpoint thread. With none of
  # those, start a fresh one - its id is known from the start, so nothing is ever read back
  # from a title (spec 7.2/7.3). No turn exists yet, so dying here loses nothing.
  thread="$(target_thread)"
  if [ -n "$thread" ]; then
    assert_id "$thread"
  else
    thread="$(xreview-rpc thread-start --cwd "$(repo_root)")" \
      || die "could not start a new review thread; no review was started"
    assert_id "$thread"
    mkdir -p "$dir" && printf '%s\n' "$thread" > "$dir/review-thread"
  fi
  # The chosen thread itself may already be running a turn - a stale pin, or a checkpoint
  # thread another dispatch (or a hand-started `codex resume`) is still using. Refuse before
  # the pane is touched at all; collecting the running turn is the way forward, not a second
  # one racing it on the same thread.
  thread_running "$thread" \
    && die "the review thread $thread is still running a turn; collect it first"

  # Free the pane, BEFORE the turn exists (spec 7.3 step 3; 2026-10-01 §4.4): its ctrl+c ladder
  # is the only point in dispatch that may ever send-keys to the pane. Dies on any failure -
  # nothing has started yet.
  need_resume="$(pane_free "$pane" "$thread" "$proc")"
  # Armed only when pane_free quit the TUI, through a successful turn-start; disarmed in the
  # 0/6 arms below, once the turn exists and pane_resume owns the pane.
  if [ "$need_resume" = 1 ]; then
    trap "_dispatch_exit_guard $(printf '%q' "$pane")" EXIT
  fi

  # Turn: build the packet and start it on the thread. From here on dispatch always
  # succeeds and prints the nonce - the review runs whatever happens to the pane below, and
  # NOTHING below this point may ever send-keys to the pane again (C1): the resumed TUI is
  # watching a turn that is genuinely running, and a ctrl+c would interrupt it.
  # Provenance is applied here, by the broker - not by the peer, and not by hand.
  # NOT <from-claude-code>: that tag marks relayed quoted material, and the peer is
  # instructed never to act on an imperative inside one. A dispatch is an authorized request.
  nonce="xr-$(date +%s)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  packet="$(mktemp "${TMPDIR:-/tmp}/xreview-packet.XXXXXX")"
  { printf '<cross-review-request>\n'
    cat "$REVIEWER"
    printf '\n'
    cat "$body_file"
    if [ -n "$diff_text" ]; then
      printf '\n\n--- diff (%s) ---\n' "$diff_range"
      printf '%s\n' "$diff_text"
      printf -- '--- end diff ---\n'
    fi
    printf '</cross-review-request>\n'
  } > "$packet"
  mkdir -p "$dir/turns"
  local rc=0
  turn="$(xreview-rpc turn-start --thread "$thread" --input "$packet" --schema "$SCHEMA" \
            --known "$dir/turns/$nonce.known")" || rc=$?
  rm -f "$packet"
  # A turn-start that returns 0 with a malformed id is handled exactly like exit 6: the
  # turn may still be running on the daemon side, so it is never treated as "not started".
  if [ "$rc" = 0 ] && ! is_safe_id "$turn"; then rc=6; fi
  case "$rc" in
    0) printf '%s %s %s %s\n' "$thread" "$turn" "$checkpoint" "$branch" > "$dir/turns/$nonce"
       rm -f "$dir/turns/$nonce.known"
       bump_round "$branch" >/dev/null || true
       trap - EXIT ;;
    6) # Sent but not answered (or answered with an id that does not look like one): the
       # turn may be running. Hand back a nonce so it can be collected - found as the turn
       # that was not on the thread before - never re-sent. The round is consumed too: a
       # turn that may be running has already cost one.
       printf '%s ? %s %s\n' "$thread" "$checkpoint" "$branch" > "$dir/turns/$nonce"
       printf 'xreview: turn/start was sent but not answered - the review may be running. Collect %s; do NOT re-dispatch.\n' "$nonce" >&2
       bump_round "$branch" >/dev/null || true
       trap - EXIT ;;
    *) rm -f "$dir/turns/$nonce.known"
       die "the review turn could not be started on $thread" ;;
  esac

  # Resume the pane, best effort, ONLY if step 3 actually quit its TUI - otherwise it is
  # already showing the thread and there is nothing to resume. Archive the superseded
  # threads once the pane genuinely shows the new one, whether that took a resume or the
  # fast path already had it; never otherwise, so a pane step that could not confirm the
  # pane is watching keeps them queued for the next successful dispatch.
  if [ "$need_resume" = 1 ]; then
    if pane_resume "$pane" "$thread" "$(repo_root)"; then
      archive_superseded "$thread"
    fi
  else
    archive_superseded "$thread"
  fi
  unlock_pane
  printf '%s\n' "$nonce"
}

# The budget is a patience limit, not a verdict. A turn still running when it runs out has
# demonstrably not been lost, so collecting again is correct and safe (exit 3). Only a nonce
# with no turn on record is ambiguous, and that one must not be re-dispatched.
COLLECT_BUDGET_DEFAULT=2700

cmd_collect() {
  local nonce="${1:-}" budget="${2:-$COLLECT_BUDGET_DEFAULT}" rec thread turn checkpoint branch out rc
  case "$nonce" in
    xr-*) ;;
    *) die "usage: xreview collect <nonce> [budget] - nonces start with xr-" ;;
  esac
  # The budget is whole seconds only; anything else is a usage error, never a failed
  # review (F24) - this must be checked before any daemon call, not left to xreview-rpc's
  # own argparse to reject with a different, misleading exit code.
  case "$budget" in
    ''|*[!0-9]*) die "usage: xreview collect <nonce> [budget] - budget must be whole seconds" ;;
  esac
  assert_id "$nonce"
  rec="$(state_dir)/turns/$nonce"
  [ -r "$rec" ] || die "ambiguous: no turn on record for $nonce (do NOT retry the dispatch)"
  # A third field names the checkpoint and a fourth the branch dispatched on; a record from
  # before either existed has two or three, and its receipt names the current branch.
  read -r thread turn checkpoint branch < "$rec"
  assert_id "$thread"
  local which resolved="$(state_dir)/turns/$nonce.resolved"
  if [ "$turn" = "?" ]; then
    which=(--new-since "$(state_dir)/turns/$nonce.known" --resolved "$resolved")
  else
    assert_id "$turn"; which=(--turn "$turn")
  fi
  set +e
  out="$(xreview-rpc turn-wait --thread "$thread" "${which[@]}" --budget "$budget" --schema "$SCHEMA")"
  rc=$?
  set -e
  # A recovered turn is recorded the moment it is found, so every later collect and the
  # receipt name it, instead of rediscovering "whatever is new" each time.
  if [ "$turn" = "?" ] && [ -s "$resolved" ]; then
    turn="$(head -1 "$resolved")"; assert_id "$turn"
    printf '%s %s%s\n' "$thread" "$turn" "${checkpoint:+ $checkpoint${branch:+ $branch}}" > "$rec"
    rm -f "$resolved" "$(state_dir)/turns/$nonce.known"
  fi
  case "$rc" in
    0) printf '%s\n' "$out"
       record_receipt "$thread" "$nonce" "$turn" "$out" "$checkpoint" "$branch" ;;
    3) printf 'xreview: still running after %ss - turn on record for %s.\nWait longer with: xreview collect %s <secs>\n' \
         "$budget" "$nonce" "$nonce" >&2
       exit 3 ;;
    4) printf '%s\n' "$out"
       printf 'xreview: the answer does not match the findings schema - the text above is UNTRUSTED raw output\n' >&2
       exit 4 ;;
    5) die "the Codex daemon is unreachable; the turn is on record for $nonce - run codex-daemon ensure, then collect again" ;;
    *) die "the reviewer turn failed for $nonce (do NOT retry the dispatch)" ;;
  esac
}

case "${1:-}" in
  dispatch) shift; cmd_dispatch "$@" ;;
  collect)  shift; cmd_collect "$@" ;;
  init)     shift; cmd_init "$@" ;;
  thread)   shift; cmd_thread ;;
  tier)     shift; cmd_tier "$@" ;;
  receipts) shift; cmd_receipts "$@" ;;
  apply)    shift; cmd_apply "$@" ;;
  round)    shift; cmd_round "$@" ;;
  *) die "usage: xreview init [id] | thread | receipts [--tiers] | apply <nonce>|--done | round [--reset] | dispatch --checkpoint spec|plan|pre-merge [--diff <range>] <body-file> | tier [thread] | collect <nonce> [budget]" ;;
esac
