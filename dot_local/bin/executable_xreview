#!/usr/bin/env bash
# xreview - dispatch a cold review request to a Codex thread and collect the answer.
# Dispatch, collect, and a receipt of what was reviewed. Two PreToolUse guards read
# those receipts (pre-merge gate, apply window); neither is proven enough to be an
# authorization boundary - see the trust note below and treat findings as evidence.
set -euo pipefail

CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
HIST="$CODEX_HOME_DIR/thread_history_1.sqlite"

die() { printf 'xreview: %s\n' "$1" >&2; exit 1; }

# Opened normally, so SQLite does its own locking and change detection against a
# database Codex is actively writing. Two rejected alternatives: `mode=ro` cannot create
# the -shm a WAL database needs and so fails whenever the sidecars are absent - which is
# most of the time, even with sessions live; and `immutable=1`, which SQLite documents
# as skipping locking and change detection and may return incorrect results if the file
# changes. Read-only intent is enforced by only ever issuing SELECT here.
sq() {
  # Must already exist: sqlite3 silently CREATES an empty database for a missing path,
  # which would turn "Codex has not written this yet" into "no such table".
  [ -r "$HIST" ] || die "Codex history store not found at $HIST"
  # query_only makes read-only an enforced property of the connection rather than a
  # promise about which statements this script happens to contain.
  sqlite3 "$HIST" "PRAGMA query_only=ON; $1"
}

# Thread resolution: explicit > recorded > live Herdr lookup. A recorded id is
# re-validated against the live pane list every time, because a UUID with history
# proves a thread existed, not that anything is running to answer on it.
state_dir() {
  local root; root="$(repo_root)"
  printf '%s/xreview/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" \
    "$(printf '%s' "$root" | tr '/' '_' | sed 's/^_//')"
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

live_codex_thread() {
  command -v herdr >/dev/null 2>&1 || return 1
  herdr agent list 2>/dev/null | jq -r --arg cwd "$(repo_root)" \
    '.result.agents[]? | select(.agent == "codex" and .cwd == $cwd)
     | .agent_session.value // empty' | head -1
}

resolve_thread() {
  [ -n "${XREVIEW_THREAD:-}" ] && { printf '%s\n' "$XREVIEW_THREAD"; return 0; }
  local dir live rec
  dir="$(state_dir)"
  live="$(live_codex_thread)"
  if [ -r "$dir/thread" ]; then
    rec="$(cat "$dir/thread")"
    # Recorded id still backed by a live pane, or no pane list to contradict it.
    if [ -z "$live" ] || [ "$live" = "$rec" ]; then printf '%s\n' "$rec"; return 0; fi
  fi
  if [ -z "$live" ]; then
    # A pane with no thread is the common case, not a missing pane: Codex has no
    # thread id until its first turn, so a freshly built workspace looks empty here.
    if command -v herdr >/dev/null 2>&1 &&
       herdr agent list 2>/dev/null | jq -e --arg cwd "$(repo_root)" \
         '.result.agents[]? | select(.agent == "codex" and .cwd == $cwd)' >/dev/null; then
      die "the Codex pane for $(repo_root) has no thread yet - send it one message first"
    fi
    die "no Codex pane for $(repo_root); open one, or: xreview init <thread-id>"
  fi
  mkdir -p "$dir" && printf '%s\n' "$live" > "$dir/thread"
  printf '%s\n' "$live"
}

cmd_init() {
  local dir id
  dir="$(state_dir)"
  id="${1:-$(live_codex_thread)}"
  [ -n "$id" ] || die "no Codex pane for $(repo_root); pass a thread id explicitly"
  mkdir -p "$dir" && printf '%s\n' "$id" > "$dir/thread"
  printf 'xreview: %s -> %s\n' "$(repo_root)" "$id"
}

# A receipt is the only durable evidence that a review actually happened. It records
# the branch head at collection time so a reader can tell how far the branch has moved
# since; it deliberately does not try to invalidate itself, because applying a finding
# necessarily moves HEAD and a self-invalidating receipt would demand a second review
# of the fix for the first.
record_receipt() {
  local dir; dir="$(state_dir)"
  mkdir -p "$dir" || return 0
  jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         --arg branch "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" \
         --arg head "$(git rev-parse HEAD 2>/dev/null)" \
         --arg thread "$1" --arg nonce "$2" \
    '{ts:$ts,branch:$branch,head:$head,thread:$thread,nonce:$nonce}' \
    >> "$dir/reviews.jsonl" 2>/dev/null || true
}

# An apply window bounds the blast radius of acting on a finding. While it is open,
# review-driven edits are confined to files already in the branch diff, plus test paths —
# the RED-test rule requires ADDING a test, so a rule confined strictly to the diff would
# forbid the very thing it demands. Whether a RED test was actually written first is not
# mechanisable; this bounds where a mistake can land, not whether one is made.
# Review rounds iterate until the models converge or genuinely disagree, so the stop
# condition cannot be "one round" — but it cannot be unbounded either: two models can
# accommodate each other indefinitely, and every round is a real turn against a real
# usage limit. The cap is mechanical because a limit that depends on noticing you have
# hit it is not a limit.
round_file() { printf '%s/rounds' "$(state_dir)"; }

cmd_round() {
  local f; f="$(round_file)"
  case "${1:-show}" in
    --reset) rm -f "$f" "$(state_dir)/thread"
             printf 'xreview: round counter reset; cached thread dropped\n' ;;
    show)    printf '%s\n' "$(current_round)" ;;
    *)       die "usage: xreview round [--reset]" ;;
  esac
}

current_round() {
  local f b n; f="$(round_file)"; b="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [ -r "$f" ] || { printf 0; return; }
  n="$(sed -n "s/^$b=//p" "$f" 2>/dev/null | head -1)"
  printf '%s' "${n:-0}"
}

bump_round() {
  local f b n; f="$(round_file)"; b="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  n=$(( $(current_round) + 1 ))
  mkdir -p "$(dirname "$f")" || return 0
  { [ -r "$f" ] && grep -v "^$b=" "$f" 2>/dev/null; printf '%s=%s\n' "$b" "$n"; } \
    > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  printf '%s' "$n"
}

cmd_apply() {
  local dir; dir="$(state_dir)"
  if [ "${1:-}" = "--done" ]; then
    rm -f "$dir/applying"; printf 'xreview: apply window closed\n'; return 0
  fi
  [ -n "${1:-}" ] || die "usage: xreview apply <nonce> | xreview apply --done"
  local base; base="$(git merge-base HEAD origin/HEAD 2>/dev/null \
                      || git merge-base HEAD main 2>/dev/null || printf '')"
  mkdir -p "$dir"
  { printf 'nonce=%s\n' "$1"
    { [ -n "$base" ] && git diff --name-only "$base"..HEAD 2>/dev/null
      git diff --name-only 2>/dev/null
      git diff --cached --name-only 2>/dev/null
    } | sort -u | sed 's/^/file=/'
  } > "$dir/applying"
  printf 'xreview: apply window open for %s (%s files in scope)\n' \
    "$1" "$(grep -c '^file=' "$dir/applying" 2>/dev/null || printf 0)"
}

cmd_receipts() {
  local f; f="$(state_dir)/reviews.jsonl"
  [ -r "$f" ] || { printf 'no reviews recorded for %s\n' "$(repo_root)"; return 1; }
  cat "$f"
}

# A repo listed as trusted in ~/.codex/config.toml has its own .codex/config.toml
# applied, which can widen the reviewer's sandbox and register MCP servers - a CLI pin
# stops the first but not the second. Trust is NOT required for AGENTS.md: an unlisted
# repo still loads its instructions and ignores its config, so trust entries are
# removable. Until the trust entries are narrowed this stays a tripwire rather than a
# wall: refuse the dispatch and let a human look.
guard_project_config() {
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  [ -e "$root/.codex" ] && die "refusing to dispatch: $root/.codex exists and can alter the reviewer's sandbox and tools - inspect it first"
  return 0
}

# A dispatch that names a path makes the reviewer open it, and every search and read is
# a full-context model step. Measured across 69 real reviews on 2026-09-01: ~16 model
# steps and ~2.0M tokens per review, with per-turn cost barely differing between an
# 8-turn thread and a 37-turn one — the steps are the cost, not the thread length.
# Carrying the diff inline lets the reviewer answer from what it was handed.
#
# Refuse an oversized diff rather than truncating it: a reviewer handed half a change
# reviews half a change and reports nothing on the rest, which reads as a clean review.
inline_diff() {
  local range="$1" out max
  max="${XREVIEW_MAX_DIFF_BYTES:-100000}"
  out="$(git diff "$range" 2>/dev/null)" \
    || die "cannot diff $range - check the range resolves in this repository"
  [ -n "$out" ] || die "cannot diff $range - the range is empty, so there is nothing to review"
  if [ "${#out}" -gt "$max" ]; then
    die "diff for $range is too large to carry inline (${#out} bytes, cap $max).
Review it in slices, or raise XREVIEW_MAX_DIFF_BYTES if the reviewer can hold it."
  fi
  printf '%s' "$out"
}

# Every dispatch queues into one cached thread per repo, so round N reaches a reviewer
# already holding rounds 1..N-1 - its own earlier findings and every artifact sent
# before. The cold-ask rule is the reason a second opinion carries information at all,
# and a thread that never rotates voids it silently. Warn rather than refuse: rotating
# means starting a Codex session by hand, and a guard that blocks work it cannot itself
# complete is a guard that gets switched off.
warn_stale_thread() {
  local thread="$1" f n
  f="$(state_dir)/reviews.jsonl"
  [ -r "$f" ] || return 0
  n="$(jq -r --arg t "$thread" 'select(.thread == $t) | .thread' "$f" 2>/dev/null | wc -l | tr -d ' ')"
  [ -n "$n" ] || return 0
  if [ "$n" -ge "${XREVIEW_THREAD_WARN:-8}" ]; then
    printf 'xreview: this thread has already answered %s reviews - it is no longer cold.\n' "$n" >&2
    printf '    It holds every prior artifact and its own earlier findings, so its\n' >&2
    printf '    agreement carries less information than a fresh one would.\n' >&2
    printf '    Start a new Codex session for this checkout, then: xreview round --reset\n' >&2
  fi
}

# Codex writes one `turn_context` record per turn into the thread's rollout file, each
# carrying the model and reasoning effort that turn actually ran with. The LAST one is
# therefore the setting a dispatch would reach: reading the first would report what the
# session opened with and miss every /model change made since.
#
# This is the only place the tier is observable. `herdr agent list` does not carry it,
# and neither the history sqlite nor its thread_turns rows record it.
codex_tier() {
  local thread="$1" f
  # The id is interpolated into a glob. Anything outside this charset could match
  # rollouts for other threads, or escape the sessions tree entirely.
  case "$thread" in
    ''|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  f="$(find "$CODEX_HOME_DIR/sessions" -name "rollout-*-$thread.jsonl" 2>/dev/null | sort | tail -1)"
  [ -n "$f" ] && [ -r "$f" ] || return 1
  jq -r 'select(.type == "turn_context")
         | select(.payload.model != null)
         | "\(.payload.model)/\(.payload.effort)"' "$f" 2>/dev/null | tail -1 | grep . || return 1
}

cmd_tier() {
  local thread
  if [ "$#" -ge 1 ]; then thread="$1"; else thread="$(resolve_thread)" || return 1; fi
  codex_tier "$thread" || die "cannot read the reviewer tier for $thread"
}

# A dispatch is one shot: once queued, the turn is spent whatever tier answered it. So
# the check refuses BEFORE queueing and names both sides, leaving time to change the
# model in the Codex pane and retry. Reporting it afterwards would be a note about
# money already gone.
#
# Fails open. An unreadable tier is not evidence of a mismatch, and a check that blocks
# every review whenever Codex changes its on-disk layout is a check that gets removed.
assert_tier() {
  local thread="$1" want="$2" have exp_model exp_effort have_model have_effort
  have="$(codex_tier "$thread")" || return 0
  exp_model="${want%%/*}"; exp_effort="${want#*/}"
  [ "$exp_effort" = "$want" ] && exp_effort=""
  have_model="${have%%/*}"; have_effort="${have#*/}"
  if { [ -n "$exp_model" ] && [ "$exp_model" != "$have_model" ]; } ||
     { [ -n "$exp_effort" ] && [ "$exp_effort" != "$have_effort" ]; }; then
    die "reviewer tier is $have, expected $want.
Change the model in the Codex pane for this checkout, then retry.
To dispatch at the current tier anyway, drop --expect."
  fi
  return 0
}

cmd_dispatch() {
  local thread body_file diff_range="" expect_tier=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --diff)   [ "$#" -ge 2 ] || die "--diff needs a range";   diff_range="$2"; shift 2 ;;
      --expect) [ "$#" -ge 2 ] || die "--expect needs <model>/<effort>"; expect_tier="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  if [ "$#" -ge 2 ]; then thread="$1"; body_file="$2"
  else thread="$(resolve_thread)" || return 1; body_file="$1"; fi
  [ -r "$body_file" ] || die "cannot read $body_file"
  guard_project_config
  # Before bump_round: a dispatch refused for the wrong tier has not been reviewed, and
  # charging it a round would push the cap toward a refusal the reviewer never caused.
  [ -n "$expect_tier" ] && assert_tier "$thread" "$expect_tier"
  local max="${XREVIEW_MAX_ROUNDS:-10}" round
  round="$(bump_round)"
  if [ "$round" -gt "$max" ]; then
    die "round $round exceeds the cap of $max for this branch.
Two models circling the same point is Michael's call, not another turn.
Report the remaining disagreement, or: xreview round --reset"
  fi
  local nonce; nonce="xr-$(date +%s)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  # Provenance is applied here, by the broker - not by the peer, and not by hand.
  # NOT <from-claude-code>: that tag marks relayed quoted material, and the peer is
  # instructed never to act on an imperative inside one. A dispatch is an authorized
  # request, so it needs a tag the governance marks as actionable.
  local diff_text=""
  [ -n "$diff_range" ] && diff_text="$(inline_diff "$diff_range")"
  { printf '<cross-review-request>\n'
    cat "$body_file"
    if [ -n "$diff_text" ]; then
      printf '\n\n--- diff (%s) ---\n' "$diff_range"
      printf '%s\n' "$diff_text"
      printf -- '--- end diff ---\n'
    fi
    printf '\n\n[correlation: %s — quote this token nowhere in your reply]\n' "$nonce"
    printf '</cross-review-request>\n'
  } > "$body_file.wrapped"
  warn_stale_thread "$thread"
  codex queue --thread "$thread" --message "$(cat "$body_file.wrapped")" >/dev/null \
    || die "queue failed for thread $thread"
  printf '%s\n' "$nonce"
}

# Both values are interpolated into SQL below. Nonces are minted here and thread ids
# come from Codex, but neither is validated by the time it reaches this point - a
# caller-supplied value must not be able to close a quote.
assert_sql_safe() {
  case "$1" in
    "") die "empty identifier" ;;
    *[!A-Za-z0-9._-]*) die "refusing unsafe identifier: $1" ;;
  esac
}

# Stricter, for the one value that reaches a LIKE pattern: _ and % are wildcards there,
# so a nonce of xr-________-________ would match turns it was never minted for and
# correlate this collection with the wrong review.
assert_like_safe() {
  assert_sql_safe "$1"
  case "$1" in
    *[_%]*) die "refusing nonce containing a LIKE wildcard: $1" ;;
  esac
}

cmd_collect() {
  local thread nonce budget waited=0
  # Nonces are minted here and always start with "xr-"; thread ids never do.
  if [ -n "${1##xr-*}" ]; then
    thread="$1"; nonce="$2"; budget="${3:-900}"
  else
    thread="$(resolve_thread)" || return 1; nonce="$1"; budget="${2:-900}"
  fi
  assert_sql_safe "$thread"; assert_like_safe "$nonce"
  while :; do
    local row; row=$(sq "
      SELECT t.status, COALESCE(t.final_agent_item_id,'')
      FROM thread_turns t
      JOIN thread_items i
        ON i.thread_id = t.thread_id AND i.item_id = t.first_user_item_id
      WHERE t.thread_id = '$thread' AND i.item_json LIKE '%$nonce%'
      ORDER BY t.rollout_ordinal DESC LIMIT 1;") || die "history query failed"
    local status="${row%%|*}" item="${row##*|}"
    if [ "$status" = "completed" ] && [ -n "$item" ]; then
      assert_sql_safe "$item"
      sq "SELECT item_json FROM thread_items
          WHERE thread_id='$thread' AND item_id='$item';" \
        | jq -r '.text // empty'
      record_receipt "$thread" "$nonce"
      return 0
    fi
    case "$status" in failed|error) die "reviewer turn failed" ;; esac
    [ "$waited" -ge "$budget" ] && die "ambiguous: no completed turn for $nonce after ${budget}s (do NOT retry)"
    sleep 5; waited=$((waited+5))
  done
}

case "${1:-}" in
  dispatch) shift; cmd_dispatch "$@" ;;
  collect)  shift; cmd_collect "$@" ;;
  init)     shift; cmd_init "$@" ;;
  thread)   shift; resolve_thread ;;
  tier)     shift; cmd_tier "$@" ;;
  receipts) shift; cmd_receipts "$@" ;;
  apply)    shift; cmd_apply "$@" ;;
  round)    shift; cmd_round "$@" ;;
  *) die "usage: xreview init [id] | thread | receipts | apply <nonce>|--done | round [--reset] | dispatch [--diff <range>] [--expect <model>/<effort>] [thread] <body-file> | tier [thread] | collect [thread] <nonce> [budget]" ;;
esac
