#!/usr/bin/env zsh
# wt-rm — non-interactive entry point for worktree retirement.
#
# The lifecycle commands are zsh functions, so they resolve only in an interactive
# shell; agents and scripts need this PATH entry point instead of raw
# `git worktree remove`, which gets none of the protocol's guarantees.
# Interactive shells never reach this file: a zsh function shadows a PATH command.
#
# See docs/superpowers/specs/2026-08-24-worktree-lifecycle-invocation-surface-design.md §4.3

emulate -L zsh

conf="${XDG_CONFIG_HOME:-$HOME/.config}"

# zshenv is not optional: without it a bare zsh has no XDG variables and no herdr on
# PATH, which wt-rm needs. Re-sourcing it is harmless in a process that exits
# immediately. No `set -u`: zshenv tests unset variables by design.
for f in zshenv functions; do
  [[ -r "$conf/zsh/$f" ]] || {
    print -ru2 -- "wt-rm: cannot read $conf/zsh/$f"; exit 1 }
  source "$conf/zsh/$f"
done

# Recursion guard: script and function share a name, so a readable functions file
# that does not define wt-rm would send the bare call back through PATH to here.
(( $+functions[wt-rm] )) || {
  print -ru2 -- "wt-rm: $conf/zsh/functions did not define wt-rm."; exit 1 }

wt-rm "$@"
