#!/usr/bin/env bash
# chezmoi modify_ script for the target ~/.claude/settings.json.
#
# settings.json mixes Michael's stable config with keys Claude Code writes at runtime
# (`enabledPlugins`, `extraKnownMarketplaces`, `autoMode`, `modelSettings`, the /config
# toggles, and whatever a future release adds). This receives the CURRENT file on stdin,
# starts from it, and overlays only the keys chezmoi owns; every other key survives an
# apply untouched. Owned keys are replaced wholesale, so a stale rule or hook never lingers
# in them. Keys chezmoi no longer wants are deleted by name (the retired list at the end),
# because starting from the live file would otherwise keep them forever. model,
# effortLevel, permissions.defaultMode and outputStyle are seeded only when absent. The
# plugin/marketplace *intent* is declared in .scripts/reconcile-agents.sh +
# dot_config/agents/plugins.conf. autoMode is never declared here: it records repo and org
# names and where secrets live, and this repo is public.
#
# private_ prefix => target is deployed 0600. Bash 3.2 compatible. $HOME (not a hardcoded
# path) keeps the statusline commands correct on any machine.
set -euo pipefail

input=$(cat)
# Fresh machine: no existing file => empty stdin => start from {}. A case pattern, not
# ${input//[[:space:]]/}: bash 3.2 runs that substitution in quadratic time, 8-40s on a
# real 13 KB settings.json.
case "$input" in *[![:space:]]*) ;; *) input='{}' ;; esac
# Never overwrite a broken file: bail with no stdout if the current content isn't valid JSON,
# or holds more than one document (`{} {}` would otherwise emit two objects).
if ! printf '%s' "$input" | jq empty >/dev/null 2>&1 \
  || [ "$(printf '%s' "$input" | jq -s 'length')" != 1 ]; then
  echo "modify settings.json: current file is not one valid JSON document — refusing to overwrite" >&2
  exit 1
fi

printf '%s' "$input" | jq \
  --arg sl "bash $HOME/.claude/statusline.sh" \
  --arg subsl "bash $HOME/.claude/subagent-statusline.sh" \
  --arg herdr_hook "bash '$HOME/.claude/hooks/herdr-agent-state.sh' session" \
  --arg agent_socket "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" \
  --arg tool_path "$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.cargo/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.krew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" '
  # Start from the LIVE file and overlay the owned keys with +, which replaces each named
  # key wholesale and leaves every other key alone. Until 2026-09-30 this rebuilt the object
  # and carried a named whitelist, so every runtime key nobody listed (the notification
  # toggles, autoContinueAtUsageLimit, modelSettings) vanished on the next apply.
  # NB: no apostrophes anywhere in this program; it is one single-quoted shell string.
  . as $live
  | ($live.permissions // {}) as $perm
  | $live + {
      "theme": "custom:tokyo-night",
      # 30 days of transcripts: the safe-autonomy evaluation measures over them.
      "cleanupPeriodDays": 30,
      "env": {
        "EDITOR": "nvim",
        "SSH_AUTH_SOCK": $agent_socket,
        "PATH": $tool_path,
        # Go verifies TLS chains through Security.framework, which reaches the
        # com.apple.trustd.agent Mach service — blocked by the Bash sandbox. Every Go CLI
        # (glab, gh, tsh, terraform) then dies with
        # `tls: failed to verify certificate: x509: OSStatus -26276`, which reads like a
        # rejected certificate but is the verifier being unreachable: the chain is never
        # evaluated. Pointing SSL_CERT_FILE at the Apple system root bundle switches Go
        # (and OpenSSL) to file-based verification, so no trustd lookup happens.
        # Preferred over sandbox.enableWeakerNetworkIsolation, which fixes the same
        # failure by opening trustd — an exfiltration path — and over excludedCommands,
        # which would drop glab out of the sandbox altogether. Trade-off: file
        # verification sees only the system roots, not keychain-added private CAs;
        # nothing here needs one.
        "SSL_CERT_FILE": "/etc/ssl/cert.pem"
      },
      # No agent attribution in git history or MR/PR descriptions. `attribution`
      # supersedes the deprecated `includeCoAuthoredBy` and adds `sessionUrl`, which is
      # a SEPARATE gate: `includeCoAuthoredBy: false` alone still appended the
      # `Claude-Session:` trailer and the claude.ai link in PR bodies. Empty strings hide
      # the commit/PR attribution text. The deprecated key is retired (deleted below).
      "attribution": { "commit": "", "pr": "", "sessionUrl": false },
      "permissions": {
        "allow": [
          "Bash(glab ci list *)",     "Bash(glab ci get *)",
          "Bash(glab mr view *)",     "Bash(glab issue view *)",
          "Bash(glab auth status)",
          "Bash(chezmoi diff)",       "Bash(chezmoi diff *)",
          "Bash(chezmoi status)",     "Bash(chezmoi status *)",
          # NOTE: no chezmoi cat here. It runs op unsandboxed and can render private
          # keys, so it goes to the auto-mode classifier like any other command.
          # Basecamp: read-only verbs only. These were auto-learned into
          # settings.local.json as `basecamp auth *` / `basecamp projects *`, which
          # quietly pre-approved `auth token` (prints the live OAuth token) and
          # `projects delete`. Everything not listed here falls through to the auto-mode
          # classifier, which is what should be judging a delete.
          "Bash(basecamp accounts list*)", "Bash(basecamp accounts show*)",
          "Bash(basecamp projects list*)", "Bash(basecamp projects show*)",
          "Bash(basecamp cards show *)",   "Bash(basecamp show *)",
          "Bash(basecamp search *)",       "Bash(basecamp url *)",
          "Bash(basecamp auth status)",
          "WebFetch(domain:launchpad.37signals.com)"
        ],
        "deny": [
          "Read(~/.ssh/**)",             "Edit(~/.ssh/**)",
          "Read(~/.aws/credentials)",    "Edit(~/.aws/credentials)",
          "Read(~/.config/op/config)",   "Edit(~/.config/op/config)",
          "Read(**/secrets.*.yml)",      "Edit(**/secrets.*.yml)",
          "Read(**/.env.production*)",   "Edit(**/.env.production*)",
          "Read(**/*.key)",              "Edit(**/*.key)",
          "Read(**/*.pem)",              "Edit(**/*.pem)",
          "Bash(basecamp auth token*)",
          # Secrets never enter the transcript: every op verb that prints or injects a
          # secret value, in singular and plural spellings and with a leading global
          # flag (op --account x read). op item create/edit/delete stay asks, below.
          "Bash(op read*)",              "Bash(op item get*)",
          "Bash(op items get*)",         "Bash(op document get*)",
          "Bash(op documents get*)",     "Bash(op inject*)",
          "Bash(op run*)",
          "Bash(op --* read*)",          "Bash(op --* item get*)",
          "Bash(op --* items get*)",     "Bash(op --* document get*)",
          "Bash(op --* inject*)",        "Bash(op --* run*)",
          # Lasting mail send-out paths: a server-side rule or an auto-reply keeps
          # sending long after the session that set it up.
          "mcp__claude_ai_Microsoft_365__outlook_create_filter",
          "mcp__claude_ai_Microsoft_365__outlook_set_vacation"
        ],
        "ask": [
          "Read(~/.kube/config)",
          # NOTE: no Edit() rules here on purpose. The infra gates (~/.kube/config,
          # Dockerfile, docker-compose, GitHub/GitLab CI, terraform/, ansible/) prompted
          # on every edit in every repo, mine included, and an ask rule is absolute.
          # Removed 2026-09-03 — the auto-mode classifier judges these now, and the deny
          # list above still blocks the credential files outright.
          # NOTE: no "Bash(glab api *)" here on purpose. It gated the mechanism, not
          # the danger — 156 fires in one fortnight, 2 real rejections, every sampled
          # call a read-only GET. An ask rule is absolute (a hook allow loses to it),
          # so it cannot be narrowed from this side. The write half is gated in
          # git-forge-guard.sh rule 3 instead; see the comment there.
          "Bash(glab mr merge*)",
          "Bash(sudo *)",
          # NOTE: no git push rules here on purpose. An ask rule is absolute (a hook allow
          # loses to it), so it could not tell --force-with-lease on a feature branch from a
          # force push to main. git-forge-guard.sh rule 4 gates pushes instead.
          "Bash(git reset --hard*)",    "Bash(git clean -f*)",
          "Bash(git branch -D*)",       "Bash(git filter-branch*)",
          "Bash(rm -rf ~/*)",           "Bash(rm -rf /Users/michael/*)",
          "Bash(rm -r ~/*)",            "Bash(rm -r /Users/michael/*)",
          "Bash(brew uninstall*)",      "Bash(brew remove*)",
          "Bash(kubectl delete*)",
          "Bash(borg *)",               "Bash(vorta *)",
          "Bash(op item create*)",      "Bash(op item edit*)",
          "Bash(op item delete*)",
          "Bash(docker rm*)",           "Bash(docker rmi*)",
          "Bash(docker system prune*)", "Bash(docker volume rm*)",
          "Bash(docker compose down*)",
          # Destructive Microsoft 365 actions.
          "mcp__claude_ai_Microsoft_365__outlook_batch_delete_messages",
          "mcp__claude_ai_Microsoft_365__outlook_trash_thread",
          "mcp__claude_ai_Microsoft_365__outlook_delete_event",
          "mcp__claude_ai_Microsoft_365__sharepoint_delete_item",
          # Destructive Basecamp verbs, only those the installed CLI really has (projects
          # and chat have delete, the rest trash), spelled out per resource so that free
          # text which merely contains the word delete (a comment body, say) never matches.
          "Bash(basecamp projects delete*)",  "Bash(basecamp chat delete*)",
          "Bash(basecamp todos trash*)",      "Bash(basecamp todolists trash*)",
          "Bash(basecamp messages trash*)",   "Bash(basecamp cards trash*)",
          "Bash(basecamp files trash*)",      "Bash(basecamp comments trash*)",
          "Bash(basecamp recordings trash*)", "Bash(basecamp vaults trash*)",
          "Bash(basecamp docs trash*)",       "Bash(basecamp tools trash*)",
          # Infrastructure teardown.
          "Bash(helm uninstall*)",      "Bash(helm delete*)",
          # A real az delete always carries a flag, so the trailing dash keeps free text
          # (a PR title saying soft delete) from matching.
          "Bash(az * delete -*)",       "Bash(az rest * DELETE*)",
          "Bash(terraform destroy*)"
        ]
      },
      "enableAllProjectMcpServers": false,
      "statusLine": { "type": "command", "command": $sl, "padding": 0 },
      "subagentStatusLine": { "type": "command", "command": $subsl },
      # Claude Code injects an UNAUTHENTICATED `nc` GIT_SSH_COMMAND at runtime, which
      # overrides the env block above — so setting it there is inert (see the
      # 2026-07-31 post-implementation correction in the security-posture design record).
      # CLAUDE_ENV_FILE is the documented fix: Claude Code runs it as a script preamble
      # before EVERY Bash command, i.e. after the injection, so an export here wins.
      # $HOME and $CLAUDE_ENV_FILE stay literal here and expand when the hook runs.
      # NOTE: `>` truncates. A second writer to CLAUDE_ENV_FILE (direnv, etc.) must
      # append, or the two hooks will clobber each other.
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "echo \"export GIT_SSH_COMMAND=$HOME/.local/bin/ssh-sandbox-proxy\" > \"$CLAUDE_ENV_FILE\""
              }
            ]
          },
          # The Herdr agent-state hook. Owned here rather than left to
          # `herdr integration install claude`: that installer rewrites settings.json
          # directly, so the two would fight on every `chezmoi apply`. Shape mirrors
          # what the installer actually writes (observed, not guessed): a matcher,
          # a session argument, timeout 10, and an absolute path.
          #
          # claude-settings.test.sh finds each hook by its command, not its position.
          # No apostrophes in these comments: the program is one single-quoted string.
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": $herdr_hook,
                "timeout": 10
              }
            ]
          }
        ],
        # Backstop for the two "Merge & pull requests" rules in GLOBAL.md that prose
        # alone cannot guarantee: no agent attribution in commits/MRs/PRs, and follow
        # the repo MR/PR template. Denies (never asks) with a reason the model acts on,
        # so a violation costs a retry and never reaches Michael. Fires on every Bash
        # call, so the script fast-paths out in ~6ms; tests in
        # tests/git-forge-guard.test.sh. $HOME stays literal, expanded when it runs.
        # Second entry: the worktree guard. Denies raw `git worktree remove` on a wt
        # sibling worktree, which skips Herdr workspace closure and leaves husk directories.
        # claude-settings.test.sh finds each guard by its command, so order carries no meaning.
        # Third entry: the cross-review guard. Denies proposing a branch for merge with
        # no Codex review on record; a skipped review looks identical to a clean one.
        # Fourth entry: the apply-window guard. Its matcher is a wildcard because it
        # inspects Edit/Write rather than Bash; it is inert unless xreview apply has
        # opened a window.
        # Fifth entry: the path-resolution guard. Denies the two command shapes that
        # always cost an interactive prompt — a compound command starting with cd, and
        # a recursive grep/rg over dot — because a Read() deny rule cannot be evaluated
        # against them and no hook can lift a deny. Bounces the fix back to the model.
        # Tests in tests/worktree-guard.test.sh, xreview-guard.test.sh,
        # xreview-apply-guard.test.sh and path-resolution-guard.test.sh.
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              { "type": "command", "command": "bash $HOME/.claude/git-forge-guard.sh", "timeout": 60 }
            ]
          },
          {
            "matcher": "Bash",
            "hooks": [
              { "type": "command", "command": "bash $HOME/.claude/worktree-guard.sh" }
            ]
          },
          {
            "matcher": "Bash",
            "hooks": [
              { "type": "command", "command": "bash $HOME/.claude/xreview-guard.sh" }
            ]
          },
          {
            "matcher": "*",
            "hooks": [
              { "type": "command", "command": "bash $HOME/.claude/xreview-apply-guard.sh" }
            ]
          },
          {
            "matcher": "Bash",
            "hooks": [
              { "type": "command", "command": "bash $HOME/.claude/path-resolution-guard.sh" }
            ]
          }
        ]
      },
      "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": true,
        "allowUnsandboxedCommands": true,
        "credentials": {
          "files": [
            { "path": "~/.ssh/borg",                           "mode": "deny" },
            { "path": "~/.ssh/borg-append-only",               "mode": "deny" },
            { "path": "~/.ssh/borg-append-only-fenrir",        "mode": "deny" },
            { "path": "~/.ssh/borg-config-michelangelo.tar.gz","mode": "deny" },
            { "path": "~/.ssh/borg-config-raphael.tar.gz",     "mode": "deny" },
            { "path": "~/.ssh/borg-fenrir",                    "mode": "deny" },
            { "path": "~/.ssh/borg-hercules",                  "mode": "deny" },
            { "path": "~/.ssh/borg-synology",                  "mode": "deny" },
            { "path": "~/.ssh/huginn",                         "mode": "deny" },
            { "path": "~/.ssh/michael",                        "mode": "deny" },
            { "path": "~/.ssh/michael_rsa",                    "mode": "deny" },
            { "path": "~/.ssh/viumore_rsa",                    "mode": "deny" },
            { "path": "~/.aws/credentials",                    "mode": "deny" },
            { "path": "~/.config/op/config",                   "mode": "deny" }
          ]
        },
        # docker is here because it talks to its own socket. basecamp (macOS Keychain),
        # herdr and xreview (the herdr unix socket) are the same shape and worse: sandboxed
        # they do not fail visibly. basecamp auth status returns {"ok": true,
        # "authenticated": false} and xreview reports "no Codex pane" — confident wrong
        # answers with no error, so the global rule of escalating only on sandbox evidence
        # has nothing to fire on. Declaring them here is mechanical, unlike remembering to
        # pass dangerouslyDisableSandbox on every call.
        #
        # Deliberately narrower than allowlisting the herdr socket under network: that
        # would let ANY sandboxed command drive herdr pane run, which is a sandbox escape.
        # Excluding the herdr client only lets herdr itself out.
        "excludedCommands": ["docker *", "basecamp *", "herdr *", "xreview *"],
        "filesystem": {
          "allowRead": [
            "~/.ssh/config",
            "~/.ssh/known_hosts",
            "~/.ssh/borg-append-only-fenrir.pub",
            "~/.ssh/borg-append-only.pub",
            "~/.ssh/borg-fenrir.pub",
            "~/.ssh/borg-hercules.pub",
            "~/.ssh/borg-synology.pub",
            "~/.ssh/borg.pub",
            "~/.ssh/huginn.pub",
            "~/.ssh/michael.pub",
            "~/.ssh/michael_rsa.pub",
            "~/.ssh/viumore_rsa.pub"
          ],
          "allowWrite": [
            "~/Code",
            "~/.local/share/chezmoi",
            "~/.local/bin",
            "~/.config",
            "~/Documents",
            "~/Library/Mobile Documents/iCloud~md~obsidian"
          ]
        },
        # strictAllowlist is what makes this list DO anything: without it non-listed
        # hosts are merely prompted, and autoAllowBashIfSandboxed suppresses that prompt
        # too, so the allowlist was decorative until 2026-08-24 (verified: sandboxed
        # `curl https://example.com` returned 200). It was reportedly enabled once before
        # and lost, because this block is owned declaratively and anything set at runtime
        # but not named here is erased on the next apply. Hence the test assertion.
        # Adding a host is cheap; the list below is what the toolchain here needs.
        "network": {
          "allowUnixSockets": [$agent_socket],
          "allowLocalBinding": true,
          "strictAllowlist": true,
          "allowedDomains": [
            "gitlab.com", "registry.gitlab.com",
            "github.com", "api.github.com", "uploads.github.com", "codeload.github.com",
            "raw.githubusercontent.com", "objects.githubusercontent.com",
            "pkg-containers.githubusercontent.com",
            "registry.npmjs.org", "registry.yarnpkg.com",
            "pypi.org", "files.pythonhosted.org",
            "rubygems.org", "index.rubygems.org",
            "index.crates.io", "static.crates.io", "crates.io",
            # scripts that call the Claude API from sandboxed Bash
            "api.anthropic.com",
            # Homebrew
            "formulae.brew.sh", "ghcr.io",
            # mise-managed runtimes (ruby, rust, dotnet; python builds ride GitHub releases)
            "mise-versions.jdx.dev",
            "cache.ruby-lang.org", "www.ruby-lang.org",
            "static.rust-lang.org",
            "builds.dotnet.microsoft.com", "dotnetcli.azureedge.net",
            # Azure CLI
            "login.microsoftonline.com", "management.azure.com", "graph.microsoft.com",
            # Teleport proxies (k8s access rides these, so no cluster endpoints needed)
            "teleport.viumore.com", "teleport2.viumore.com",
            # Basecamp CLI: OAuth on launchpad, API + attachments on basecampapi/basecamp
            "launchpad.37signals.com",
            "3.basecampapi.com", "basecamp3.basecampapi.com",
            "3.basecamp.com", "storage.3.basecamp.com", "app.basecamp.com"
          ]
        }
      },
      "tui": "fullscreen",
      "voice": { "enabled": false, "mode": "hold" },
      "skipWorkflowUsageWarning": true,
      "preferredNotifChannel": "ghostty",
      "showTurnDuration": true,
      "showMessageTimestamps": true,
      "terminalProgressBarEnabled": true,
      "skipAutoPermissionPrompt": true,
      "disableAllHooks": false
    }
  # permissions is owned only in part: allow, deny and ask above replace the live lists
  # wholesale; every other permissions key in the live file (additionalDirectories, say)
  # is carried, and defaultMode is seeded below.
  | .permissions = ($perm + .permissions)
  # Retired keys: owned once, owned no more. Starting from the live file keeps a key
  # forever unless it is deleted here by name. includeCoAuthoredBy is superseded by
  # attribution, voiceEnabled by the voice object.
  | del(.includeCoAuthoredBy, .voiceEnabled)
  # Posture-weakening runtime keys: reset on every apply, never carried from the live
  # file. Declare one in the overlay above to keep it.
  | del(.skipDangerousModePermissionPrompt, .apiKeyHelper, .enabledMcpjsonServers)
  # default-only: keep the current value if set (runtime /model, /effort, /permissions,
  # /output-style persist), otherwise seed the default; deleting the key and re-applying
  # restores it. outputStyle names a built-in style (Proactive, Concise, Explanatory,
  # Learning) or a file in ~/.claude/output-styles.
  | .model = ($live.model // "opus[1m]")
  | .effortLevel = ($live.effortLevel // "xhigh")
  | .permissions.defaultMode = ($perm.defaultMode // "auto")
  | .outputStyle = ($live.outputStyle // "Concise")
'
