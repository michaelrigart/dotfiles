# Git attributes for chezmoi dotfiles repository

# Auto-detect text files and normalize line endings to LF everywhere (scripts included,
# even on Windows)
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
