<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repaint the Herdr space phase badges on a timer.

  Managed by chezmoi (source: Library/LaunchAgents/be.netronix.herdr-phase-refresh.plist).
  Bootstrapped by .scripts/configure.sh; load by hand with:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/be.netronix.herdr-phase-refresh.plist

  The dev.phase plugin's event hooks cannot keep an MR badge current on their own: the
  state that changes lives on GitLab, and opening or merging an MR fires no Herdr event.
  See the header of ~/.config/herdr/phase.sh for the full reasoning.

  phase.sh is invoked directly rather than through a login shell. It appends
  /opt/homebrew/bin to PATH itself and falls back to the XDG defaults when the variables
  are unset, which is exactly the environment launchd hands it. When no Herdr server is
  running the run is a sub-100ms no-op: `spaces` is empty and refresh returns before any
  git or glab work.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>be.netronix.herdr-phase-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.config/herdr/phase.sh</string>
        <string>refresh</string>
    </array>

    <!-- 180s against phase.sh's 120s MR-table TTL: every run re-reads GitLab, so a badge
         is at most three minutes stale. Cheap because it is one `glab mr list` per repo,
         not per worktree. -->
    <key>StartInterval</key>
    <integer>180</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Nothing here is worth a log file; failures are visible as a stale badge, and the
         script is deliberately silent so a hook cannot be tricked into printing tokens. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
