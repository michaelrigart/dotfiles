<?xml version="1.0" encoding="UTF-8"?>
<!--
  Start Codex's shared app-server daemon at login, with a clean environment.

  Managed by chezmoi (source: Library/LaunchAgents/be.netronix.codex-app-server.plist.tmpl).
  Loaded by .scripts/configure.sh; load by hand with:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/be.netronix.codex-app-server.plist

  Why launchd and not the first TUI: a daemon spawned by a TUI keeps that pane's HERDR_*
  environment, and herdr's hook, which runs inside the daemon, then reports every Codex thread
  against that one pane. features.daemon_auto_start is pinned false so no TUI spawns one;
  `codex-daemon ensure` kickstarts this agent when an interactive start finds none running.

  `daemon start` returns once the daemon's own supervisor is up, so there is no KeepAlive;
  AbandonProcessGroup keeps launchd from reaping what it started. PATH mirrors what an
  interactive shell would activate, so commands the reviewer runs find the same toolchains.
  ~/.local/bin comes before Homebrew so the hook and the daemon itself resolve `codex-daemon`
  and `xreview-rpc` to the launcher's own directory. A bare `codex` invoked from inside the
  daemon (the reviewer's tools, say) resolves to the ~/.local/bin launcher too, not the real
  binary - harmless here, because the daemon this launcher would ensure is the one already
  running it. The XDG variables mirror the strict XDG layout so herdr (whose default socket
  follows XDG_CONFIG_HOME) and the reviewer's tools resolve the same paths as a shell; they
  apply only at a fresh launchd start.

  The log is ~/.local/state/codex-daemon.log (XDG state), not /dev/null: a daemon that fails
  to start (or that a bad PATH entry breaks) otherwise leaves nothing to diagnose it with.
  The shell creates the directory and redirects, instead of StandardOutPath: launchd opens
  that path before the program runs and cannot create a missing directory, which a fresh
  machine may not have yet.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>be.netronix.codex-app-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p '{{ .chezmoi.homeDir }}/.local/state' &amp;&amp; exec '{{ if .is_arm }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/codex' app-server daemon start &gt;&gt;'{{ .chezmoi.homeDir }}/.local/state/codex-daemon.log' 2&gt;&amp;1</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:{{ if .is_arm }}/opt/homebrew/bin:/opt/homebrew/sbin:{{ end }}/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>XDG_CONFIG_HOME</key>
        <string>{{ .chezmoi.homeDir }}/.config</string>
        <key>XDG_DATA_HOME</key>
        <string>{{ .chezmoi.homeDir }}/.local/share</string>
        <key>XDG_STATE_HOME</key>
        <string>{{ .chezmoi.homeDir }}/.local/state</string>
        <key>XDG_CACHE_HOME</key>
        <string>{{ .chezmoi.homeDir }}/.cache</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir }}</string>

    <key>RunAtLoad</key>
    <true/>

    <key>AbandonProcessGroup</key>
    <true/>

</dict>
</plist>
