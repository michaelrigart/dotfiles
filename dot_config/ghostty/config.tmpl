{{- $live := output "scutil" "--get" "ComputerName" | trim -}}
# Theme and Colors - Using Ghostty's built-in theme system

# Font Configuration
font-family = "JetBrains Mono"
font-size = 13
font-style = normal
font-style-bold = bold
font-style-italic = italic
font-style-bold-italic = bold-italic

{{ if eq $live "fenrir" -}}
# Low-DPI compensation, fenrir only. Its LG 38GN950 is 3840x1600 at 1x — roughly
# 111 PPI, and macOS offers no HiDPI mode for it — so glyph stems rasterize thinner
# than the typeface intends. hercules runs a 2x virtual display and does not need
# this; thickening a Retina buffer just looks bloated.
#
# If this reads too heavy, lower font-thicken-strength (0-255, default 255).
# The next lever after this is `alpha-blending = linear-corrected`, which
# compensates for light-on-dark text rendering thin — try it separately, not
# stacked, or you cannot tell which one did what.
font-thicken = true
{{ end -}}


# Theme and Colors
theme = "tokyo-night"
background-opacity = 1
background-blur = 0
unfocused-split-opacity = 0.7


# macOS specific
macos-titlebar-style = tabs
# left Option = Alt (Zellij/shell shortcuts); right Option stays macOS Option so
# AZERTY special chars (@ # [ ] { } | \) still type. (Was `true`, which ate them.)
macos-option-as-alt = left
macos-titlebar-proxy-icon = visible

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell Integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Mouse
mouse-hide-while-typing = true
copy-on-select = clipboard

# Scrollback
scrollback-limit = 10000

# Performance
resize-overlay = never
resize-overlay-position = center
resize-overlay-duration = 0

# URL Handling
click-repeat-interval = 300

# Window Management
window-decoration = true
window-theme = auto

# Claude shift+enter
keybind = shift+enter=text:\x1b\r

# Clear screen — Ghostty's built-in clear_screen is a no-op in the alternate
# screen (i.e. inside Zellij/TUIs), so send Alt-k instead. Zellij binds Alt-k to
# Clear; a bare shell can bind '\ek' to clear-screen. Works in and out of Zellij.
keybind = cmd+k=text:\x1bk

# Navigate splits with Cmd+Arrow
keybind = cmd+left=goto_split:left
keybind = cmd+right=goto_split:right
keybind = cmd+up=goto_split:top
keybind = cmd+down=goto_split:bottom

# Cmd+Plus/Minus for font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Search
#keybind = cmd+f=search:Ghostty
#keybind = shift+cmd+f=search:
