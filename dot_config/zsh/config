#!/usr/bin/env zsh

# Starship draws the prompt, so oh-my-zsh loads no theme.
ZSH_THEME=""
eval "$(starship init zsh)"

# Hook direnv into the shell
eval "$(direnv hook zsh)"

# Activate mise
eval "$(mise activate zsh)"

# enable zoxide — deferred so it initializes after oh-my-zsh installs its
# chpwd hook (config is sourced before oh-my-zsh.sh in .zshrc); avoids the
# "initialize zoxide at the end of your shell config" warning.
autoload -Uz add-zsh-hook
__init_zoxide() {
  eval "$(zoxide init zsh --cmd cd)"
  add-zsh-hook -d precmd __init_zoxide
  unset -f __init_zoxide
}
add-zsh-hook precmd __init_zoxide


# History is state, not cache: it lives in $XDG_STATE_HOME. The first shell start after
# the move carries the old $XDG_CACHE_HOME file across, and never overwrites a history
# that already exists at the new place (two shells can start at once).
HISTFILE="$XDG_STATE_HOME/zsh/zsh_history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
if [[ ! -e "$HISTFILE" && -f "$XDG_CACHE_HOME/zsh/zsh_history" ]]; then
  mv -n "$XDG_CACHE_HOME/zsh/zsh_history" "$HISTFILE" 2>/dev/null
fi
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# Skip oh-my-zsh's compaudit pass on every start; this is a single-user machine.
# Must be set before oh-my-zsh.sh is sourced.
ZSH_DISABLE_COMPFIX=true

plugins=(bundler docker fzf gem git rails rake ssh sudo)

# Disable terminal flow control (Ctrl-s / Ctrl-q) so a stray Ctrl-s in a shell
# pane can't XOFF-freeze it. Herdr's prefix is Ctrl-b and does not claim Ctrl-s.
[[ -t 0 ]] && stty -ixon

# Raise (never lower) the open-file limit. launchd hands GUI apps — Ghostty included —
# a soft limit of only 256, which LSP file watchers blow straight through: ruby-lsp
# watches ~3k directories in a Rails repo and Neovim then throws EMFILE
# (vim/_watch.lua). The hard limit is unlimited, so lifting the soft limit is enough.
if [[ "$(ulimit -n)" != unlimited ]] && (( $(ulimit -n) < 8192 )); then
  ulimit -n 8192 2>/dev/null
fi

