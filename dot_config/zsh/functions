#!/usr/bin/env zsh
# Custom shell functions

# op-edit — edit a 1Password-backed dotfile, then re-apply the chezmoi targets
# that render from it.
#
# Some dotfiles keep their contents in a 1Password secure note instead of the
# public dotfiles repo, rendered by chezmoi with:
#     {{ onepasswordRead "op://<vault>/<item>/notes" }}
# e.g. ~/.ssh/config.
#
# Usage:
#   op-edit                  # list op-backed dotfiles (file ⇐ 1Password item)
#   op-edit ~/.ssh/config    # by file path — resolves the note automatically
#   op-edit "SSH config"     # or by 1Password item name
#
# The note is written to a private temp file (mode 600) while editing and passed
# to `op item edit` as an argument (briefly visible via `ps`).
op-edit() {
  emulate -L zsh
  local src; src="$(chezmoi source-path)" || return 1

  # No argument: list op-backed dotfiles as "file ⇐ item".
  if [[ -z "$1" ]]; then
    print -r -- "op-edit <file|item> — 1Password-backed dotfiles:"
    local f r i t
    while IFS= read -r f; do
      r="$(grep -m1 -oE 'op://[^"]+/notes' "$f" 2>/dev/null)" || continue
      [[ -n "$r" ]] || continue
      i="${${r#op://*/}%/notes}"
      t="$(chezmoi target-path "$f" 2>/dev/null)"
      printf '  %-30s ⇐  %s\n' "${t/#$HOME/~}" "$i"
    done < <(grep -rlE 'op://[^"]+/notes' "$src" --include='*.tmpl' 2>/dev/null) | sort -u
    return 0
  fi

  # Resolve the argument to an op reference: a managed file path, or an item name.
  local arg="${1/#\~/$HOME}" srcfile ref
  if srcfile="$(chezmoi source-path "$arg" 2>/dev/null)"; then
    ref="$(grep -m1 -oE 'op://[^"]+' "$srcfile" 2>/dev/null)"
    if [[ -z "$ref" ]]; then
      print -ru2 -- "op-edit: '$1' is chezmoi-managed but not backed by a 1Password note."
      return 1
    fi
  else
    ref="op://Private/$1/notes"
  fi

  # Parse op://<vault>/<item>/<field>.
  local rest="${ref#op://}"
  local vault="${rest%%/*}"; rest="${rest#*/}"
  local item="${rest%/*}" field="${rest##*/}"
  if [[ "$field" != "notes" ]]; then
    print -ru2 -- "op-edit: '$1' maps to op field '$field', not a note — edit it in 1Password directly."
    return 1
  fi

  # Pull current note content into a private temp file.
  local tmp; tmp="$(mktemp -t op-edit)" || return 1
  if ! op read "$ref" >| "$tmp" 2>/dev/null; then
    print -ru2 -- "op-edit: can't read $ref — does '$item' exist in '$vault'?"
    rm -f "$tmp"; return 1
  fi

  # Edit; bail out if nothing changed.
  local before; before="$(shasum "$tmp" | awk '{print $1}')"
  "${EDITOR:-nvim}" "$tmp"
  if [[ "$before" == "$(shasum "$tmp" | awk '{print $1}')" ]]; then
    print -r -- "op-edit: no changes to '$item'."
    rm -f "$tmp"; return 0
  fi

  # Push the edited content back to the note.
  if ! op item edit "$item" --vault "$vault" "notesPlain=$(<"$tmp")" >/dev/null; then
    print -ru2 -- "op-edit: failed to update '$item'."
    rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"

  # Re-apply every chezmoi target that renders from this note.
  local -a targets=()
  local f t
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    t="$(chezmoi target-path "$f" 2>/dev/null)"
    [[ -n "$t" ]] && targets+=("$t")
  done < <(grep -rlF "op://$vault/$item/" "$src" --include='*.tmpl' 2>/dev/null)

  if (( ${#targets} )); then
    chezmoi apply "${targets[@]}" \
      && print -r -- "✓ '$item' updated → applied: ${targets[*]/#$HOME/~}"
  else
    print -r -- "✓ '$item' updated."
  fi
}

# tsh — Teleport SSH with a portable TERM. Ghostty's ssh-env/ssh-terminfo cover
# the plain `ssh` binary, but not `tsh`, and edge nodes lack xterm-ghostty
# terminfo. Only the `ssh` subcommand needs the downgrade; other subcommands
# (tsh login, kube, db, …) run untouched.
tsh() {
  if [[ "$1" == "ssh" ]]; then
    TERM=xterm-256color command tsh "$@"
  else
    command tsh "$@"
  fi
}

# dev — open (or return to) a project in its Herdr workspace. Resolve an argument to
# a repository under ~/Code, then hand that path to layout.sh: a primary checkout
# opens as an ordinary workspace, a linked one through native worktree mode.
#   dev                    pick from all repos under ~/Code (fzf)
#   dev curato             by name: exact basename → case-insensitive substring → fzf
#   dev Netronix/curato    path relative to ~/Code
#   dev .                  the git repo containing the current directory
#
# The retired `dev` also accepted a session name (`dev netronix--curato`). There are no
# session names any more, so such an argument matches no repo by basename or substring
# and falls through to the fzf picker.
#
# Resolution only. Everything about Herdr lives in layout.sh.
dev() {
  emulate -L zsh
  setopt local_options null_glob extended_glob

  local code="$HOME/Code" repo arg="$1"
  local -a repos=( "$code"/*/.git(N:h) "$code"/*/*/.git(N:h) )

  if [[ "$arg" == "." || ( -n "$arg" && -d "$arg" ) ]]; then
    repo="$(_wt_git -C "${arg:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" \
      || { print -ru2 -- "dev: '${arg:-$PWD}' is not inside a git repo."; return 1 }
  elif [[ -n "$arg" && -e "$code/$arg/.git" ]]; then
    repo="$code/$arg"
  else
    local -a hits
    if [[ -z "$arg" ]]; then
      hits=( $repos )
    else
      hits=( ${(M)repos:#*/$arg} )                       # exact basename
      (( ${#hits} )) || hits=( ${(M)repos:#(#i)*$arg*} ) # case-insensitive substring
    fi
    if (( ${#hits} == 1 )); then
      repo="${hits[1]}"
    else
      local -a pool; (( ${#hits} )) && pool=( $hits ) || pool=( $repos )
      local sel
      sel="$(print -rl -- ${pool[@]#$code/} | fzf --prompt='dev > ' ${arg:+--query=$arg})" || return 0
      [[ -n "$sel" ]] || return 0
      repo="$code/$sel"
    fi
  fi

  repo="${repo:A}"
  [[ -n "$repo" && -e "$repo/.git" ]] || { print -ru2 -- "dev: no git repo resolved."; return 1 }

  # A linked checkout must enter through layout.sh's worktree mode, which keeps
  # Herdr's worktree provenance; an ordinary workspace could not be identified safely
  # by wt-rm.
  if [[ -f "$repo/.git" ]]; then
    local main
    main="$(builtin cd "$repo" && _wt_primary)" || return 1
    _wt_prepare_for_herdr "$main" "$repo" || return 1
    "${DEV_LAYOUT:-$HOME/.config/herdr/layout.sh}" --worktree "$main" "$repo"
    return $?
  fi

  "${DEV_LAYOUT:-$HOME/.config/herdr/layout.sh}" "$repo"
}

# Library functions use `builtin cd`, never bare `cd`: they must not depend on whatever an
# interactive shell binds `cd` to, because the `zsh -ic <cmd>` shells that Herdr popups
# run never reach a prompt.

# _wt_git — git with its routing environment cleared. Every Git call in the lifecycle
# goes through this: an exported GIT_DIR or GIT_WORK_TREE redirects git to another
# checkout, and `status` then reports a dirty worktree as clean with exit status 0.
_wt_git() {
  emulate -L zsh
  command env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE \
    git "$@"
}

# _wt_primary — absolute path of the repository's primary worktree.
#
# Resolved from `worktree list`, never by path arithmetic on --git-common-dir, which
# yields the containing directory for a bare repo.
#
# -z is required: the line-based porcelain format may quote a path. ${(0)} drops the
# empty separator records, leaving field 1 = "worktree <path>" and, for a bare repo,
# field 2 = "bare".
_wt_primary() {
  emulate -L zsh
  local -a f
  f=( ${(0)"$(_wt_git worktree list --porcelain -z 2>/dev/null)"} )
  [[ "${f[1]}" == 'worktree '* ]] || {
    print -ru2 -- "wt: not inside a git repository."; return 1 }
  [[ "${f[2]}" == bare ]] && {
    print -ru2 -- "wt: repository is bare — there is no primary worktree to run from."; return 1 }
  print -r -- "${f[1]#worktree }"
}

# _wt_clean <worktree> — 0 clean, 1 dirty, 2 state unknown.
#
# Three-state on purpose: a failed `git status` produces empty output, which testing
# output alone would read as "no changes".
#
# Each flag closes a way a dirty tree can report clean:
#   --untracked-files=normal   defeats status.showUntrackedFiles=no
#   --ignore-submodules=none   defeats diff.ignoreSubmodules / submodule.*.ignore
#   --porcelain=v1             pins the format against a default change
#
# The assignment is split from `local` on purpose: `local x="$(cmd)"` reports the
# builtin's status, not the command substitution's.
_wt_clean() {
  emulate -L zsh
  local wt="$1" out rc
  out="$(_wt_git -C "$wt" status --porcelain=v1 --untracked-files=normal \
                 --ignore-submodules=none 2>/dev/null)"; rc=$?
  (( rc )) && return 2
  [[ -n "$out" ]] && return 1
  return 0
}

# _wt_lock <common-dir> <slug> / _wt_unlock — serialize lifecycle commands per
# target worktree, so `wt-prepare` cannot copy into a directory `wt-rm` is
# removing.
#
# `zsystem flock` is an fcntl(2) record lock despite the name:
#
#   1. The lock file must already exist — zsystem opens it and will not create it.
#   2. Release must be explicit. These are sourced functions: returning does not
#      close the descriptor, so without an unlock the fd stays open in the
#      interactive shell and blocks every OTHER process's lifecycle command on that
#      target until the shell exits. Kernel release on process death is the backstop
#      for an interrupt, which skips the `always` block (see the interruption note
#      below _wt_unlock).
#   3. Locks are per-process, not per-descriptor. A nested acquisition in the same
#      shell SUCCEEDS, and unlocking any one descriptor drops the process's lock
#      entirely — a routine that took its own lock would release its caller's. Only
#      the outermost command locks (the command/routine split in wt-prepare).
#
# So there is no intra-process exclusion; the case defended is concurrent commands
# in different terminals.
_wt_lock() {
  emulate -L zsh
  zmodload zsh/system 2>/dev/null || {
    print -ru2 -- "wt: zsh/system unavailable — refusing to run unlocked."; return 1 }
  local dir="$1/wt-locks" lf="$1/wt-locks/$2.lock"
  mkdir -p "$dir" && : >> "$lf" || {
    print -ru2 -- "wt: cannot create lock file $lf."; return 1 }
  # _WT_LOCK_FD is intentionally global: the caller unlocks it.
  if ! zsystem flock -t 0 -f _WT_LOCK_FD "$lf" 2>/dev/null; then
    print -ru2 -- "wt: another lifecycle command is working on '$2' — retry when it finishes."
    return 1
  fi
}

_wt_unlock() {
  emulate -L zsh
  [[ -n "${_WT_LOCK_FD:-}" ]] || return 0
  zsystem flock -u $_WT_LOCK_FD 2>/dev/null
  unset _WT_LOCK_FD
  return 0
}

# The lifecycle lock: wt applies it at creation and dev re-applies it. Only wt-rm
# crosses it, with Git's double force, after every check. Herdr's native removal
# (one --force) cannot cross it, which keeps it blocked: it skips teardown and the
# cleanliness checks.
_wt_herdr_lock_reason() {
  print -r -- "wt-managed; remove with command wt-rm"
}

# _wt_git_lock_state <root> <dest> — 0 locked (reason in _WT_GIT_LOCK_REASON),
# 1 registered but unlocked, 2 state unreadable/not registered.
#
# NUL porcelain, for the same reason as _wt_primary. A `worktree ` token starts each
# record, so empty separators need not survive ${(0)}.
_wt_git_lock_state() {
  emulate -L zsh
  # Never name a local `path` in zsh: it is the tied array behind PATH, and
  # localising it empties command lookup for every external below.
  local root="$1" dest="${2:A}" rec wt_path rc in_target=0 seen=0
  local -a fields
  typeset -g _WT_GIT_LOCK_REASON=""
  # zsh scalars cannot carry NUL bytes, so the array assignment through ${(0)} is the
  # one call that yields both the records and the command's status. Reading twice
  # would parse a failed read as authoritative: its empty result looks like an
  # unregistered worktree.
  fields=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} ); rc=$?
  if (( rc )); then
    print -ru2 -- "wt: cannot read Git worktree lock state for $dest — refusing."
    return 2
  fi
  for rec in $fields; do
    if [[ "$rec" == 'worktree '* ]]; then
      wt_path="${rec#worktree }"
      in_target=0
      [[ "${wt_path:A}" == "$dest" ]] && { in_target=1; seen=1; }
    elif (( in_target )) && [[ "$rec" == locked || "$rec" == 'locked '* ]]; then
      _WT_GIT_LOCK_REASON="${rec#locked}"
      _WT_GIT_LOCK_REASON="${_WT_GIT_LOCK_REASON# }"
      return 0
    fi
  done
  if (( seen )); then
    return 1
  fi
  print -ru2 -- "wt: $dest is not a registered worktree of $root."
  return 2
}

_wt_ensure_herdr_lock() {
  emulate -L zsh
  local root="$1" dest="$2" wanted state
  wanted="$(_wt_herdr_lock_reason)"
  _wt_git_lock_state "$root" "$dest"; state=$?
  case "$state" in
    0)
      if [[ "$_WT_GIT_LOCK_REASON" != "$wanted" ]]; then
        print -ru2 -- "dev: $dest is locked for another reason: ${_WT_GIT_LOCK_REASON:-<no reason>}"
        print -ru2 -- "    Herdr will not take ownership of a user-managed Git lock."
        return 1
      fi ;;
    1)
      _wt_git -C "$root" worktree lock --reason "$wanted" "$dest" || {
        print -ru2 -- "dev: could not apply the lifecycle lock to $dest — refusing to open it in Herdr."
        return 1
      } ;;
    *) return 1 ;;
  esac
}

# Serialize the Herdr handoff against wt-prepare/wt-rm, revalidate the checkout under
# that lock, then apply the persistent Git lock. The layout handoff stays outside the
# fcntl lock because it attaches a long-lived TUI.
_wt_prepare_for_herdr() {
  emulate -L zsh
  local main="$1" dest="$2" branch slug expected common
  branch="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)" || {
    print -ru2 -- "dev: $dest is detached — wt-rm requires a branch-owned checkout."
    return 1
  }
  slug="${branch//\//-}"
  expected="${main:h}/${main:t}-${slug}"
  if [[ "${dest:A}" != "${expected:A}" ]]; then
    print -ru2 -- "dev: $dest is not a wt-managed sibling checkout — refusing."
    print -ru2 -- "    Expected $expected for branch ${(q-)branch}; only that path is removable by command wt-rm."
    return 1
  fi
  common="$(_wt_git -C "$main" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || return 1
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1
    _wt_ensure_herdr_lock "$main" "$dest" || return 1
  } always {
    _wt_unlock
  }
}

# --- Interruption and the lock ---------------------------------------------
#
# There is deliberately NO `trap ... INT TERM` in any lifecycle command: it is
# fail-open on the destructive path. `return` inside a trap handler unwinds only the
# innermost function and zsh discards its status, so the interrupted helper reports
# 0 — and 0 is the permissive answer for every gate (_wt_clean "clean",
# _wt_hook_check "valid", _wt_assert_worktree "right branch"). Under SIGINT's
# default disposition the whole command unwinds and no status is fabricated.
#
# The accepted cost: a shell that survives an interrupt may keep the descriptor,
# which blocks other processes' lifecycle commands on that target until it exits.
# `always { _wt_unlock }` covers every ordinary exit path.
# Full argument: docs/superpowers/specs/2026-07-30-worktree-hook-protocol-design.md §9.4.

# _wt_hook_check <main> — 0 valid, 1 invalid, 2 absent (not opted in).
#
# Both the index entry and the working-tree path are checked: a tracked symlink
# passes "tracked" and "executable" while the code that runs lives outside the
# repository, and the index mode alone cannot see an unstaged local swap.
# Requiring 100755 in the index makes opt-in reproducible across clones. Stage 0
# rejects a conflicted hook.
_wt_hook_check() {
  emulate -L zsh
  local main="$1" hook="$1/.worktreehook" raw mode rc
  # Status captured separately, as in _wt_clean: a failed ls-files leaves `raw`
  # empty, which must not be read as "not opted in".
  raw="$(_wt_git -C "$main" ls-files --stage -- .worktreehook 2>/dev/null)"; rc=$?
  if (( rc )); then
    print -ru2 -- "wt: cannot read the index of $main to validate .worktreehook — refusing."
    return 1
  fi
  mode="$(print -r -- "$raw" | awk '$3 == 0 { print $1 }')"

  if [[ -z "$raw" ]]; then
    [[ -e "$hook" || -L "$hook" ]] || return 2          # not opted in
    print -ru2 -- "wt: $hook exists but is not tracked — commit it or remove it."
    return 1
  fi
  if [[ -z "$mode" ]]; then
    print -ru2 -- "wt: .worktreehook has no stage-0 index entry (unresolved conflict) — resolve it first."
    return 1
  fi
  if [[ "$mode" != 100755 ]]; then
    print -ru2 -- "wt: .worktreehook is indexed as $mode, not 100755."
    [[ "$mode" == 100644 ]] && \
      print -ru2 -- "    Fix with: git add --chmod=+x .worktreehook"
    return 1
  fi
  if [[ -L "$hook" ]]; then
    print -ru2 -- "wt: .worktreehook is a symlink in the working tree — refusing."
    return 1
  fi
  [[ -f "$hook" ]] || { print -ru2 -- "wt: .worktreehook is not a regular file."; return 1 }
  [[ -x "$hook" ]] || { print -ru2 -- "wt: .worktreehook is not executable."; return 1 }
  return 0
}

# _wt_hook_run <main> <worktree> <branch> <slug> <verb> — run the project hook.
#
# Validated here, immediately before execution: the pre-flight in `wt` is only a
# usability guard and does not substitute (hook-protocol design §5.1, "Validation is
# point-in-time").
#
# Executed as a process so its shebang picks the interpreter, in a subshell so cwd
# and WT_* never leak back into the caller.
_wt_hook_run() {
  emulate -L zsh
  local main="$1" wt="$2" branch="$3" slug="$4" verb="$5"
  _wt_hook_check "$main"
  case $? in
    2) return 0 ;;   # repository has not opted in
    1) return 1 ;;
  esac
  ( builtin cd "$wt" \
    && WT_MAIN="$main" WT_WORKTREE="$wt" WT_BRANCH="$branch" WT_SLUG="$slug" \
       "$main/.worktreehook" "$verb" )
  local hrc=$?
  (( hrc == 0 )) && return 0
  # Normalized to 1: the documented interface is 0/1; the hook's own status goes in
  # the message.
  print -ru2 -- "wt: .worktreehook $verb exited $hrc."
  return 1
}

# _wt_manifest <main> <dest> — validate .worktreeinclude and fill _WT_CARRY with
# the entries whose destination is still missing.
#
# Entries already present at the destination are skipped, never overwritten: a local
# edit in the worktree wins.
#
# Containment is checked lexically and through the filesystem: a path with no ".."
# still escapes through a symlinked directory component, and the destination tree
# comes from the feature branch. The rule is asymmetric:
#
#   source:      no component may be a symlink, INCLUDING the final one, which is
#                dereferenced on read.
#   destination: no PARENT component may be a symlink. A final symlink is fine
#                because it is skipped below as "already present", never followed.
_wt_manifest() {
  emulate -L zsh
  setopt local_options extended_glob
  local main="$1" dest="$2" line p comp
  local -a parts
  _WT_CARRY=()
  [[ -f "$main/.worktreeinclude" ]] || return 0

  # `|| [[ -n "$line" ]]` so a final line with no trailing newline still counts.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${${line##[[:space:]]##}%%[[:space:]]##}"
    [[ -z "$line" || "$line" == '#'* ]] && continue

    if [[ "$line" == /* || "$line" == '~'* ]]; then
      print -ru2 -- "wt: .worktreeinclude entry '$line' is not repo-relative — refusing."
      return 1
    fi
    parts=( ${(s:/:)line} )
    if (( ${parts[(I)..]} )); then
      print -ru2 -- "wt: .worktreeinclude entry '$line' contains '..' — refusing."
      return 1
    fi

    if [[ ! -e "$main/$line" && ! -L "$main/$line" ]]; then
      print -ru2 -- "wt: .worktreeinclude lists '$line', not found in $main — skipping."
      continue
    fi

    p="$main"
    for comp in $parts; do
      p="$p/$comp"
      if [[ -L "$p" ]]; then
        print -ru2 -- "wt: .worktreeinclude entry '$line' resolves through a symlink in $main — refusing."
        return 1
      fi
    done

    p="$dest"
    for comp in ${parts[1,-2]}; do
      p="$p/$comp"
      if [[ -L "$p" ]]; then
        print -ru2 -- "wt: .worktreeinclude entry '$line' resolves through a symlink in $dest — refusing."
        return 1
      fi
    done

    [[ -e "$dest/$line" || -L "$dest/$line" ]] && continue   # already present: done
    _WT_CARRY+=( "$line" )
  done < "$main/.worktreeinclude"
  return 0
}

# _wt_do_prepare <main> <dest> <branch> <slug> — copy missing manifest entries,
# then run the project setup hook. The UNLOCKED routine: `wt` calls it under the lock
# it already holds, and `wt-prepare` is the locked wrapper. It must not lock itself
# (per-process locks, see _wt_lock).
_wt_do_prepare() {
  emulate -L zsh
  local main="$1" dest="$2" branch="$3" slug="$4" qb="${(q-)branch}"

  # Validate the hook before copying, so a misconfigured repository changes nothing.
  _wt_hook_check "$main" >/dev/null 2>&1
  local hrc=$?
  if (( hrc == 1 )); then
    _wt_hook_check "$main"          # re-run for the message
    print -ru2 -- "    The worktree exists — fix the hook, then: wt-prepare $qb && wt $qb"
    return 1
  fi

  _wt_manifest "$main" "$dest" || {
    print -ru2 -- "    The worktree exists — fix .worktreeinclude, then: wt-prepare $qb && wt $qb"
    return 1
  }

  local entry
  for entry in $_WT_CARRY; do
    [[ -e "$dest/$entry" || -L "$dest/$entry" ]] && continue
    if ! { mkdir -p -- "$dest/${entry:h}" && cp -pR -- "$main/$entry" "$dest/$entry" }; then
      rm -rf -- "$dest/$entry"
      print -ru2 -- "wt: copying .worktreeinclude entry '$entry' into $dest failed."
      print -ru2 -- "    The worktree exists — fix the copy, then: wt-prepare $qb && wt $qb"
      return 1
    fi
  done

  if ! _wt_hook_run "$main" "$dest" "$branch" "$slug" setup; then
    print -ru2 -- "wt: .worktreehook setup failed for $dest."
    print -ru2 -- "    The worktree exists — fix it, then: wt-prepare $qb && wt $qb"
    return 1
  fi
  return 0
}

# wt-prepare <branch> — re-run preparation against an existing worktree.
#
# The recovery path for a partial copy or a failed setup hook; `wt` on an existing
# worktree reopens and skips preparation. It never touches a Herdr workspace, so it
# may run while the target is live.
wt-prepare() {
  emulate -L zsh
  local branch="$1"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt-prepare <branch>"; return 1; }
  local slug="${branch//\//-}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  [[ -d "$dest" ]] || { print -ru2 -- "wt-prepare: $dest does not exist."; return 1; }
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1
    _wt_do_prepare "$main" "$dest" "$branch" "$slug" || return 1
    print -r -- "✓ prepared $dest"
  } always {
    _wt_unlock
  }
}

# wt — spin up (or reopen) a git worktree for the current repo in its own Herdr
# workspace. Complements `dev`, which only *finds* existing checkouts; `wt` *creates*
# one first, as a sibling under the same org dir so `dev`'s repo glob picks it up. The
# worktree dir is named after the branch, with any "/" flattened to "-" so the path
# stays valid (curato + "feature/foo" → ~/Code/Netronix/curato-feature-foo).
#   wt test                worktree ../<repo>-test        on branch "test"
#   wt feature/foo         worktree ../<repo>-feature-foo on branch "feature/foo"
#   wt hotfix origin/main  branch "hotfix" from an explicit start point
# Run from anywhere inside the repo (or one of its worktrees).
#
# A new branch starts from the *caller's* HEAD, matching plain `git worktree add -b`.
# Pass a start point to override.
#
# Creation runs under the per-target lock (see _wt_lock) and pre-validates the hook,
# so a misconfigured repository leaves no worktree and no branch behind. Preparation
# is the shared, unlocked `_wt_do_prepare`. The caller's Herdr handoff runs OUTSIDE
# the lock and only on success, so a long-lived workspace never holds the lock and a
# failed setup never opens a half-built worktree.
_wt_create_or_prepare() {
  emulate -L zsh
  local branch="$1" start="${2-}"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt <branch> [start-point]"; return 1; }
  local slug="${branch//\//-}" qb="${(q-)branch}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  _wt_lock "$common" "$slug" || return 1
  {
    local created=1
    if [[ -d "$dest" ]]; then
      _wt_assert_worktree "$main" "$dest" "$branch" || return 1
      print -ru2 -- "wt: reopening $dest"; created=
    else
      # Pre-validate before creating anything; _wt_hook_run still re-checks.
      _wt_hook_check "$main" >/dev/null 2>&1
      (( $? == 1 )) && { _wt_hook_check "$main"; return 1 }

      if _wt_git -C "$main" show-ref --quiet --verify "refs/heads/$branch"; then
        [[ -z "$start" ]] || {
          print -ru2 -- "wt: branch $qb already exists — drop the start point."; return 1 }
        _wt_git worktree add --lock --reason "$(_wt_herdr_lock_reason)" "$dest" "$branch" || return 1
      else
        local base
        if [[ -n "$start" ]]; then
          base="$start"
        else
          base="$(_wt_git symbolic-ref --quiet --short HEAD 2>/dev/null)" \
            || base="detached@$(_wt_git rev-parse --short HEAD 2>/dev/null)"
        fi
        print -r -- "wt: branching $qb from $base"
        _wt_git worktree add --lock --reason "$(_wt_herdr_lock_reason)" "$dest" -b "$branch" ${start:+"$start"} || return 1
      fi
    fi

    [[ -n "$created" ]] && { _wt_do_prepare "$main" "$dest" "$branch" "$slug" || return 1 }
  } always {
    _wt_unlock
  }

  typeset -g _WT_DEST="$dest"
}

# The `wt` command itself: create or reopen through the locked lifecycle above, then
# open the checkout as a native Herdr worktree workspace.
wt() {
  [[ -n "${1:-}" ]] || { print -ru2 -- "usage: wt <branch> [start-point]"; return 1; }
  _wt_create_or_prepare "$@" || return 1
  dev "$_WT_DEST"
}

# wt-prompt — interactive surface for Herdr's worktree popup. Kept tiny: everything
# else stays in wt, so the TUI cannot grow a second lifecycle implementation.
wt-prompt() {
  emulate -L zsh
  local branch
  print -n -- "Branch: "
  IFS= read -r branch || branch=""
  if [[ -z "$branch" ]]; then
    print -ru2 -- "wt: cancelled (no branch entered)."
    return 1
  fi
  wt "$branch"
}

# _wt_assert_worktree <root> <dest> <branch> — succeed only if <dest> is a worktree
# registered to <root> and currently on <branch>, so `wt` (reopen) and `wt-rm` refuse
# husks and slug collisions. Paths are resolved before comparison: git reports real
# paths, and ~/Code may sit behind a symlink.
_wt_assert_worktree() {
  emulate -L zsh
  local root="$1" dest="$2" branch="$3"
  local -a recs paths; local p
  recs=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} )
  for p in ${${(M)recs:#worktree *}#worktree }; do paths+=( "${p:A}" ); done
  if (( ! ${paths[(Ie)${dest:A}]} )); then
    print -ru2 -- "wt: $dest is not a registered worktree of $root."
    print -ru2 -- "    Leftover directory? Remove it, or use a different branch name."
    return 1
  fi
  local have; have="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)"
  if [[ "$have" != "$branch" ]]; then
    print -ru2 -- "wt: $dest is on '${have:-a detached HEAD}', not '$branch'."
    print -ru2 -- "    Branch names differing only by '/' vs '-' share one directory."
    return 1
  fi
}

# _wt_herdr_read <is-default> <session> — load one running session's workspace and pane
# lists into _WT_HWS and _WT_HPANES. 0 loaded, 3 server not running, 1 unusable answer.
_wt_herdr_read() {
  emulate -L zsh
  local session="$2" kind out rc
  # Always --session, the default included: a bare call follows HERDR_SOCKET_PATH or
  # HERDR_SESSION, which can name another session than the one being read.
  local -a hargs=(--session "$session")
  for kind in workspace pane; do
    out="$(command herdr $hargs $kind list 2>&1)"; rc=$?
    if (( rc )) || ! print -r -- "$out" | jq -e . >/dev/null 2>&1; then
      print -ru2 -- "wt-rm: Herdr session '$session' returned an invalid $kind list — refusing."
      return 1
    fi
    print -r -- "$out" | jq -e 'type == "object" and .error.code? == "server_not_running"' \
      >/dev/null 2>&1 && return 3
    if ! print -r -- "$out" | jq -e --arg k "${kind}s" \
        'type == "object" and (.result[$k] | type == "array") and (has("error") | not)' \
        >/dev/null 2>&1; then
      print -ru2 -- "wt-rm: Herdr session '$session' returned an unexpected $kind list — refusing."
      return 1
    fi
    if [[ "$kind" == workspace ]]; then typeset -g _WT_HWS="$out"; else typeset -g _WT_HPANES="$out"; fi
  done
  return 0
}

_wt_herdr_label() {
  print -r -- "$_WT_HWS" | jq -r --arg w "$1" \
    '[.result.workspaces[] | select(.workspace_id == $w) | (.label // "")][0] // ""' 2>/dev/null
}

# _wt_herdr_classify <dest> — from the loaded session, _WT_OWN is every workspace whose
# provenance is exactly <dest>; _WT_FOREIGN describes every other pane or workspace in it.
# Pane cwd follows `cd`, so it never makes a workspace own.
_wt_herdr_classify() {
  emulate -L zsh
  local dest="$1" i
  local -a recs
  typeset -ga _WT_OWN _WT_FOREIGN
  _WT_OWN=() _WT_FOREIGN=()
  recs=( ${(0)"$(print -r -- "$_WT_HWS" | jq -j '
    .result.workspaces[]
    | select((.worktree.checkout_path? | type) == "string" and (.worktree.checkout_path | length) > 0)
    | (.workspace_id | if type == "string" and length > 0 then . else error("workspace without id") end),
      "\u0000", .worktree.checkout_path, "\u0000"')"} ) || return 1
  (( ${#recs} % 2 == 0 )) || return 1
  for (( i = 1; i <= ${#recs}; i += 2 )); do
    if [[ "${recs[i+1]:A}" == "$dest" ]]; then
      _WT_OWN+=( "${recs[i]}" )
    elif [[ "${recs[i+1]:A}" == "$dest"/* ]]; then
      _WT_FOREIGN+=( "workspace ${recs[i]} '$(_wt_herdr_label "${recs[i]}")' is for ${recs[i+1]}, inside the checkout" )
    fi
  done
  recs=( ${(0)"$(print -r -- "$_WT_HPANES" | jq -j --arg d "$dest" '
    .result.panes[]
    | select((.cwd | type) == "string" and (.cwd == $d or (.cwd | startswith($d + "/"))))
    | (.workspace_id | if type == "string" and length > 0 then . else error("pane without workspace id") end),
      "\u0000", (.pane_id // "?" | tostring), "\u0000", .cwd, "\u0000"')"} ) || return 1
  (( ${#recs} % 3 == 0 )) || return 1
  for (( i = 1; i <= ${#recs}; i += 3 )); do
    (( ${_WT_OWN[(Ie)${recs[i]}]} )) && continue
    _WT_FOREIGN+=( "pane ${recs[i+1]} of workspace ${recs[i]} '$(_wt_herdr_label "${recs[i]}")' is at ${recs[i+2]}" )
  done
  return 0
}

# A stopped session's session.json can restore panes into the checkout later. Herdr's
# versioned state is never rewritten here: detect a reference and require the session
# to be started so the public close API can remove it. Return 0 match, 1 no match or
# no state, 2 unreadable or unknown schema.
_wt_stopped_herdr_has_checkout() {
  emulate -L zsh
  local session="$1" session_dir="$2" dest="${3:A}" n
  # Own line: a `local` expands all its arguments before assigning any, so on the line
  # above `$session_dir` would be the caller's.
  local state="$session_dir/session.json"
  [[ -e "$state" ]] || return 1
  if [[ ! -r "$state" ]] || ! jq -e \
      'type == "object" and .version == 3 and (.workspaces | type == "array")' \
      "$state" >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: stopped Herdr session '$session' has unreadable or unknown persisted state — refusing."
    return 2
  fi
  n="$(jq -r --arg d "$dest" '
    [.workspaces[]
      | select([.. | objects | (.cwd?, .checkout_path?)
                | select(type == "string" and (. == $d or startswith($d + "/")))]
               | length > 0)]
    | length
  ' "$state")" || {
    print -ru2 -- "wt-rm: could not inspect stopped Herdr session '$session' — refusing."
    return 2
  }
  (( n > 0 )) && return 0
  return 1
}

# Close the checkout's own Herdr workspaces, after refusing if anything else is in it.
# Spec: docs/superpowers/specs/2026-10-01-herdr-wt-simplification-design.md §1.
_wt_stop_herdr_workspaces() {
  emulate -L zsh
  setopt local_options pipe_fail
  (( $+commands[herdr] )) || return 0
  (( $+commands[jq] )) || {
    print -ru2 -- "wt-rm: jq is unavailable, so Herdr workspace state cannot be verified — refusing."
    return 1
  }
  local dest="${1:A}" listing rc count i name is_default running session_dir sock caller="" default_name="" state id close_out f
  local -a tname tdefault trunning tdir hargs
  local -A own
  listing="$(command herdr session list --json 2>&1)"; rc=$?
  if (( rc )) || ! print -r -- "$listing" | jq -e \
      'type == "object" and (.sessions | type == "array") and
       all(.sessions[]; (.name | type == "string" and length > 0) and
                        (.default | type == "boolean") and
                        (.running | type == "boolean") and
                        (.session_dir | type == "string" and length > 0) and
                        ((.socket_path // "") | type == "string"))' \
      >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr returned an invalid session list — refusing."
    return 1
  fi
  count="$(print -r -- "$listing" | jq -r '.sessions | length')" || return 1
  for (( i = 0; i < count; i++ )); do
    name="$(print -r -- "$listing" | jq -er --argjson i "$i" '.sessions[$i].name')" || return 1
    is_default="$(print -r -- "$listing" | jq -r --argjson i "$i" '.sessions[$i].default | tostring')" || return 1
    running="$(print -r -- "$listing" | jq -r --argjson i "$i" '.sessions[$i].running | tostring')" || return 1
    session_dir="$(print -r -- "$listing" | jq -er --argjson i "$i" '.sessions[$i].session_dir')" || return 1
    sock="$(print -r -- "$listing" | jq -r --argjson i "$i" '.sessions[$i].socket_path // ""')" || return 1
    if [[ "$is_default" != true && "$name" != "${HERDR_SESSION:-}" ]]; then
      print -ru2 -- "wt-rm: Herdr session '$name' exists, and wt-rm handles only the default session — refusing."
      print -ru2 -- "    Stop and delete it (herdr session delete ${(q-)name}), then retry command wt-rm."
      return 1
    fi
    [[ "$is_default" == true ]] && default_name="$name"
    [[ -n "${HERDR_SOCKET_PATH:-}" && "$sock" == "$HERDR_SOCKET_PATH" ]] && caller="$name"
    tname+=( "$name" ); tdefault+=( "$is_default" ); trunning+=( "$running" ); tdir+=( "$session_dir" )
  done
  [[ -n "$caller" ]] || caller="$default_name"

  # Pass 1: every refusal is decided before anything closes.
  for (( i = 1; i <= ${#tname}; i++ )); do
    name="${tname[i]}"
    if [[ "${trunning[i]}" != true ]]; then
      _wt_stopped_herdr_has_checkout "$name" "${tdir[i]}" "$dest"; state=$?
      case "$state" in
        0)
          print -ru2 -- "wt-rm: stopped Herdr session '$name' still remembers $dest — refusing."
          if [[ "${tdefault[i]}" == true ]]; then
            print -ru2 -- "    Start it with: herdr    then retry command wt-rm."
          else
            print -ru2 -- "    Start it with: herdr session attach ${(q-)name}    then retry command wt-rm."
          fi
          return 1 ;;
        1) continue ;;
        *) return 1 ;;
      esac
    fi
    _wt_herdr_read "${tdefault[i]}" "$name"; state=$?
    if (( state == 3 )); then
      print -ru2 -- "wt-rm: Herdr session '$name' reported running but its API is unreachable — refusing."
      return 1
    fi
    (( state == 0 )) || return 1
    _wt_herdr_classify "$dest" || {
      print -ru2 -- "wt-rm: could not read Herdr workspace state in session '$name' — refusing."
      return 1
    }
    if (( ${#_WT_FOREIGN} )); then
      print -ru2 -- "wt-rm: other Herdr workspaces in session '$name' are using $dest — refusing."
      for f in $_WT_FOREIGN; do print -ru2 -- "    $f"; done
      print -ru2 -- "    Move them out of the checkout or close them, then retry command wt-rm."
      return 1
    fi
    if [[ "$name" == "$caller" && -n "${HERDR_WORKSPACE_ID:-}" ]] \
       && (( ${_WT_OWN[(Ie)$HERDR_WORKSPACE_ID]} )); then
      print -ru2 -- "wt-rm: this shell runs in Herdr workspace $HERDR_WORKSPACE_ID, which belongs to $dest — run wt-rm from another workspace."
      return 1
    fi
    own[$name]="${(j: :)_WT_OWN}"
  done

  # Pass 2: close the own workspaces, then confirm nothing is left in the checkout.
  for (( i = 1; i <= ${#tname}; i++ )); do
    [[ "${trunning[i]}" == true ]] || continue
    name="${tname[i]}"
    hargs=(--session "$name")
    for id in ${(s: :)own[$name]}; do
      close_out="$(command herdr $hargs workspace close "$id" 2>&1)"; rc=$?
      if (( rc )) \
        || { [[ -n "$close_out" ]] && ! print -r -- "$close_out" | jq -e . >/dev/null 2>&1; } \
        || { [[ -n "$close_out" ]] && print -r -- "$close_out" | jq -e \
               'type == "object" and has("error")' >/dev/null 2>&1; }; then
        print -ru2 -- "wt-rm: could not close Herdr workspace '$id' in session '$name' — refusing to remove $dest."
        return 1
      fi
    done
    _wt_herdr_read "${tdefault[i]}" "$name"; state=$?
    if (( state == 3 )); then
      print -ru2 -- "wt-rm: Herdr session '$name' became unreachable before workspace closure could be verified — refusing."
      return 1
    fi
    (( state == 0 )) || return 1
    _wt_herdr_classify "$dest" || return 1
    if (( ${#_WT_OWN} || ${#_WT_FOREIGN} )); then
      print -ru2 -- "wt-rm: Herdr session '$name' still has workspace(s) at $dest after close — refusing."
      return 1
    fi
  done
  return 0
}

# _wt_branch_content_merged — true when <branch> would add nothing to <base>.
#
# `git branch -d` asks an ancestry question, which a squash-merge (GitLab's default)
# answers no by construction. This asks instead whether merging would still change
# anything: `merge-tree --write-tree` merges in memory, and if the resulting tree is
# the base's own tree the branch contributes nothing.
#
# Do not compare the two tip trees (`git diff base branch`) instead: that holds only
# while the base's tip IS the squash commit, and stops working after the next
# unrelated merge.
#
# Both the local base and the remote's default branch count. Fails closed: no base,
# an unmergeable branch, or a git without --write-tree all keep the branch.
_wt_branch_content_merged() {
  emulate -L zsh
  local main="$1" branch="$2" base merged want mb
  local -a bases
  base="$(_wt_git -C "$main" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
    && bases+=("$base")
  base="$(_wt_git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" \
    && bases+=("$base")
  (( ${#bases} )) || return 1
  for base in $bases; do
    [[ -n "$base" && "$base" != "$branch" ]] || continue
    # Require a real diff against the merge-base: wt-rm never force-deletes a branch
    # carrying commits the base lacks, however empty they are.
    mb="$(_wt_git -C "$main" merge-base "$base" "$branch" 2>/dev/null)" || continue
    _wt_git -C "$main" diff --quiet "$mb" "$branch" 2>/dev/null && continue
    merged="$(_wt_git -C "$main" merge-tree --write-tree "$base" "$branch" 2>/dev/null)" || continue
    merged="${merged%%$'\n'*}"
    want="$(_wt_git -C "$main" rev-parse "$base^{tree}" 2>/dev/null)" || continue
    [[ -n "$merged" && "$merged" == "$want" ]] && return 0
  done
  return 1
}

# wt-rm <branch> — retire a worktree made by `wt`. Run from another checkout of the
# same repo, never from inside the one being removed.
#
# Each step is guarded right before it happens, and every check fails closed:
#   1. hook validation and check 1 (_wt_clean), before anything is disrupted
#   2. stop the checkout's Herdr workspaces: a live process holding the directory
#      open is how a husk is left behind, so this must come first
#   3. check 2, because shutdown can flush files (a live app writing on exit)
#   4. the .worktreehook teardown verb, idempotent so a retry re-runs it
#   5. check 3, tying non-ignored teardown output to its cause
#   6. check 4 (`wt-teardown scan`), last before Git deletes files: it reads the OS,
#      which Git and Herdr cannot see. After teardown because stopping project
#      services is what teardown is for. A heuristic, not a proof.
#
# Runs under the per-target lock, released in an `always` block. An interrupt is not
# covered by it; see the interruption note above _wt_hook_check for why no INT/TERM
# trap is installed.
wt-rm() {
  emulate -L zsh
  local branch="$1"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt-rm <branch>"; return 1; }
  local slug="${branch//\//-}" qb="${(q-)branch}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  [[ -d "$dest" ]] || { print -ru2 -- "wt-rm: $dest does not exist."; return 1; }
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1

    local here; here="$(_wt_git rev-parse --path-format=absolute --show-toplevel 2>/dev/null)"
    [[ "${here:A}" == "${dest:A}" ]] && {
      print -ru2 -- "wt-rm: you're inside $dest — run this from another checkout."; return 1 }

    # Check 1 — before anything is disrupted. `*`, not `2`, so that anything which
    # is not a definite 0 fails closed rather than reading as "clean".
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: $dest has uncommitted changes — commit, stash or discard them first."; return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean — refusing."
         _wt_git -C "$dest" status --porcelain >/dev/null; return 1 ;;
    esac

    # Hook configuration, still before anything is disrupted.
    _wt_hook_check "$main" >/dev/null 2>&1
    (( $? == 1 )) && { _wt_hook_check "$main"; return 1 }

    # Classify the Git lock before stopping anything. Only our exact reason
    # authorizes the double-force removal; any other lock is a preservation request.
    local git_lock_state herdr_owned=0 wanted_lock
    wanted_lock="$(_wt_herdr_lock_reason)"
    _wt_git_lock_state "$main" "$dest"; git_lock_state=$?
    case "$git_lock_state" in
      0)
        if [[ "$_WT_GIT_LOCK_REASON" == "$wanted_lock" ]]; then
          herdr_owned=1
        else
          print -ru2 -- "wt-rm: $dest is locked for another reason: ${_WT_GIT_LOCK_REASON:-<no reason>}"
          print -ru2 -- "    Unlock it yourself only if that owner no longer needs it."
          return 1
        fi ;;
      1) ;;
      *) return 1 ;;
    esac

    # Close the checkout's own Herdr workspaces; refuse first if anything else is in it (spec §1).
    _wt_stop_herdr_workspaces "$dest" || return 1

    # Check 2 — closing the workspaces can flush files into the checkout.
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: closing Herdr workspaces left changes in $dest — inspect it, then retry."; return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean after closing Herdr workspaces — refusing."; return 1 ;;
    esac

    if ! _wt_hook_run "$main" "$dest" "$branch" "$slug" teardown; then
      print -ru2 -- "wt-rm: .worktreehook teardown failed — $dest kept, Herdr workspaces closed."
      print -ru2 -- "    Fix it and retry: wt-rm $qb    (teardown is idempotent)"
      print -ru2 -- "    Or resume work with: wt-prepare $qb && wt $qb"
      return 1
    fi

    # Check 3 — ties non-ignored hook output to its cause, before Git's more
    # generic removal refusal appears one step later.
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: teardown left changes in $dest — removal aborted. Resources may already be reclaimed."
         print -ru2 -- "    Hook output must be git-ignored or written outside the worktree."
         return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean after teardown — refusing. Resources may already be reclaimed."
         return 1 ;;
    esac

    # Check 4 — the last witness before Git deletes anything, and the only one that
    # asks the OS. After teardown, so a repository that stops its own services is
    # not refused. What the snapshot cannot see: `_scan` in
    # dot_local/bin/executable_wt-teardown.
    local busy line
    busy="$(WT_WORKTREE="$dest" command wt-teardown scan)" || {
      print -ru2 -- "wt-rm: could not scan for processes still in $dest — refusing."
      return 1
    }
    if [[ -n "$busy" ]]; then
      print -ru2 -- "wt-rm: $dest is still in use by a running process — removal aborted. Resources may already be reclaimed."
      for line in ${(f)busy}; do print -ru2 -- "    $line"; done
      print -ru2 -- "    Herdr's workspaces for this checkout are closed already; these are still in it."
      print -ru2 -- "    Stop them — from .worktreehook teardown if the project starts them — then retry: wt-rm $qb"
      return 1
    fi

    # Removal is the third post-shutdown failure mode (hook-protocol design §9.3);
    # the message spells out the partial state and both recovery routes.
    local -a remove_args
    remove_args=(worktree remove "$dest")
    # The Git lock stays in force until removal: unlocking first opens an interrupt
    # window that leaves the checkout unprotected. The double-force form crosses it
    # and is used only for the exact lock reason above.
    (( herdr_owned )) && remove_args=(worktree remove --force --force "$dest")
    if ! _wt_git $remove_args; then
      print -ru2 -- "wt-rm: removing $dest failed — worktree kept, Herdr workspaces closed. Resources may already be reclaimed."
      print -ru2 -- "    Fix the obstruction and retry: wt-rm $qb    (teardown is idempotent)"
      print -ru2 -- "    Or resume work with: wt-prepare $qb && wt $qb"
      return 1
    fi
    print -r -- "✓ removed worktree $dest"

    # -d first, stderr suppressed: its refusal is not a verdict, since a squash-merged
    # branch fails -d. Only if the content test also declines is the work unmerged.
    if ! _wt_git -C "$main" branch -d "$branch" 2>/dev/null; then
      if _wt_branch_content_merged "$main" "$branch" \
         && _wt_git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
        print -r -- "✓ deleted branch $qb (squash-merged — its content is already in the base)"
      else
        print -ru2 -- "wt-rm: branch $qb kept (not fully merged) — inspect or merge it before deleting it explicitly."
      fi
    fi

    [[ -d "$dest" ]] \
      && print -ru2 -- "wt-rm: $dest still exists (files recreated during removal) — remove it manually."
    return 0
  } always {
    _wt_unlock
  }
}
