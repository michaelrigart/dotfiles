#!/usr/bin/env zsh
# Custom shell functions

# op-edit — edit a 1Password-backed dotfile, then re-apply the chezmoi targets
# that render from it.
#
# Some dotfiles keep their contents in a 1Password secure note instead of the
# public dotfiles repo, rendered by chezmoi with:
#     {{ onepasswordRead "op://<vault>/<item>/notes" }}
# e.g. ~/.ssh/config.
#
# Usage:
#   op-edit                  # list op-backed dotfiles (file ⇐ 1Password item)
#   op-edit ~/.ssh/config    # by file path — resolves the note automatically
#   op-edit "SSH config"     # or by 1Password item name
#
# The note is written to a private temp file (mode 600) while editing and passed
# to `op item edit` as an argument (briefly visible via `ps`).
op-edit() {
  emulate -L zsh
  local src; src="$(chezmoi source-path)" || return 1

  # No argument: list op-backed dotfiles as "file ⇐ item".
  if [[ -z "$1" ]]; then
    print -r -- "op-edit <file|item> — 1Password-backed dotfiles:"
    local f r i t
    while IFS= read -r f; do
      r="$(grep -m1 -oE 'op://[^"]+/notes' "$f" 2>/dev/null)" || continue
      [[ -n "$r" ]] || continue
      i="${${r#op://*/}%/notes}"
      t="$(chezmoi target-path "$f" 2>/dev/null)"
      printf '  %-30s ⇐  %s\n' "${t/#$HOME/~}" "$i"
    done < <(grep -rlE 'op://[^"]+/notes' "$src" --include='*.tmpl' 2>/dev/null) | sort -u
    return 0
  fi

  # Resolve the argument to an op reference: a managed file path, or an item name.
  local arg="${1/#\~/$HOME}" srcfile ref
  if srcfile="$(chezmoi source-path "$arg" 2>/dev/null)"; then
    ref="$(grep -m1 -oE 'op://[^"]+' "$srcfile" 2>/dev/null)"
    if [[ -z "$ref" ]]; then
      print -ru2 -- "op-edit: '$1' is chezmoi-managed but not backed by a 1Password note."
      return 1
    fi
  else
    ref="op://Private/$1/notes"
  fi

  # Parse op://<vault>/<item>/<field>.
  local rest="${ref#op://}"
  local vault="${rest%%/*}"; rest="${rest#*/}"
  local item="${rest%/*}" field="${rest##*/}"
  if [[ "$field" != "notes" ]]; then
    print -ru2 -- "op-edit: '$1' maps to op field '$field', not a note — edit it in 1Password directly."
    return 1
  fi

  # Pull current note content into a private temp file.
  local tmp; tmp="$(mktemp -t op-edit)" || return 1
  if ! op read "$ref" >| "$tmp" 2>/dev/null; then
    print -ru2 -- "op-edit: can't read $ref — does '$item' exist in '$vault'?"
    rm -f "$tmp"; return 1
  fi

  # Edit; bail out if nothing changed.
  local before; before="$(shasum "$tmp" | awk '{print $1}')"
  "${EDITOR:-nvim}" "$tmp"
  if [[ "$before" == "$(shasum "$tmp" | awk '{print $1}')" ]]; then
    print -r -- "op-edit: no changes to '$item'."
    rm -f "$tmp"; return 0
  fi

  # Push the edited content back to the note.
  if ! op item edit "$item" --vault "$vault" "notesPlain=$(<"$tmp")" >/dev/null; then
    print -ru2 -- "op-edit: failed to update '$item'."
    rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"

  # Re-apply every chezmoi target that renders from this note.
  local -a targets=()
  local f t
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    t="$(chezmoi target-path "$f" 2>/dev/null)"
    [[ -n "$t" ]] && targets+=("$t")
  done < <(grep -rlF "op://$vault/$item/" "$src" --include='*.tmpl' 2>/dev/null)

  if (( ${#targets} )); then
    chezmoi apply "${targets[@]}" \
      && print -r -- "✓ '$item' updated → applied: ${targets[*]/#$HOME/~}"
  else
    print -r -- "✓ '$item' updated."
  fi
}

# tsh — Teleport SSH with a portable TERM. Ghostty's ssh-env/ssh-terminfo cover
# the plain `ssh` binary, but not `tsh`, and edge nodes lack xterm-ghostty
# terminfo. Only the `ssh` subcommand needs the downgrade; other subcommands
# (tsh login, kube, db, …) run untouched.
tsh() {
  if [[ "$1" == "ssh" ]]; then
    TERM=xterm-256color command tsh "$@"
  else
    command tsh "$@"
  fi
}

# _wt_session_name <path> — the Zellij session name for a checkout. Single source of
# truth, shared by `dev`, `wt` and `wt-rm`.
#
# Name = the repo's path under ~/Code, lowercased, "/" → "--" (Zellij rejects "/").
# Always org-qualified, so a name is stable: cloning an unrelated repo that happens to
# share a basename never renames a session you already use. Repos outside ~/Code are
# invisible to `dev`'s glob, so they keep basename + a hash of the canonical root.
#
# The IPC socket path (ZELLIJ_SOCKET_DIR + contract dir + name) must stay under 104
# bytes; the short socket dir leaves ~68 for the name. Long branch names can approach
# that, so fold the tail into a hash rather than let zellij abort.
#
# NB: this is deliberately NOT invertible — both the hashed form above and any repo
# directory containing "--" collide with a naive "--" → "/" reversal. Callers resolving
# a session name back to a path must generate names and compare, never reverse.
_wt_session_name() {
  emulate -L zsh
  # Both sides resolved: git reports real paths, and ~/Code may sit behind a symlink.
  local repo="${1:A}" code="${HOME:A}/Code" name h
  if [[ "$repo" == "$code/"* ]]; then
    local slug="${repo#$code/}"; name="${(L)${slug//\//--}}"
  else
    h="$(shasum -a 256 <<<"$repo")"; name="${repo:t:l}--${h[1,8]}"
  fi
  if (( ${#name} > 60 )); then
    h="$(shasum -a 256 <<<"$repo")"; name="${name[1,50]}--${h[1,8]}"
  fi
  print -r -- "$name"
}

# dev — open (or return to) a project in its Zellij "dev" layout.
#   dev                   pick from all repos under ~/Code (fzf)
#   dev curato            by name: exact basename → case-insensitive substring → fzf
#   dev netronix--curato  by session name, exactly as `zellij list-sessions` prints it
#   dev Netronix/curato   path relative to ~/Code
#   dev .                 the git repo containing the current directory
dev() {
  emulate -L zsh
  setopt local_options null_glob extended_glob

  local code="$HOME/Code" repo name arg="$1"
  local -a repos=( "$code"/*/.git(N:h) "$code"/*/*/.git(N:h) )

  # 1) "." or an existing directory → the git repo that contains it
  if [[ "$arg" == "." || ( -n "$arg" && -d "$arg" ) ]]; then
    repo="$(_wt_git -C "${arg:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" \
      || { print -ru2 -- "dev: '${arg:-$PWD}' is not inside a git repo."; return 1; }

  # 2) exact path relative to ~/Code (e.g. Netronix/curato)
  elif [[ -n "$arg" && -e "$code/$arg/.git" ]]; then
    repo="$code/$arg"

  # 3) by name, or the fzf picker
  else
    local -a hits
    if [[ -z "$arg" ]]; then
      hits=( $repos )
    else
      # Session-name form first (netronix--curato), so what `zellij list-sessions`
      # prints can be pasted straight back. Generate each repo's name and compare:
      # the transformation isn't invertible, so the old "--" → "/" reversal silently
      # failed to find hashed names and any repo directory containing "--".
      local r
      for r in $repos; do
        if [[ "$(_wt_session_name "$r")" == "${(L)arg}" ]]; then hits=( "$r" ); break; fi
      done
      (( ${#hits} )) || hits=( ${(M)repos:#*/$arg} )      # exact basename
      (( ${#hits} )) || hits=( ${(M)repos:#(#i)*$arg*} )  # case-insensitive substring
    fi
    if (( ${#hits} == 1 )); then
      repo="${hits[1]}"
    else
      local -a pool; (( ${#hits} )) && pool=( $hits ) || pool=( $repos )
      local sel
      sel="$(print -rl -- ${pool[@]#$code/} | fzf --prompt='dev > ' ${arg:+--query=$arg})" || return 0
      [[ -n "$sel" ]] || return 0
      repo="$code/$sel"
    fi
  fi

  repo="${repo:A}"
  [[ -n "$repo" && -e "$repo/.git" ]] || { print -ru2 -- "dev: no git repo resolved."; return 1; }

  name="$(_wt_session_name "$repo")"

  # --- launch / attach / switch ---
  local exists=
  zellij list-sessions -s 2>/dev/null | grep -Fqx -- "$name" && exists=1
  if [[ -n "$ZELLIJ" ]]; then
    if [[ -n "$exists" ]]; then
      zellij action switch-session "$name"
    else
      # Create and switch in ONE step, letting the attaching client apply the layout.
      #
      # The previous shape — create detached with `attach --create-background`, graft
      # the layout on with `action new-tab --layout`, then switch — was written for
      # 0.44.x, where `switch-session` could not take a layout. On 0.45 that shape is
      # actively destructive. A detached session has no terminal dimensions, so every
      # pane of the grafted layout fails with "Not enough room for panes" while
      # `new-tab` still exits 0. The session is left holding tabs that were never laid
      # out, and the moment a client attaches the server dies:
      #
      #   Failed to switch to active tab at position 0 ... active tab 1 does not exist
      #   Panic occurred: thread: screen ... Program terminates
      #
      # which takes the whole terminal with it — precisely the wedge the old
      # workaround existed to prevent. Exit status is no guard here: every step
      # returned 0 while the layout silently failed.
      #
      # 0.45 added `switch-session --layout`, so the layout is only ever applied by a
      # client that already has real dimensions. Requires zellij >= 0.45.
      if ! zellij action switch-session --layout dev --cwd "$repo" "$name"; then
        print -ru2 -- "dev: failed to create and switch to session '$name'."
        print -ru2 -- "    From outside Zellij, start it with: dev $repo"
        return 1
      fi
      # No default-tab cleanup here, deliberately. A previous version ran
      #   go-to-tab-name "Tab #1" && close-tab
      # to drop a stray default tab left by the old detached-session approach.
      # `go-to-tab-name` exits 0 even when no tab by that name exists (zellij
      # 0.45.0), so the `&&` always fired and `close-tab` closed the FOCUSED tab —
      # `agents`, which dev.kdl pins with focus=true. `switch-session --layout`
      # creates exactly the layout's tabs, so there is nothing to clean up.
      # If a stray tab ever does appear, gate the close on `query-tab-names`
      # actually listing it; exit status cannot be the guard.
    fi
  elif [[ -n "$exists" ]]; then
    zellij attach "$name"
  else
    ( cd "$repo" && zellij --session "$name" --new-session-with-layout dev )
  fi
}

# hdev — open (or return to) a project in its Herdr workspace. The Herdr-side
# counterpart to `dev`, running beside it during the trial; `dev` is unchanged.
#   hdev                   pick from all repos under ~/Code (fzf)
#   hdev curato            by name: exact basename → case-insensitive substring → fzf
#   hdev Netronix/curato   path relative to ~/Code
#   hdev .                 the git repo containing the current directory
#
# Resolution only. Everything about Herdr lives in layout.sh, which is also what the
# `dev.layout.apply` plugin action calls — one topology definition, two entry points.
hdev() {
  emulate -L zsh
  setopt local_options null_glob extended_glob

  local code="$HOME/Code" repo arg="$1"
  local -a repos=( "$code"/*/.git(N:h) "$code"/*/*/.git(N:h) )

  if [[ "$arg" == "." || ( -n "$arg" && -d "$arg" ) ]]; then
    repo="$(_wt_git -C "${arg:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" \
      || { print -ru2 -- "hdev: '${arg:-$PWD}' is not inside a git repo."; return 1 }
  elif [[ -n "$arg" && -e "$code/$arg/.git" ]]; then
    repo="$code/$arg"
  else
    local -a hits
    if [[ -z "$arg" ]]; then
      hits=( $repos )
    else
      hits=( ${(M)repos:#*/$arg} )                       # exact basename
      (( ${#hits} )) || hits=( ${(M)repos:#(#i)*$arg*} ) # case-insensitive substring
    fi
    if (( ${#hits} == 1 )); then
      repo="${hits[1]}"
    else
      local -a pool; (( ${#hits} )) && pool=( $hits ) || pool=( $repos )
      local sel
      sel="$(print -rl -- ${pool[@]#$code/} | fzf --prompt='hdev > ' ${arg:+--query=$arg})" || return 0
      [[ -n "$sel" ]] || return 0
      repo="$code/$sel"
    fi
  fi

  repo="${repo:A}"
  [[ -n "$repo" && -e "$repo/.git" ]] || { print -ru2 -- "hdev: no git repo resolved."; return 1 }

  # A linked checkout must enter through layout.sh's worktree mode. That mode uses
  # Herdr's native `worktree open`, preserving worktree provenance and grouping under
  # the primary workspace; treating it as an ordinary path would create an unrelated
  # workspace that wt-rm could not identify safely.
  if [[ -f "$repo/.git" ]]; then
    local main
    main="$(cd "$repo" && _wt_primary)" || return 1
    _wt_prepare_for_herdr "$main" "$repo" || return 1
    "${HDEV_LAYOUT:-$HOME/.config/herdr/layout.sh}" --worktree "$main" "$repo"
    return $?
  fi

  "${HDEV_LAYOUT:-$HOME/.config/herdr/layout.sh}" "$repo"
}

# _wt_git — git with its routing environment cleared. Every Git call in the
# worktree lifecycle goes through this. An exported GIT_DIR or GIT_WORK_TREE
# silently redirects git to another checkout: `status` then reports a dirty
# worktree as clean *with exit status 0*, and `worktree list`, `ls-files`,
# `worktree remove` and `branch -d` all act on the wrong repository.
_wt_git() {
  emulate -L zsh
  command env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE \
    git "$@"
}

# _wt_primary — absolute path of the repository's primary worktree.
#
# Resolved from `worktree list`, never by path arithmetic on --git-common-dir:
# taking the parent of the common dir is correct for a standard repo
# (/…/repo/.git → /…/repo) but yields the *containing directory* for a bare one
# (/…/repo.git → /…/), which is not a worktree at all.
#
# -z is required: the line-based porcelain format gives no guarantee that a path
# is emitted raw, so a path needing quoting cannot be parsed unambiguously.
# Records are NUL-terminated; ${(0)} drops the empty separator records, leaving
# field 1 = "worktree <path>" and, for a bare repo, field 2 = "bare".
_wt_primary() {
  emulate -L zsh
  local -a f
  f=( ${(0)"$(_wt_git worktree list --porcelain -z 2>/dev/null)"} )
  [[ "${f[1]}" == 'worktree '* ]] || {
    print -ru2 -- "wt: not inside a git repository."; return 1 }
  [[ "${f[2]}" == bare ]] && {
    print -ru2 -- "wt: repository is bare — there is no primary worktree to run from."; return 1 }
  print -r -- "${f[1]#worktree }"
}

# _wt_clean <worktree> — 0 clean, 1 dirty, 2 state unknown.
#
# Three-state on purpose. A failed `git status` (corrupt index, unreadable
# worktree) produces empty output, so testing output alone reads the case where
# we know least as "no changes" — the most dangerous possible misreading.
#
# Each flag closes a way a dirty tree can report clean:
#   --untracked-files=normal   defeats status.showUntrackedFiles=no
#   --ignore-submodules=none   defeats diff.ignoreSubmodules / submodule.*.ignore
#   --porcelain=v1             pins the format against a default change
# and _wt_git clears GIT_WORK_TREE/GIT_DIR, which otherwise redirect the check to
# a different checkout entirely and return empty output with exit status 0.
#
# The assignment is deliberately split from `local`: `local x="$(cmd)"` reports
# the *builtin's* status, not the command substitution's, hiding the failure this
# helper exists to catch.
_wt_clean() {
  emulate -L zsh
  local wt="$1" out rc
  out="$(_wt_git -C "$wt" status --porcelain=v1 --untracked-files=normal \
                 --ignore-submodules=none 2>/dev/null)"; rc=$?
  (( rc )) && return 2
  [[ -n "$out" ]] && return 1
  return 0
}

# _wt_lock <common-dir> <slug> / _wt_unlock — serialize lifecycle commands per
# target worktree, so `wt-prepare` cannot copy into a directory `wt-rm` is
# removing.
#
# `zsystem flock` is an fcntl(2) record lock despite the name, and its semantics
# drive three requirements:
#
#   1. The lock file must already exist — zsystem opens it and will not create it.
#   2. Release must be explicit. These are *sourced functions*: returning does not
#      close the descriptor, so without an unlock the fd stays open in the
#      interactive shell. Because locks are per-process (requirement 3) that does
#      NOT block the same shell — it blocks every OTHER process's lifecycle
#      command on that target until this shell exits, while leaking one descriptor
#      per run. Kernel release on process death is the backstop for every path
#      an explicit unlock cannot reach — chiefly an interrupt, which unwinds the
#      command without running the `always` block (see the interruption note
#      below _wt_unlock).
#   3. Locks are per-process, not per-descriptor. A nested acquisition inside the
#      same shell SUCCEEDS, and unlocking any one descriptor drops the process's
#      lock on the file entirely — so a routine that took its own lock would
#      silently release its caller's. Only the outermost command locks; see the
#      command/routine split in wt-prepare.
#
# Consequently there is no intra-process exclusion. That is fine: one shell runs
# one lifecycle command at a time, and the case being defended is concurrent
# commands in different terminals.
_wt_lock() {
  emulate -L zsh
  zmodload zsh/system 2>/dev/null || {
    print -ru2 -- "wt: zsh/system unavailable — refusing to run unlocked."; return 1 }
  local dir="$1/wt-locks" lf="$1/wt-locks/$2.lock"
  mkdir -p "$dir" && : >> "$lf" || {
    print -ru2 -- "wt: cannot create lock file $lf."; return 1 }
  # _WT_LOCK_FD is intentionally global: the caller unlocks it.
  if ! zsystem flock -t 0 -f _WT_LOCK_FD "$lf" 2>/dev/null; then
    print -ru2 -- "wt: another lifecycle command is working on '$2' — retry when it finishes."
    return 1
  fi
}

_wt_unlock() {
  emulate -L zsh
  [[ -n "${_WT_LOCK_FD:-}" ]] || return 0
  zsystem flock -u $_WT_LOCK_FD 2>/dev/null
  unset _WT_LOCK_FD
  return 0
}

# A native Herdr worktree must not be removable through `herdr worktree remove`:
# that path knows nothing about .worktreehook teardown or the three cleanliness
# checks below. Git's own worktree lock is the enforcement boundary. Herdr 0.8.2
# exposes one `--force`; Git requires force twice to remove a locked worktree, so
# the native action remains safely blocked while `wt-rm` can recognize the lock it
# owns and remove only after the full lifecycle succeeds.
_wt_herdr_lock_reason() {
  print -r -- "hwt-managed; remove with command wt-rm"
}

# _wt_git_lock_state <root> <dest> — 0 locked (reason in _WT_GIT_LOCK_REASON),
# 1 registered but unlocked, 2 state unreadable/not registered.
#
# Parse the NUL porcelain form for the same reason _wt_primary does: paths may need
# quoting in the line format. A new `worktree ` token starts each record, so empty
# record separators do not need to survive zsh's ${(0)} expansion.
_wt_git_lock_state() {
  emulate -L zsh
  # Never name a local `path` in zsh: it is the tied array behind PATH, and
  # localising it empties command lookup for every external below.
  local root="$1" dest="${2:A}" rec wt_path in_target=0 seen=0
  local -a fields
  typeset -g _WT_GIT_LOCK_REASON=""
  # zsh scalars cannot carry NUL bytes: assigning porcelain -z to `raw` makes the
  # assignment itself fail with 127. Check the command once for a trustworthy status,
  # then feed a second call directly through ${(0)} so the NUL records are decoded
  # before they ever become a scalar.
  if ! _wt_git -C "$root" worktree list --porcelain -z >/dev/null 2>&1; then
    print -ru2 -- "wt: cannot read Git worktree lock state for $dest — refusing."
    return 2
  fi
  fields=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} )
  for rec in $fields; do
    if [[ "$rec" == 'worktree '* ]]; then
      wt_path="${rec#worktree }"
      in_target=0
      [[ "${wt_path:A}" == "$dest" ]] && { in_target=1; seen=1; }
    elif (( in_target )) && [[ "$rec" == locked || "$rec" == 'locked '* ]]; then
      _WT_GIT_LOCK_REASON="${rec#locked}"
      _WT_GIT_LOCK_REASON="${_WT_GIT_LOCK_REASON# }"
      return 0
    fi
  done
  if (( seen )); then
    return 1
  fi
  print -ru2 -- "wt: $dest is not a registered worktree of $root."
  return 2
}

_wt_ensure_herdr_lock() {
  emulate -L zsh
  local root="$1" dest="$2" wanted state
  wanted="$(_wt_herdr_lock_reason)"
  _wt_git_lock_state "$root" "$dest"; state=$?
  case "$state" in
    0)
      if [[ "$_WT_GIT_LOCK_REASON" != "$wanted" ]]; then
        print -ru2 -- "hdev: $dest is locked for another reason: ${_WT_GIT_LOCK_REASON:-<no reason>}"
        print -ru2 -- "    Herdr will not take ownership of a user-managed Git lock."
        return 1
      fi ;;
    1)
      _wt_git -C "$root" worktree lock --reason "$wanted" "$dest" || {
        print -ru2 -- "hdev: could not apply the lifecycle lock to $dest — refusing to open it in Herdr."
        return 1
      } ;;
    *) return 1 ;;
  esac
}

# Serialize Herdr adoption against wt-prepare/wt-rm, revalidate the checkout while
# holding that lifecycle lock, then apply the persistent Git ownership lock. The
# layout handoff stays outside the fcntl lock because it attaches a long-lived TUI.
_wt_prepare_for_herdr() {
  emulate -L zsh
  local main="$1" dest="$2" branch slug expected common
  branch="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)" || {
    print -ru2 -- "hdev: $dest is detached — wt-rm requires a branch-owned checkout."
    return 1
  }
  slug="${branch//\//-}"
  expected="${main:h}/${main:t}-${slug}"
  if [[ "${dest:A}" != "${expected:A}" ]]; then
    print -ru2 -- "hdev: $dest is not a wt-managed sibling checkout — refusing."
    print -ru2 -- "    Expected $expected for branch ${(q-)branch}; only that path is removable by command wt-rm."
    return 1
  fi
  common="$(_wt_git -C "$main" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || return 1
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1
    _wt_ensure_herdr_lock "$main" "$dest" || return 1
  } always {
    _wt_unlock
  }
}

# --- Interruption and the lock ---------------------------------------------
#
# There is deliberately NO `trap ... INT TERM` in any lifecycle command. An
# earlier revision installed `trap '_wt_unlock; return 130' INT TERM` in all
# three, to satisfy a spec §9.4 requirement — "the lock is released on INT and
# TERM" — that has since been withdrawn. The trap was removed because it is
# fail-open, and fail-open on the destructive path:
#
#   * `return` inside a trap handler unwinds only the INNERMOST function, not
#     the call stack, and zsh discards the handler's return status. The
#     interrupted helper therefore reports 0 to its caller, never 130.
#   * 0 is the permissive answer for every helper the lifecycle gates on:
#     _wt_clean 0 is "clean", _wt_hook_check 0 is "valid", _wt_assert_worktree 0
#     is "the right worktree on the right branch". An interrupted check reads as
#     permission to proceed. This is not theoretical: with the trap installed, a
#     real SIGINT during wt-rm's first cleanliness check made a DIRTY worktree
#     read as clean and ran `zellij delete-session --force` on it.
#
# Under SIGINT's default disposition the whole command unwinds instead, so no
# helper's status is ever fabricated. That is the property these commands need.
#
# The accepted cost, documented in spec §9.4: an interactive shell that survives
# an interruption may still hold the descriptor. Because fcntl locks are held per
# *process*, that does NOT block the shell holding it — retrying from that same
# shell works — it blocks other processes' lifecycle commands on the same target
# until that shell exits. Trading a rare, self-inflicted and self-recoverable
# lock retention for a destructive fail-open is the right way round.
#
# `always { _wt_unlock }` still covers every ordinary exit path: success,
# failure, and early return. Kernel release on process death covers a shell that
# the interrupt actually takes down.

# _wt_hook_check <main> — 0 valid, 1 invalid, 2 absent (not opted in).
#
# Both the index entry and the working-tree path must be checked. A tracked
# symlink satisfies "tracked" and "executable" (test -x follows it) while the code
# that actually runs lives outside the repository; conversely the index mode alone
# cannot see an unstaged local swap.
#
# Requiring 100755 *in the index* — not merely on disk — makes opt-in
# reproducible: a hook tracked as 100644 arrives non-executable in every clone.
# Selecting stage 0 rejects a conflicted hook, which has no stage-0 entry.
_wt_hook_check() {
  emulate -L zsh
  local main="$1" hook="$1/.worktreehook" raw mode rc
  # Status captured separately, for the same reason as _wt_clean: a failed
  # ls-files also leaves `raw` empty, and falling through on that emptiness
  # would misread an unreadable index by whatever happens to be on disk —
  # "not opted in" (2) when no working-tree file exists, or a bogus "untracked"
  # refusal (1, wrong message) when one does. Either way the true index state
  # is unknown, so it is refused unconditionally, before `raw` is inspected.
  raw="$(_wt_git -C "$main" ls-files --stage -- .worktreehook 2>/dev/null)"; rc=$?
  if (( rc )); then
    print -ru2 -- "wt: cannot read the index of $main to validate .worktreehook — refusing."
    return 1
  fi
  mode="$(print -r -- "$raw" | awk '$3 == 0 { print $1 }')"

  if [[ -z "$raw" ]]; then
    [[ -e "$hook" || -L "$hook" ]] || return 2          # not opted in
    print -ru2 -- "wt: $hook exists but is not tracked — commit it or remove it."
    return 1
  fi
  if [[ -z "$mode" ]]; then
    print -ru2 -- "wt: .worktreehook has no stage-0 index entry (unresolved conflict) — resolve it first."
    return 1
  fi
  if [[ "$mode" != 100755 ]]; then
    print -ru2 -- "wt: .worktreehook is indexed as $mode, not 100755."
    [[ "$mode" == 100644 ]] && \
      print -ru2 -- "    Fix with: git add --chmod=+x .worktreehook"
    return 1
  fi
  if [[ -L "$hook" ]]; then
    print -ru2 -- "wt: .worktreehook is a symlink in the working tree — refusing."
    return 1
  fi
  [[ -f "$hook" ]] || { print -ru2 -- "wt: .worktreehook is not a regular file."; return 1 }
  [[ -x "$hook" ]] || { print -ru2 -- "wt: .worktreehook is not executable."; return 1 }
  return 0
}

# _wt_hook_run <main> <worktree> <branch> <slug> <verb> — run the project hook.
#
# Validation happens here, immediately before execution, not only at the earlier
# pre-flight. Validation checks a pathname while execution happens later, so the
# early check in `wt` is a usability guard that avoids creating a worktree for a
# misconfigured repository — it does not substitute for this one. Concurrent
# mutation of the primary hook during a command remains unsupported (see the spec,
# §5.1 "Validation is point-in-time").
#
# Executed as a process so its shebang picks the interpreter, in a subshell so cwd
# and WT_* never leak back into the caller.
_wt_hook_run() {
  emulate -L zsh
  local main="$1" wt="$2" branch="$3" slug="$4" verb="$5"
  _wt_hook_check "$main"
  case $? in
    2) return 0 ;;   # repository has not opted in
    1) return 1 ;;
  esac
  ( cd "$wt" \
    && WT_MAIN="$main" WT_WORKTREE="$wt" WT_BRANCH="$branch" WT_SLUG="$slug" \
       "$main/.worktreehook" "$verb" )
  local hrc=$?
  (( hrc == 0 )) && return 0
  # Normalized to 1: the documented interface is 0/1, and callers branch on
  # success or failure only. The hook's own status is surfaced in the message
  # rather than returned, so `exit 130` and `exit 3` are handled identically.
  print -ru2 -- "wt: .worktreehook $verb exited $hrc."
  return 1
}

# _wt_manifest <main> <dest> — validate .worktreeinclude and fill _WT_CARRY with
# the entries whose destination is still missing.
#
# Filtering is required for correctness, not tidiness: wtcp refuses existing
# destinations and returns NONZERO while still copying the missing ones, so
# passing the whole manifest on a retry fails every second run by construction.
#
# Containment is checked lexically *and* through the filesystem. A path with no
# ".." still escapes if a directory component is a symlink — the target worktree's
# tree comes from the feature branch, so a branch committing `config` as a symlink
# redirects `config/master.key` on write. The rule is asymmetric:
#
#   source:      no component may be a symlink, INCLUDING the final one. A final
#                source symlink is dereferenced on read, so pointing it at an
#                external directory copies that directory's contents in.
#   destination: no PARENT component may be a symlink. An existing final symlink
#                is fine precisely because it is filtered out below as "already
#                present" — skipped, never followed, never written through.
_wt_manifest() {
  emulate -L zsh
  setopt local_options extended_glob
  local main="$1" dest="$2" line p comp
  local -a parts
  _WT_CARRY=()
  [[ -f "$main/.worktreeinclude" ]] || return 0

  # `|| [[ -n "$line" ]]` so a final line with no trailing newline still counts.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${${line##[[:space:]]##}%%[[:space:]]##}"
    [[ -z "$line" || "$line" == '#'* ]] && continue

    if [[ "$line" == /* || "$line" == '~'* ]]; then
      print -ru2 -- "wt: .worktreeinclude entry '$line' is not repo-relative — refusing."
      return 1
    fi
    parts=( ${(s:/:)line} )
    if (( ${parts[(I)..]} )); then
      print -ru2 -- "wt: .worktreeinclude entry '$line' contains '..' — refusing."
      return 1
    fi

    if [[ ! -e "$main/$line" && ! -L "$main/$line" ]]; then
      print -ru2 -- "wt: .worktreeinclude lists '$line', not found in $main — skipping."
      continue
    fi

    p="$main"
    for comp in $parts; do
      p="$p/$comp"
      if [[ -L "$p" ]]; then
        print -ru2 -- "wt: .worktreeinclude entry '$line' resolves through a symlink in $main — refusing."
        return 1
      fi
    done

    p="$dest"
    for comp in ${parts[1,-2]}; do
      p="$p/$comp"
      if [[ -L "$p" ]]; then
        print -ru2 -- "wt: .worktreeinclude entry '$line' resolves through a symlink in $dest — refusing."
        return 1
      fi
    done

    [[ -e "$dest/$line" || -L "$dest/$line" ]] && continue   # already present: done
    _WT_CARRY+=( "$line" )
  done < "$main/.worktreeinclude"
  return 0
}

# _wt_do_prepare <main> <dest> <branch> <slug> — copy missing manifest entries,
# then run the project setup hook. The UNLOCKED routine: `wt` calls it under the
# lock it already holds, and `wt-prepare` is the thin locked wrapper. It must not
# lock itself — fcntl locks are per-process, so a nested acquire/release here
# would silently drop the caller's lock (see _wt_lock).
_wt_do_prepare() {
  emulate -L zsh
  local main="$1" dest="$2" branch="$3" slug="$4" qb="${(q-)branch}"

  # Validate the hook before copying, so a misconfigured repository changes
  # nothing. This mirrors wt-rm, which validates before disrupting the session.
  _wt_hook_check "$main" >/dev/null 2>&1
  local hrc=$?
  if (( hrc == 1 )); then
    _wt_hook_check "$main"          # re-run for the message
    print -ru2 -- "    The worktree exists — fix the hook, then: wt-prepare $qb && wt $qb"
    return 1
  fi

  _wt_manifest "$main" "$dest" || {
    print -ru2 -- "    The worktree exists — fix .worktreeinclude, then: wt-prepare $qb && wt $qb"
    return 1
  }

  if (( ${#_WT_CARRY} )); then
    if (( ! $+commands[wtcp] )); then
      print -ru2 -- "wt: files need copying but wtcp is missing (brew install satococoa/tap/wtcp)."
      print -ru2 -- "    The worktree exists — install wtcp, then: wt-prepare $qb && wt $qb"
      return 1
    fi
    # `--` is mandatory: manifest entries are arbitrary strings, and one named
    # "-h" is otherwise parsed as an option and prints usage instead of copying.
    if ! ( cd "$dest" && wtcp --from "$main" -- "${_WT_CARRY[@]}" ); then
      print -ru2 -- "wt: copying .worktreeinclude files into $dest failed."
      print -ru2 -- "    The worktree exists — fix the copy, then: wt-prepare $qb && wt $qb"
      return 1
    fi
  fi

  if ! _wt_hook_run "$main" "$dest" "$branch" "$slug" setup; then
    print -ru2 -- "wt: .worktreehook setup failed for $dest."
    print -ru2 -- "    The worktree exists — fix it, then: wt-prepare $qb && wt $qb"
    return 1
  fi
  return 0
}

# wt-prepare <branch> — re-run preparation against an existing worktree.
#
# The named recovery path for a partial copy or a failed setup hook. Re-running
# `wt` cannot do this: on an existing worktree `wt` takes the reopen path, which
# deliberately skips preparation.
#
# It never creates, stops, attaches or switches a Zellij session, so it may run
# while the target session and application are live. Project hooks must tolerate
# that or document their own restriction.
wt-prepare() {
  emulate -L zsh
  local branch="$1"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt-prepare <branch>"; return 1; }
  local slug="${branch//\//-}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  [[ -d "$dest" ]] || { print -ru2 -- "wt-prepare: $dest does not exist."; return 1; }
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1
    _wt_do_prepare "$main" "$dest" "$branch" "$slug" || return 1
    print -r -- "✓ prepared $dest"
  } always {
    _wt_unlock
  }
}

# wt — spin up (or reopen) a git worktree for the current repo in its own Zellij
# "dev" session. Complements `dev`, which only *finds* existing checkouts; `wt`
# *creates* one first, as a sibling under the same org dir so `dev`'s repo glob and
# session-slug naming pick it up. The worktree dir and session are named after the
# branch, with any "/" flattened to "-" so the paths stay valid (curato +
# "feature/foo" → ~/Code/Netronix/curato-feature-foo, session
# netronix--curato-feature-foo).
#   wt test                worktree ../<repo>-test        on branch "test"
#   wt feature/foo         worktree ../<repo>-feature-foo on branch "feature/foo"
#   wt hotfix origin/main  branch "hotfix" from an explicit start point
# Run from anywhere inside the repo (or one of its worktrees).
#
# A new branch starts from the *caller's* HEAD, matching plain `git worktree add -b`:
# branch from where you are, and keep working offline. Pass a start point to override.
#
# Creation runs under the per-target lock (see _wt_lock) and pre-validates the
# project hook before touching anything: a misconfigured repository leaves no
# worktree and no branch behind. Once the worktree exists (fresh or an existing
# branch with none yet), preparation — manifest copy, then the setup hook — is
# delegated to the shared, unlocked `_wt_do_prepare` (see wt-prepare). The caller's
# Zellij/Herdr handoff runs OUTSIDE the lock and only on success, so a long-lived
# session never holds the lock and a failed setup never opens a half-built worktree.
_wt_create_or_prepare() {
  emulate -L zsh
  local branch="$1" start="${2-}"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt <branch> [start-point]"; return 1; }
  local slug="${branch//\//-}" qb="${(q-)branch}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  _wt_lock "$common" "$slug" || return 1
  {
    local created=1
    if [[ -d "$dest" ]]; then
      _wt_assert_worktree "$main" "$dest" "$branch" || return 1
      print -ru2 -- "wt: reopening $dest"; created=
    else
      # Pre-validate before creating anything: a misconfigured repository should
      # leave no worktree and no branch behind. This does NOT replace the check
      # inside _wt_hook_run immediately before execution.
      _wt_hook_check "$main" >/dev/null 2>&1
      (( $? == 1 )) && { _wt_hook_check "$main"; return 1 }

      if _wt_git -C "$main" show-ref --quiet --verify "refs/heads/$branch"; then
        [[ -z "$start" ]] || {
          print -ru2 -- "wt: branch $qb already exists — drop the start point."; return 1 }
        _wt_git worktree add "$dest" "$branch" || return 1
      else
        local base
        if [[ -n "$start" ]]; then
          base="$start"
        else
          base="$(_wt_git symbolic-ref --quiet --short HEAD 2>/dev/null)" \
            || base="detached@$(_wt_git rev-parse --short HEAD 2>/dev/null)"
        fi
        print -r -- "wt: branching $qb from $base"
        _wt_git worktree add "$dest" -b "$branch" ${start:+"$start"} || return 1
      fi
    fi

    [[ -n "$created" ]] && { _wt_do_prepare "$main" "$dest" "$branch" "$slug" || return 1 }
  } always {
    _wt_unlock
  }

  typeset -g _WT_DEST="$dest"
}

wt() {
  _wt_create_or_prepare "$@" || return 1
  dev "$_WT_DEST"
}

# hwt — create or reopen the same safe sibling worktree as `wt`, then open it as a
# native Herdr worktree workspace. Herdr supplies grouping/provenance and the agent
# dashboard; Git creation, .worktreeinclude and .worktreehook stay on the proven
# lifecycle above.
hwt() {
  [[ -n "${1:-}" ]] || { print -ru2 -- "usage: hwt <branch> [start-point]"; return 1; }
  _wt_create_or_prepare "$@" || return 1
  hdev "$_WT_DEST"
}

# hwt-prompt — interactive surface for Herdr's worktree popup. Keep the prompt tiny:
# all creation, preparation, locking and native Herdr adoption remain in hwt, so the
# TUI cannot grow a second lifecycle implementation.
hwt-prompt() {
  emulate -L zsh
  local branch
  print -n -- "Branch: "
  IFS= read -r branch || branch=""
  if [[ -z "$branch" ]]; then
    print -ru2 -- "hwt: cancelled (no branch entered)."
    return 1
  fi
  hwt "$branch"
}

# _wt_assert_worktree <root> <dest> <branch> — succeed only if <dest> is a worktree
# registered to <root> and currently on <branch>. Shared by `wt` (reopen) and `wt-rm`
# (removal): both must refuse husks and slug collisions rather than act on the wrong
# directory. Paths are resolved before comparison — git reports real paths, and ~/Code
# may sit behind a symlink.
_wt_assert_worktree() {
  emulate -L zsh
  local root="$1" dest="$2" branch="$3"
  local -a recs paths; local p
  recs=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} )
  for p in ${${(M)recs:#worktree *}#worktree }; do paths+=( "${p:A}" ); done
  if (( ! ${paths[(Ie)${dest:A}]} )); then
    print -ru2 -- "wt: $dest is not a registered worktree of $root."
    print -ru2 -- "    Leftover directory? Remove it, or use a different branch name."
    return 1
  fi
  local have; have="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)"
  if [[ "$have" != "$branch" ]]; then
    print -ru2 -- "wt: $dest is on '${have:-a detached HEAD}', not '$branch'."
    print -ru2 -- "    Branch names differing only by '/' vs '-' share one directory."
    return 1
  fi
}

# Print workspace ids in one running Herdr session whose native checkout or pane cwd
# points at <dest>. Return 3 when that server stopped between session discovery and
# the query; callers then inspect persisted state instead. Every other API/schema
# failure is unsafe uncertainty and returns 1.
_wt_herdr_runtime_matches() {
  emulate -L zsh
  setopt local_options pipe_fail
  local is_default="$1" session="$2" dest="${3:A}" workspaces panes rc ids1 ids2
  local -a hargs ids
  [[ "$is_default" == true ]] || hargs=(--session "$session")

  workspaces="$(command herdr $hargs workspace list 2>&1)"; rc=$?
  if (( rc )) || ! print -r -- "$workspaces" | jq -e . >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr session '$session' returned an invalid workspace list — refusing."
    return 1
  fi
  if print -r -- "$workspaces" | jq -e \
      'type == "object" and .error.code? == "server_not_running"' >/dev/null 2>&1; then
    return 3
  fi
  if ! print -r -- "$workspaces" | jq -e \
      'type == "object" and (.result.workspaces | type == "array") and (has("error") | not)' \
      >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr session '$session' returned an unexpected workspace list — refusing."
    return 1
  fi

  panes="$(command herdr $hargs pane list 2>&1)"; rc=$?
  if (( rc )) || ! print -r -- "$panes" | jq -e . >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr session '$session' returned an invalid pane list — refusing."
    return 1
  fi
  if print -r -- "$panes" | jq -e \
      'type == "object" and .error.code? == "server_not_running"' >/dev/null 2>&1; then
    return 3
  fi
  if ! print -r -- "$panes" | jq -e \
      'type == "object" and (.result.panes | type == "array") and (has("error") | not)' \
      >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr session '$session' returned an unexpected pane list — refusing."
    return 1
  fi

  ids1="$(print -r -- "$workspaces" | jq -r --arg d "$dest" '
    .result.workspaces[]
    | select((.worktree.checkout_path? | type == "string") and
             (.worktree.checkout_path == $d or (.worktree.checkout_path | startswith($d + "/"))))
    | if (.workspace_id | type == "string" and length > 0)
      then .workspace_id else error("matching workspace has no string id") end
  ')" || {
    print -ru2 -- "wt-rm: could not read Herdr workspace provenance in session '$session' — refusing."
    return 1
  }
  ids2="$(print -r -- "$panes" | jq -r --arg d "$dest" '
    .result.panes[]
    | select((.cwd | type == "string") and (.cwd == $d or (.cwd | startswith($d + "/"))))
    | if (.workspace_id | type == "string" and length > 0)
      then .workspace_id else error("matching pane has no string workspace id") end
  ')" || {
    print -ru2 -- "wt-rm: could not read Herdr pane ownership in session '$session' — refusing."
    return 1
  }
  ids=( ${(f)ids1} ${(f)ids2} )
  ids=( ${ids:#} )
  (( ${#ids} )) && print -rl -- ${(u)ids}
  return 0
}

# A stopped Herdr session has no live process, but its session.json can restore panes
# into the checkout later. Do not rewrite Herdr's versioned state behind its back;
# detect a reference and require the session to be started so the public close API can
# remove it. Return 0 match, 1 no match/no state, 2 unreadable or unknown schema.
_wt_stopped_herdr_has_checkout() {
  emulate -L zsh
  local session="$1" session_dir="$2" dest="${3:A}" state="$session_dir/session.json" n
  [[ -e "$state" ]] || return 1
  if [[ ! -r "$state" ]] || ! jq -e \
      'type == "object" and .version == 3 and (.workspaces | type == "array")' \
      "$state" >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: stopped Herdr session '$session' has unreadable or unknown persisted state — refusing."
    return 2
  fi
  n="$(jq -r --arg d "$dest" '
    [.workspaces[]
      | select([.. | objects | (.cwd?, .checkout_path?)
                | select(type == "string" and (. == $d or startswith($d + "/")))]
               | length > 0)]
    | length
  ' "$state")" || {
    print -ru2 -- "wt-rm: could not inspect stopped Herdr session '$session' — refusing."
    return 2
  }
  (( n > 0 )) && return 0
  return 1
}

# Close every matching workspace across every running Herdr session, and refuse if a
# stopped session still remembers the checkout. Session discovery is global rather
# than default-only: a named Herdr session can hold the same cwd just as surely as the
# default server can.
_wt_stop_herdr_workspaces() {
  emulate -L zsh
  setopt local_options pipe_fail
  (( $+commands[herdr] )) || return 0
  (( $+commands[jq] )) || {
    print -ru2 -- "wt-rm: jq is unavailable, so Herdr workspace state cannot be verified — refusing."
    return 1
  }
  local dest="${1:A}" listing rc count i name is_default running session_dir matches state id remaining close_out
  local -a ids hargs
  listing="$(command herdr session list --json 2>&1)"; rc=$?
  if (( rc )) || ! print -r -- "$listing" | jq -e \
      'type == "object" and (.sessions | type == "array") and
       all(.sessions[]; (.name | type == "string" and length > 0) and
                        (.default | type == "boolean") and
                        (.running | type == "boolean") and
                        (.session_dir | type == "string" and length > 0))' \
      >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr returned an invalid session list — refusing."
    return 1
  fi
  count="$(print -r -- "$listing" | jq -r '.sessions | length')" || return 1
  for (( i = 0; i < count; i++ )); do
    name="$(print -r -- "$listing" | jq -er --argjson i "$i" '.sessions[$i].name')" || return 1
    is_default="$(print -r -- "$listing" | jq -er --argjson i "$i" \
      '.sessions[$i].default | if type == "boolean" then tostring else error("not boolean") end')" \
      || return 1
    running="$(print -r -- "$listing" | jq -er --argjson i "$i" \
      '.sessions[$i].running | if type == "boolean" then tostring else error("not boolean") end')" \
      || return 1
    session_dir="$(print -r -- "$listing" | jq -er --argjson i "$i" '.sessions[$i].session_dir')" \
      || return 1

    if [[ "$running" != true ]]; then
      _wt_stopped_herdr_has_checkout "$name" "$session_dir" "$dest"; state=$?
      case "$state" in
        0)
          print -ru2 -- "wt-rm: stopped Herdr session '$name' still remembers $dest — refusing."
          if [[ "$is_default" == true ]]; then
            print -ru2 -- "    Start it with: herdr    then retry command wt-rm."
          else
            print -ru2 -- "    Start it with: herdr session attach ${(q-)name}    then retry command wt-rm."
          fi
          return 1 ;;
        1) continue ;;
        *) return 1 ;;
      esac
    fi

    matches="$(_wt_herdr_runtime_matches "$is_default" "$name" "$dest")"; state=$?
    if (( state == 3 )); then
      # `session list` just called this server running. An API-level
      # server_not_running response may instead mean the process cannot reach the
      # socket (the exact Zellij sandbox failure this lifecycle already guards).
      # Persisted state cannot prove that no live process exists, so fail closed.
      print -ru2 -- "wt-rm: Herdr session '$name' reported running but its API is unreachable — refusing."
      return 1
    fi
    (( state == 0 )) || return 1
    ids=( ${(f)matches} )
    ids=( ${ids:#} )
    [[ "$is_default" == true ]] && hargs=() || hargs=(--session "$name")
    for id in $ids; do
      close_out="$(command herdr $hargs workspace close "$id" 2>&1)"; rc=$?
      if (( rc )) \
        || { [[ -n "$close_out" ]] && ! print -r -- "$close_out" | jq -e . >/dev/null 2>&1; } \
        || { [[ -n "$close_out" ]] && print -r -- "$close_out" | jq -e \
               'type == "object" and has("error")' >/dev/null 2>&1; }; then
        print -ru2 -- "wt-rm: could not close Herdr workspace '$id' in session '$name' — refusing to remove $dest."
        return 1
      fi
    done

    # A zero exit from close is necessary but not sufficient evidence that no pane
    # still holds the cwd. Re-read the runtime state before allowing teardown.
    remaining="$(_wt_herdr_runtime_matches "$is_default" "$name" "$dest")"; state=$?
    if (( state == 3 )); then
      print -ru2 -- "wt-rm: Herdr session '$name' became unreachable before workspace closure could be verified — refusing."
      return 1
    fi
    (( state == 0 )) || return 1
    if [[ -n "$remaining" ]]; then
      print -ru2 -- "wt-rm: Herdr session '$name' still has workspace(s) at $dest after close — refusing."
      return 1
    fi
  done
  return 0
}

# wt-rm — retire a worktree made by `wt`: validate the project hook, run three
# cleanliness checks around a Zellij session shutdown and the teardown hook, remove
# the worktree, then delete the branch.
#   wt-rm <branch>
# Run from another checkout of the same repo, never from inside the one being removed.
#
# Runs under the per-target lock (see _wt_lock), released in an `always` block so
# every return path — including a mid-sequence abort — unlocks. An interruption
# is not an exit path this block covers: SIGINT unwinds the command outright and
# the kernel releases the lock with the process. See the interruption note under
# _wt_unlock for why no INT/TERM trap is installed.
#
# Ordering follows the sequence of things that can go wrong, each guarded right before
# it happens rather than once up front:
#
#   1. Hook validation, before anything is disrupted. A misconfigured repository must
#      never cost you the session or the worktree just for running `wt-rm`.
#   2. Check 1 (_wt_clean), before anything is disrupted. Catches pre-existing
#      uncommitted work — the case `git worktree remove` would refuse anyway, but by
#      then the session would already be gone.
#   3. Stop the Zellij session. An absent session counts as successful shutdown — the
#      normal state on a retry — but a session that exists and cannot be stopped
#      aborts unconditionally: a live process holding the directory open is exactly
#      how an empty tmp/ husk is left behind, so stopping first is an invariant here,
#      not a courtesy.
#   4. Check 2 (_wt_clean), after shutdown, before teardown. Session shutdown can
#      itself flush files to disk — a live app writing on exit is exactly how the
#      observed Bootsnap husks arose — so this check exists specifically to catch
#      dirt introduced BY stopping the session, distinct from check 1's pre-existing
#      dirt.
#   5. Run the .worktreehook teardown verb. Idempotent by contract, which matters
#      because a failure here preserves the worktree with its session already
#      stopped — retrying `wt-rm` re-runs teardown from that state.
#   6. Check 3 (_wt_clean), after teardown, before removal. Ties any non-ignored
#      teardown output to its cause before Git's more generic removal refusal would
#      otherwise appear a step later with a less specific message.
#
# All three checks fail closed on _wt_clean's unknown state (2), same as every other
# consumer of that helper.
wt-rm() {
  emulate -L zsh
  local branch="$1"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt-rm <branch>"; return 1; }
  local slug="${branch//\//-}" qb="${(q-)branch}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  [[ -d "$dest" ]] || { print -ru2 -- "wt-rm: $dest does not exist."; return 1; }
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1

    local here; here="$(_wt_git rev-parse --path-format=absolute --show-toplevel 2>/dev/null)"
    [[ "${here:A}" == "${dest:A}" ]] && {
      print -ru2 -- "wt-rm: you're inside $dest — run this from another checkout."; return 1 }

    # Check 1 — before anything is disrupted.
    #
    # `*`, not `2`: 2 is the only unknown status _wt_clean can currently produce,
    # so this arm is unreachable defensive code, kept so that anything which is
    # not a definite 0 fails closed rather than falling through as "clean".
    #
    # It is NOT protection against an interrupt-produced status. That premise was
    # wrong: an interrupt unwinds the whole command rather than handing this
    # `case` a status at all (see the interruption note under _wt_unlock).
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: $dest has uncommitted changes — commit, stash or discard them first."; return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean — refusing."
         _wt_git -C "$dest" status --porcelain >/dev/null; return 1 ;;
    esac

    # Hook configuration, still before anything is disrupted.
    _wt_hook_check "$main" >/dev/null 2>&1
    (( $? == 1 )) && { _wt_hook_check "$main"; return 1 }

    # A Git lock may belong to this Herdr lifecycle or to the user/another tool.
    # Classify it before stopping anything. Only our exact reason authorizes the
    # two-force removal Git requires for a locked worktree; every other lock is an
    # explicit preservation request and must remain untouched.
    local git_lock_state herdr_owned=0 wanted_lock
    wanted_lock="$(_wt_herdr_lock_reason)"
    _wt_git_lock_state "$main" "$dest"; git_lock_state=$?
    case "$git_lock_state" in
      0)
        if [[ "$_WT_GIT_LOCK_REASON" == "$wanted_lock" ]]; then
          herdr_owned=1
        else
          print -ru2 -- "wt-rm: $dest is locked for another reason: ${_WT_GIT_LOCK_REASON:-<no reason>}"
          print -ru2 -- "    Unlock it yourself only if that owner no longer needs it."
          return 1
        fi ;;
      1) ;;
      *) return 1 ;;
    esac

    # Stop every Herdr workspace first. This scans named sessions as well as the
    # default one and refuses stopped persisted state; otherwise a later restore can
    # restart panes into a checkout that no longer exists.
    _wt_stop_herdr_workspaces "$dest" || return 1

    # Stop the Zellij session. An absent session IS successful shutdown — that is the
    # normal state on a retry. Stopping first is an invariant: a live process
    # holding the directory open is what leaves an empty tmp/ husk behind.
    local name; name="$(_wt_session_name "$dest")"
    if zellij list-sessions -s 2>/dev/null | grep -Fqx -- "$name"; then
      zellij delete-session --force "$name" >/dev/null 2>&1 || {
        print -ru2 -- "wt-rm: could not stop session '$name' — refusing to remove $dest."
        print -ru2 -- "    Close it by hand (zellij delete-session --force $name), then retry."
        return 1 }
    fi

    # Check 2 — shutdown can flush files; that is how the Bootsnap husks arose.
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: stopping the session left changes in $dest — inspect it, then retry."; return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean after session shutdown — refusing."; return 1 ;;
    esac

    if ! _wt_hook_run "$main" "$dest" "$branch" "$slug" teardown; then
      print -ru2 -- "wt-rm: .worktreehook teardown failed — $dest kept, session stopped."
      print -ru2 -- "    Fix it and retry: wt-rm $qb    (teardown is idempotent)"
      print -ru2 -- "    Or resume work with: wt-prepare $qb && wt $qb"
      return 1
    fi

    # Check 3 — ties non-ignored hook output to its cause, before Git's more
    # generic removal refusal appears one step later.
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: teardown left changes in $dest — removal aborted. Resources may already be reclaimed."
         print -ru2 -- "    Hook output must be git-ignored or written outside the worktree."
         return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean after teardown — refusing. Resources may already be reclaimed."
         return 1 ;;
    esac

    # Removal is the third post-shutdown failure mode (spec §9.3), and reports the
    # same exact partial state as the other two. Git's own refusal names only the
    # obstruction; on its own it leaves the reader unsure whether teardown ran, so
    # the reclamation state and both recovery routes are spelled out here.
    local -a remove_args
    remove_args=(worktree remove "$dest")
    # Keep the ownership lock in force until Git performs the removal. Unlocking
    # first creates an interrupt window where a checkout meant to be protected is
    # left exposed. Git's double-force form crosses the lock and removes its admin
    # record in one operation; it is used only after all three clean checks and only
    # for the exact lock reason above.
    (( herdr_owned )) && remove_args=(worktree remove --force --force "$dest")
    if ! _wt_git $remove_args; then
      print -ru2 -- "wt-rm: removing $dest failed — worktree kept, session stopped. Resources may already be reclaimed."
      print -ru2 -- "    Fix the obstruction and retry: wt-rm $qb    (teardown is idempotent)"
      print -ru2 -- "    Or resume work with: wt-prepare $qb && wt $qb"
      return 1
    fi
    print -r -- "✓ removed worktree $dest"

    _wt_git -C "$main" branch -d "$branch" \
      || print -ru2 -- "wt-rm: branch $qb kept (not fully merged) — inspect or merge it before deleting it explicitly."

    [[ -d "$dest" ]] \
      && print -ru2 -- "wt-rm: $dest still exists (files recreated during removal) — remove it manually."
    return 0
  } always {
    _wt_unlock
  }
}
