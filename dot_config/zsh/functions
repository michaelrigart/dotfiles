#!/usr/bin/env zsh
# Custom shell functions

# op-edit — edit a 1Password-backed dotfile, then re-apply the chezmoi targets
# that render from it.
#
# Some dotfiles keep their contents in a 1Password secure note instead of the
# public dotfiles repo, rendered by chezmoi with:
#     {{ onepasswordRead "op://<vault>/<item>/notes" }}
# e.g. ~/.ssh/config.
#
# Usage:
#   op-edit                  # list op-backed dotfiles (file ⇐ 1Password item)
#   op-edit ~/.ssh/config    # by file path — resolves the note automatically
#   op-edit "SSH config"     # or by 1Password item name
#
# The note is written to a private temp file (mode 600) while editing and passed
# to `op item edit` as an argument (briefly visible via `ps`).
op-edit() {
  emulate -L zsh
  local src; src="$(chezmoi source-path)" || return 1

  # No argument: list op-backed dotfiles as "file ⇐ item".
  if [[ -z "$1" ]]; then
    print -r -- "op-edit <file|item> — 1Password-backed dotfiles:"
    local f r i t
    while IFS= read -r f; do
      r="$(grep -m1 -oE 'op://[^"]+/notes' "$f" 2>/dev/null)" || continue
      [[ -n "$r" ]] || continue
      i="${${r#op://*/}%/notes}"
      t="$(chezmoi target-path "$f" 2>/dev/null)"
      printf '  %-30s ⇐  %s\n' "${t/#$HOME/~}" "$i"
    done < <(grep -rlE 'op://[^"]+/notes' "$src" --include='*.tmpl' 2>/dev/null) | sort -u
    return 0
  fi

  # Resolve the argument to an op reference: a managed file path, or an item name.
  local arg="${1/#\~/$HOME}" srcfile ref
  if srcfile="$(chezmoi source-path "$arg" 2>/dev/null)"; then
    ref="$(grep -m1 -oE 'op://[^"]+' "$srcfile" 2>/dev/null)"
    if [[ -z "$ref" ]]; then
      print -ru2 -- "op-edit: '$1' is chezmoi-managed but not backed by a 1Password note."
      return 1
    fi
  else
    ref="op://Private/$1/notes"
  fi

  # Parse op://<vault>/<item>/<field>.
  local rest="${ref#op://}"
  local vault="${rest%%/*}"; rest="${rest#*/}"
  local item="${rest%/*}" field="${rest##*/}"
  if [[ "$field" != "notes" ]]; then
    print -ru2 -- "op-edit: '$1' maps to op field '$field', not a note — edit it in 1Password directly."
    return 1
  fi

  # Pull current note content into a private temp file.
  local tmp; tmp="$(mktemp -t op-edit)" || return 1
  if ! op read "$ref" >| "$tmp" 2>/dev/null; then
    print -ru2 -- "op-edit: can't read $ref — does '$item' exist in '$vault'?"
    rm -f "$tmp"; return 1
  fi

  # Edit; bail out if nothing changed.
  local before; before="$(shasum "$tmp" | awk '{print $1}')"
  "${EDITOR:-nvim}" "$tmp"
  if [[ "$before" == "$(shasum "$tmp" | awk '{print $1}')" ]]; then
    print -r -- "op-edit: no changes to '$item'."
    rm -f "$tmp"; return 0
  fi

  # Push the edited content back to the note.
  if ! op item edit "$item" --vault "$vault" "notesPlain=$(<"$tmp")" >/dev/null; then
    print -ru2 -- "op-edit: failed to update '$item'."
    rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"

  # Re-apply every chezmoi target that renders from this note.
  local -a targets=()
  local f t
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    t="$(chezmoi target-path "$f" 2>/dev/null)"
    [[ -n "$t" ]] && targets+=("$t")
  done < <(grep -rlF "op://$vault/$item/" "$src" --include='*.tmpl' 2>/dev/null)

  if (( ${#targets} )); then
    if chezmoi apply "${targets[@]}"; then
      print -r -- "✓ '$item' updated → applied: ${targets[*]/#$HOME/~}"
    else
      print -ru2 -- "op-edit: '$item' is updated, but the apply did not run; re-apply the targets with chezmoi apply <targets> from a clean main."
      return 1
    fi
  else
    print -r -- "✓ '$item' updated."
  fi
}

# tsh — Teleport SSH with a portable TERM. Ghostty's ssh-env/ssh-terminfo cover
# the plain `ssh` binary, but not `tsh`, and edge nodes lack xterm-ghostty
# terminfo. Only the `ssh` subcommand needs the downgrade; other subcommands
# (tsh login, kube, db, …) run untouched.
tsh() {
  if [[ "$1" == "ssh" ]]; then
    TERM=xterm-256color command tsh "$@"
  else
    command tsh "$@"
  fi
}

# dev — open (or return to) a project in its Herdr workspace. Resolve an argument to
# a repository under ~/Code, then hand that path to layout.sh: a primary checkout
# opens as an ordinary workspace, a linked one through native worktree mode.
#   dev                    pick from all repos under ~/Code (fzf)
#   dev curato             by name: exact basename → case-insensitive substring → fzf
#   dev Netronix/curato    path relative to ~/Code
#   dev .                  the git repo containing the current directory
#
# The retired `dev` also accepted a session name (`dev netronix--curato`). There are no
# session names any more, so such an argument matches no repo by basename or substring
# and falls through to the fzf picker.
#
# Resolution only. Everything about Herdr lives in layout.sh.
dev() {
  emulate -L zsh
  setopt local_options null_glob extended_glob

  local code="$HOME/Code" repo arg="$1"
  local -a repos=( "$code"/*/.git(N:h) "$code"/*/*/.git(N:h) )

  if [[ "$arg" == "." || ( -n "$arg" && -d "$arg" ) ]]; then
    repo="$(_wt_git -C "${arg:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" \
      || { print -ru2 -- "dev: '${arg:-$PWD}' is not inside a git repo."; return 1 }
  elif [[ -n "$arg" && -e "$code/$arg/.git" ]]; then
    repo="$code/$arg"
  else
    local -a hits
    if [[ -z "$arg" ]]; then
      hits=( $repos )
    else
      hits=( ${(M)repos:#*/$arg} )                       # exact basename
      (( ${#hits} )) || hits=( ${(M)repos:#(#i)*$arg*} ) # case-insensitive substring
    fi
    if (( ${#hits} == 1 )); then
      repo="${hits[1]}"
    else
      local -a pool; (( ${#hits} )) && pool=( $hits ) || pool=( $repos )
      local sel
      sel="$(print -rl -- ${pool[@]#$code/} | fzf --prompt='dev > ' ${arg:+--query=$arg})" || return 0
      [[ -n "$sel" ]] || return 0
      repo="$code/$sel"
    fi
  fi

  repo="${repo:A}"
  [[ -n "$repo" && -e "$repo/.git" ]] || { print -ru2 -- "dev: no git repo resolved."; return 1 }

  # A linked checkout must enter through layout.sh's worktree mode, which keeps
  # Herdr's worktree provenance; an ordinary workspace could not be identified safely
  # by wt-rm.
  if [[ -f "$repo/.git" ]]; then
    local main
    main="$(builtin cd "$repo" && _wt_primary)" || return 1
    _wt_prepare_for_herdr "$main" "$repo" || return 1
    "${DEV_LAYOUT:-$HOME/.config/herdr/layout.sh}" --worktree "$main" "$repo"
    return $?
  fi

  "${DEV_LAYOUT:-$HOME/.config/herdr/layout.sh}" "$repo"
}

# Library functions use `builtin cd`, never bare `cd`: they must not depend on whatever an
# interactive shell binds `cd` to, because the `zsh -ic <cmd>` shells that Herdr popups
# run never reach a prompt.

# _wt_git — git with its routing environment cleared. Every Git call in the lifecycle
# goes through this: an exported GIT_DIR or GIT_WORK_TREE redirects git to another
# checkout, and `status` then reports a dirty worktree as clean with exit status 0.
_wt_git() {
  emulate -L zsh
  command env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE \
    git "$@"
}

# _wt_primary — absolute path of the repository's primary worktree.
#
# Resolved from `worktree list`, never by path arithmetic on --git-common-dir, which
# yields the containing directory for a bare repo.
#
# -z is required: the line-based porcelain format may quote a path. ${(0)} drops the
# empty separator records, leaving field 1 = "worktree <path>" and, for a bare repo,
# field 2 = "bare".
_wt_primary() {
  emulate -L zsh
  local -a f
  f=( ${(0)"$(_wt_git worktree list --porcelain -z 2>/dev/null)"} )
  [[ "${f[1]}" == 'worktree '* ]] || {
    print -ru2 -- "wt: not inside a git repository."; return 1 }
  [[ "${f[2]}" == bare ]] && {
    print -ru2 -- "wt: repository is bare — there is no primary worktree to run from."; return 1 }
  print -r -- "${f[1]#worktree }"
}

# _wt_clean <worktree> — 0 clean, 1 dirty, 2 state unknown.
#
# Three-state on purpose: a failed `git status` produces empty output, which testing
# output alone would read as "no changes".
#
# Each flag closes a way a dirty tree can report clean:
#   --untracked-files=normal   defeats status.showUntrackedFiles=no
#   --ignore-submodules=none   defeats diff.ignoreSubmodules / submodule.*.ignore
#   --porcelain=v1             pins the format against a default change
#
# The assignment is split from `local` on purpose: `local x="$(cmd)"` reports the
# builtin's status, not the command substitution's.
_wt_clean() {
  emulate -L zsh
  local wt="$1" out rc
  out="$(_wt_git -C "$wt" status --porcelain=v1 --untracked-files=normal \
                 --ignore-submodules=none 2>/dev/null)"; rc=$?
  (( rc )) && return 2
  [[ -n "$out" ]] && return 1
  return 0
}

# _wt_lock <common-dir> <slug> / _wt_unlock — serialize lifecycle commands per
# target worktree, so `wt-prepare` cannot copy into a directory `wt-rm` is
# removing.
#
# `zsystem flock` is an fcntl(2) record lock despite the name:
#
#   1. The lock file must already exist — zsystem opens it and will not create it.
#   2. Release must be explicit. These are sourced functions: returning does not
#      close the descriptor, so without an unlock the fd stays open in the
#      interactive shell and blocks every OTHER process's lifecycle command on that
#      target until the shell exits. Kernel release on process death is the backstop
#      for an interrupt, which skips the `always` block (see the interruption note
#      below _wt_unlock).
#   3. Locks are per-process, not per-descriptor. A nested acquisition in the same
#      shell SUCCEEDS, and unlocking any one descriptor drops the process's lock
#      entirely — a routine that took its own lock would release its caller's. Only
#      the outermost command locks (the command/routine split in wt-prepare).
#
# So there is no intra-process exclusion; the case defended is concurrent commands
# in different terminals.
_wt_lock() {
  emulate -L zsh
  zmodload zsh/system 2>/dev/null || {
    print -ru2 -- "wt: zsh/system unavailable — refusing to run unlocked."; return 1 }
  local dir="$1/wt-locks" lf="$1/wt-locks/$2.lock"
  mkdir -p "$dir" && : >> "$lf" || {
    print -ru2 -- "wt: cannot create lock file $lf."; return 1 }
  # _WT_LOCK_FD is intentionally global: the caller unlocks it.
  if ! zsystem flock -t 0 -f _WT_LOCK_FD "$lf" 2>/dev/null; then
    print -ru2 -- "wt: another lifecycle command is working on '$2' — retry when it finishes."
    return 1
  fi
}

_wt_unlock() {
  emulate -L zsh
  [[ -n "${_WT_LOCK_FD:-}" ]] || return 0
  zsystem flock -u $_WT_LOCK_FD 2>/dev/null
  unset _WT_LOCK_FD
  return 0
}

# The lifecycle lock: wt applies it at creation and dev re-applies it. Only wt-rm
# crosses it, with Git's double force, after every check. Herdr's native removal
# (one --force) cannot cross it, which keeps it blocked: it skips teardown and the
# cleanliness checks.
_wt_herdr_lock_reason() {
  print -r -- "wt-managed; remove with command wt-rm"
}

# _wt_git_lock_state <root> <dest> — 0 locked (reason in _WT_GIT_LOCK_REASON),
# 1 registered but unlocked, 2 state unreadable/not registered.
#
# NUL porcelain, for the same reason as _wt_primary. A `worktree ` token starts each
# record, so empty separators need not survive ${(0)}.
_wt_git_lock_state() {
  emulate -L zsh
  # Never name a local `path` in zsh: it is the tied array behind PATH, and
  # localising it empties command lookup for every external below.
  local root="$1" dest="${2:A}" rec wt_path rc in_target=0 seen=0
  local -a fields
  typeset -g _WT_GIT_LOCK_REASON=""
  # zsh scalars cannot carry NUL bytes, so the array assignment through ${(0)} is the
  # one call that yields both the records and the command's status. Reading twice
  # would parse a failed read as authoritative: its empty result looks like an
  # unregistered worktree.
  fields=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} ); rc=$?
  if (( rc )); then
    print -ru2 -- "wt: cannot read Git worktree lock state for $dest — refusing."
    return 2
  fi
  for rec in $fields; do
    if [[ "$rec" == 'worktree '* ]]; then
      wt_path="${rec#worktree }"
      in_target=0
      [[ "${wt_path:A}" == "$dest" ]] && { in_target=1; seen=1; }
    elif (( in_target )) && [[ "$rec" == locked || "$rec" == 'locked '* ]]; then
      _WT_GIT_LOCK_REASON="${rec#locked}"
      _WT_GIT_LOCK_REASON="${_WT_GIT_LOCK_REASON# }"
      return 0
    fi
  done
  if (( seen )); then
    return 1
  fi
  print -ru2 -- "wt: $dest is not a registered worktree of $root."
  return 2
}

_wt_ensure_herdr_lock() {
  emulate -L zsh
  local root="$1" dest="$2" wanted state
  wanted="$(_wt_herdr_lock_reason)"
  _wt_git_lock_state "$root" "$dest"; state=$?
  case "$state" in
    0)
      if [[ "$_WT_GIT_LOCK_REASON" != "$wanted" ]]; then
        print -ru2 -- "dev: $dest is locked for another reason: ${_WT_GIT_LOCK_REASON:-<no reason>}"
        print -ru2 -- "    Herdr will not take ownership of a user-managed Git lock."
        return 1
      fi ;;
    1)
      _wt_git -C "$root" worktree lock --reason "$wanted" "$dest" || {
        print -ru2 -- "dev: could not apply the lifecycle lock to $dest — refusing to open it in Herdr."
        return 1
      } ;;
    *) return 1 ;;
  esac
}

# Serialize the Herdr handoff against wt-prepare/wt-rm, revalidate the checkout under
# that lock, then apply the persistent Git lock. The layout handoff stays outside the
# fcntl lock because it attaches a long-lived TUI.
_wt_prepare_for_herdr() {
  emulate -L zsh
  local main="$1" dest="$2" branch slug expected common
  branch="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)" || {
    print -ru2 -- "dev: $dest is detached — wt-rm requires a branch-owned checkout."
    return 1
  }
  slug="${branch//\//-}"
  expected="${main:h}/${main:t}-${slug}"
  if [[ "${dest:A}" != "${expected:A}" ]]; then
    print -ru2 -- "dev: $dest is not a wt-managed sibling checkout — refusing."
    print -ru2 -- "    Expected $expected for branch $(_wt_q "$branch"); only that path is removable by command wt-rm."
    return 1
  fi
  common="$(_wt_git -C "$main" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || return 1
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1
    _wt_ensure_herdr_lock "$main" "$dest" || return 1
  } always {
    _wt_unlock
  }
}

# --- Interruption and the lock ---------------------------------------------
#
# There is deliberately NO `trap ... INT TERM` in any lifecycle command: it is
# fail-open on the destructive path. `return` inside a trap handler unwinds only the
# innermost function and zsh discards its status, so the interrupted helper reports
# 0 — and 0 is the permissive answer for every gate (_wt_clean "clean",
# _wt_hook_check "valid", _wt_assert_worktree "right branch"). Under SIGINT's
# default disposition the whole command unwinds and no status is fabricated.
#
# The accepted cost: a shell that survives an interrupt may keep the descriptor,
# which blocks other processes' lifecycle commands on that target until it exits.
# `always { _wt_unlock }` covers every ordinary exit path.
# Full argument: docs/superpowers/specs/2026-07-30-worktree-hook-protocol-design.md §9.4.

# _wt_hook_check <main> — 0 valid, 1 invalid, 2 absent (not opted in).
#
# Both the index entry and the working-tree path are checked: a tracked symlink
# passes "tracked" and "executable" while the code that runs lives outside the
# repository, and the index mode alone cannot see an unstaged local swap.
# Requiring 100755 in the index makes opt-in reproducible across clones. Stage 0
# rejects a conflicted hook.
_wt_hook_check() {
  emulate -L zsh
  local main="$1" hook="$1/.worktreehook" raw mode rc
  # Status captured separately, as in _wt_clean: a failed ls-files leaves `raw`
  # empty, which must not be read as "not opted in".
  raw="$(_wt_git -C "$main" ls-files --stage -- .worktreehook 2>/dev/null)"; rc=$?
  if (( rc )); then
    print -ru2 -- "wt: cannot read the index of $main to validate .worktreehook — refusing."
    return 1
  fi
  mode="$(print -r -- "$raw" | awk '$3 == 0 { print $1 }')"

  if [[ -z "$raw" ]]; then
    [[ -e "$hook" || -L "$hook" ]] || return 2          # not opted in
    print -ru2 -- "wt: $hook exists but is not tracked — commit it or remove it."
    return 1
  fi
  if [[ -z "$mode" ]]; then
    print -ru2 -- "wt: .worktreehook has no stage-0 index entry (unresolved conflict) — resolve it first."
    return 1
  fi
  if [[ "$mode" != 100755 ]]; then
    print -ru2 -- "wt: .worktreehook is indexed as $mode, not 100755."
    [[ "$mode" == 100644 ]] && \
      print -ru2 -- "    Fix with: git add --chmod=+x .worktreehook"
    return 1
  fi
  if [[ -L "$hook" ]]; then
    print -ru2 -- "wt: .worktreehook is a symlink in the working tree — refusing."
    return 1
  fi
  [[ -f "$hook" ]] || { print -ru2 -- "wt: .worktreehook is not a regular file."; return 1 }
  [[ -x "$hook" ]] || { print -ru2 -- "wt: .worktreehook is not executable."; return 1 }
  return 0
}

# _wt_hook_run <main> <worktree> <branch> <slug> <verb> — run the project hook.
#
# Validated here, immediately before execution: the pre-flight in `wt` is only a
# usability guard and does not substitute (hook-protocol design §5.1, "Validation is
# point-in-time").
#
# Executed as a process so its shebang picks the interpreter, in a subshell so cwd
# and WT_* never leak back into the caller.
_wt_hook_run() {
  emulate -L zsh
  local main="$1" wt="$2" branch="$3" slug="$4" verb="$5"
  _wt_hook_check "$main"
  case $? in
    2) return 0 ;;   # repository has not opted in
    1) return 1 ;;
  esac
  ( builtin cd "$wt" \
    && WT_MAIN="$main" WT_WORKTREE="$wt" WT_BRANCH="$branch" WT_SLUG="$slug" \
       "$main/.worktreehook" "$verb" )
  local hrc=$?
  (( hrc == 0 )) && return 0
  # Normalized to 1: the documented interface is 0/1; the hook's own status goes in
  # the message.
  print -ru2 -- "wt: .worktreehook $verb exited $hrc."
  return 1
}

# _wt_manifest <main> <dest> — validate .worktreeinclude and fill _WT_CARRY with
# the entries whose destination is still missing.
#
# Entries already present at the destination are skipped, never overwritten: a local
# edit in the worktree wins.
#
# Containment is checked lexically and through the filesystem: a path with no ".."
# still escapes through a symlinked directory component, and the destination tree
# comes from the feature branch. The rule is asymmetric:
#
#   source:      no component may be a symlink, INCLUDING the final one, which is
#                dereferenced on read.
#   destination: no PARENT component may be a symlink. A final symlink is fine
#                because it is skipped below as "already present", never followed.
_wt_manifest() {
  emulate -L zsh
  setopt local_options extended_glob
  local main="$1" dest="$2" line p comp
  local -a parts
  _WT_CARRY=()
  [[ -f "$main/.worktreeinclude" ]] || return 0

  # `|| [[ -n "$line" ]]` so a final line with no trailing newline still counts.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${${line##[[:space:]]##}%%[[:space:]]##}"
    [[ -z "$line" || "$line" == '#'* ]] && continue

    if [[ "$line" == /* || "$line" == '~'* ]]; then
      print -ru2 -- "wt: .worktreeinclude entry '$line' is not repo-relative — refusing."
      return 1
    fi
    parts=( ${(s:/:)line} )
    if (( ${parts[(I)..]} )); then
      print -ru2 -- "wt: .worktreeinclude entry '$line' contains '..' — refusing."
      return 1
    fi

    if [[ ! -e "$main/$line" && ! -L "$main/$line" ]]; then
      print -ru2 -- "wt: .worktreeinclude lists '$line', not found in $main — skipping."
      continue
    fi

    p="$main"
    for comp in $parts; do
      p="$p/$comp"
      if [[ -L "$p" ]]; then
        print -ru2 -- "wt: .worktreeinclude entry '$line' resolves through a symlink in $main — refusing."
        return 1
      fi
    done

    p="$dest"
    for comp in ${parts[1,-2]}; do
      p="$p/$comp"
      if [[ -L "$p" ]]; then
        print -ru2 -- "wt: .worktreeinclude entry '$line' resolves through a symlink in $dest — refusing."
        return 1
      fi
    done

    [[ -e "$dest/$line" || -L "$dest/$line" ]] && continue   # already present: done
    _WT_CARRY+=( "$line" )
  done < "$main/.worktreeinclude"
  return 0
}

# _wt_mise_show <dir> — what mise says about the config files of one checkout, as one
# `trusted<TAB><rel>` or `untrusted<TAB><rel>` line each (rel is relative to the checkout
# and may contain `/`). Returns 1 when mise fails or prints a line it does not recognise,
# and prints nothing then: a partial answer is not an answer.
#
# `mise trust --show` also lists configs above <dir> and the global one; those are dropped.
# Membership is decided on the text of the path alone — mise prints $HOME as `~/` and the
# -C directory canonicalised, nothing else resolved — so only <dir> is canonicalised here
# and an entry is never resolved. Each line is split on its trailing `: trusted` or
# `: untrusted`, because the path itself may contain `: `. Only stdout is read.
#
# mise prints a newline inside a config filename raw, so `a: trusted<NL>b.toml: untrusted`
# is one file that reads as two lines. Every entry must therefore be an absolute path once
# `~/` is mapped, and a blank line is never skipped: either makes the read unreadable.
_wt_mise_show() {
  emulate -L zsh
  (( $+commands[mise] )) || return 0
  local dir="${1:A}" out line ent state res=""
  out="$(command mise -C "$dir" trust --show 2>/dev/null </dev/null)" || return 1
  [[ -z "$out" ]] && return 0
  for line in "${(@f)out}"; do
    [[ -z "$line" ]] && return 1
    if [[ "$line" == *': trusted' ]]; then
      state=trusted; ent="${line%': trusted'}"
    elif [[ "$line" == *': untrusted' ]]; then
      state=untrusted; ent="${line%': untrusted'}"
    else
      return 1
    fi
    [[ "$ent" == '~/'* ]] && ent="${HOME%/}/${ent#'~/'}"
    [[ "$ent" == /* ]] || return 1
    [[ "$ent" == "$dir/"* ]] || continue
    res+="$state"$'\t'"${ent#"$dir/"}"$'\n'
  done
  [[ -n "$res" ]] && print -rn -- "$res"
  return 0
}

# _wt_mise_candidates <main> <dest> [<base-branch>] — the checkouts of one repository that
# may vouch for the mise config of the worktree about to be made at <dest> (spec §2).
# Sets _WT_MISE_CANDS (checkout roots) and _WT_MISE_BASEDIR (the root whose record reads
# `branch refs/heads/<base-branch>`, or empty), and returns 0. Returns 1 when Git's worktree
# list cannot be read or has no records: nothing can then vouch, and wt trusts nothing.
#
# Order: <main> exactly as passed, then the base branch's checkout, then the others in
# Git's order; each root once. Left out: <dest> itself, a path that is not a directory, and
# any other root whose Git common dir is not <main>'s (a path since reused by another
# repository). Roots other than <main> are as Git prints them; a detached checkout (no
# `branch` record) is still a candidate. NUL porcelain, parsed as _wt_worktree_record does.
_wt_mise_candidates() {
  emulate -L zsh
  local main="$1" dest="${2:A}" base="${3:-}" rec root common maincommon rc
  local -a fields roots branches cands
  typeset -g _WT_MISE_BASEDIR=""
  typeset -ga _WT_MISE_CANDS=()
  fields=( ${(0)"$(_wt_git -C "$main" worktree list --porcelain -z 2>/dev/null)"} ); rc=$?
  if (( rc || ! ${#fields} )); then
    print -ru2 -- "wt: cannot read Git's worktree list for $(_wt_tilde "$main") — trusting nothing."
    return 1
  fi
  for rec in $fields; do
    if [[ "$rec" == 'worktree '* ]]; then
      roots+=( "${rec#worktree }" ); branches+=( "" )
    elif (( ${#roots} )) && [[ "$rec" == 'branch refs/heads/'* ]]; then
      branches[-1]="${rec#branch refs/heads/}"
    fi
  done
  if (( ! ${#roots} )); then   # fields, but no `worktree ` record among them: no list either
    print -ru2 -- "wt: cannot read Git's worktree list for $(_wt_tilde "$main") — trusting nothing."
    return 1
  fi
  maincommon="$(_wt_git -C "$main" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || maincommon=""
  local i
  for (( i = 1; i <= ${#roots}; i++ )); do
    root="${roots[i]}"
    [[ "${root:A}" == "$dest" ]] && continue
    if [[ "${root:A}" == "${main:A}" ]]; then
      [[ -n "$base" && "${branches[i]}" == "$base" ]] && _WT_MISE_BASEDIR="$main"
      continue
    fi
    [[ -d "$root" ]] || continue
    common="$(_wt_git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || continue
    [[ -n "$common" && -n "$maincommon" && "${common:A}" == "${maincommon:A}" ]] || continue
    if [[ -n "$base" && -z "$_WT_MISE_BASEDIR" && "${branches[i]}" == "$base" ]]; then
      _WT_MISE_BASEDIR="$root"
    fi
    cands+=( "$root" )
  done
  # <main> leads. The base checkout follows it, and the rest keep Git's order.
  _WT_MISE_CANDS=( "$main" )
  [[ -n "$_WT_MISE_BASEDIR" && "$_WT_MISE_BASEDIR" != "$main" ]] && _WT_MISE_CANDS+=( "$_WT_MISE_BASEDIR" )
  for root in $cands; do
    [[ "$root" == "$_WT_MISE_BASEDIR" ]] && continue
    _WT_MISE_CANDS+=( "$root" )
  done
  return 0
}

# _wt_tilde <path> — the path with a leading $HOME/ shown as ~/, for messages only.
_wt_tilde() {
  emulate -L zsh
  if [[ "$1" == "$HOME/"* ]]; then print -rn -- "~/${1#"$HOME/"}"; else print -rn -- "$1"; fi
}

# _wt_q <text> — the text quoted for a shell, for lines Michael pastes: a branch name, a
# session name or a path pastes as itself whatever it holds. Safe text prints unchanged.
# Text with a `!` is single-quoted, because (q-) leaves `!` bare and both shells expand it
# as history; `!` is legal in a branch name and in a path.
_wt_q() {
  emulate -L zsh
  if [[ "$1" == *'!'* ]]; then
    print -rn -- "${(qq)1}"
  else
    print -rn -- "${(q-)1}"
  fi
}

# _wt_tilde_q <path> — like _wt_tilde, quoted for a shell (see _wt_q), for lines Michael
# pastes. The leading ~/ stays outside the quotes so that it still expands.
_wt_tilde_q() {
  emulate -L zsh
  local rest="$1" pre=""
  if [[ "$1" == "$HOME/"* ]]; then rest="${1#"$HOME/"}" pre="~/"; fi
  print -rn -- "$pre$(_wt_q "$rest")"
}

# _wt_mise_plain <root> <rel> — 0 when no component of <root>/<rel> below <root> is a
# symlink and <root>/<rel> is a regular file: the only kind of config wt compares or carries.
_wt_mise_plain() {
  emulate -L zsh
  local p="$1" comp
  for comp in ${(s:/:)2}; do
    p="$p/$comp"
    [[ -L "$p" ]] && return 1
  done
  [[ -f "$p" ]]
}

# _wt_mise_trust_report <main> <dest> <basedir> <reason<TAB>rel>... — the refusal lines for
# configs that stay untrusted: what is wrong, how to look at it, how to trust it by hand
# (spec §4). The path is the last field of a record and is never cut at a tab: only a
# reason, which has none, is split off the front.
#
# The review is a diff only for a "matches no trusted copy" record, and only against a copy
# that is a plain file, listed `trusted` in _WT_MISE_SHOWN (this run's search reads; mise is
# never called here) and different from the worktree's: the base checkout's <basedir> first
# (empty when wt knows no base), then <main>'s. Against any other copy a diff would show
# nothing, or nothing that was ever looked at, so the file itself is shown.
_wt_mise_trust_report() {
  emulate -L zsh
  local main="$1" dest="$2" basedir="$3" entry rel reason dp c review
  local none="it matches no trusted copy in this repository's checkouts"
  typeset -gA _WT_MISE_SHOWN
  shift 3
  for entry in "$@"; do
    reason="${entry%%$'\t'*}" rel="${entry#*$'\t'}"
    dp="$(_wt_tilde_q "$dest/$rel")"
    review="cat $dp"
    if [[ "$reason" == "$none" ]]; then
      for c in $basedir $main; do
        [[ -n "$c" ]] && _wt_mise_plain "$c" "$rel" || continue
        [[ $'\n'"${_WT_MISE_SHOWN[$c]-}"$'\n' == *$'\n'"trusted"$'\t'"$rel"$'\n'* ]] || continue
        cmp -s -- "$c/$rel" "$dest/$rel"
        (( $? == 1 )) || continue
        review="diff $(_wt_tilde_q "$c/$rel") $dp"
        break
      done
    fi
    print -ru2 -- "wt: $(_wt_tilde "$dest/$rel") is not trusted: $reason."
    print -ru2 -- "    review: $review"
    print -ru2 -- "    then:   mise trust $dp"
  done
}

# _wt_mise_withdraw <main> <dest> <basedir> <rel> <stop-message> <reason<TAB>rel>... — take
# back the trust just given to <dest>/<rel>. Returns 0 only when that worked and there is no
# stop-message; otherwise the collected refusals are printed, then a line saying the file may
# still be trusted if the untrust failed, then the stop-message if any, and it returns 1.
# An untrust that fails (it does when the file is gone) can leave the file trusted with
# whatever `mise trust` hashed, so the failure is its own line, not "trust failed".
_wt_mise_withdraw() {
  emulate -L zsh
  local main="$1" dest="$2" basedir="$3" msg="$5" failed=0 dp
  dp="$dest/$4"   # not on the local line: zsh expands that whole line before assigning
  shift 5
  command mise trust --untrust "$dp" >/dev/null 2>&1 </dev/null || failed=1
  (( failed )) || [[ -n "$msg" ]] || return 0
  _wt_mise_trust_report "$main" "$dest" "$basedir" "$@"
  (( failed )) && print -ru2 -- "wt: could not withdraw mise trust from $(_wt_tilde "$dp") — it may still be trusted; check with: mise -C $(_wt_tilde_q "$dest") trust --show"
  [[ -n "$msg" ]] && print -ru2 -- "$msg"
  return 1
}

# _wt_mise_trust <main> <dest> [<base-branch>] — carry mise's trust from the checkouts of
# this repository into a new worktree, for the configs that are byte-identical to ones
# already trusted in one of them, and explain every other one (spec §2–§4). Returns 0 when
# there was nothing to carry or all of it was carried, 1 when a config stays untrusted or a
# read or a trust call failed. <base-branch> is set only when wt just made the branch.
# _WT_MISE_CARRIED counts the files carried in this run, for the reopen's never-prepared line.
#
# Paranoid mode ties trust to file content and no longer inherits it into worktrees, so a
# config nobody has looked at must never be trusted here: the sandbox can rewrite a branch's
# committed mise.toml and the main checkout's mise.local.toml (which .worktreeinclude copies).
# An untrusted <dest> config is carried only if neither it nor a candidate's counterpart has
# a symlink on the way or is anything but a regular file, mise lists the candidate's copy as
# trusted, and `cmp` finds them identical. Candidates (_wt_mise_candidates) are tried in its
# order, and the first that vouches ends the search for that file. After `mise trust` the
# same facts are read again, bound to that candidate, and a file that no longer holds up is
# untrusted at once: the content may have changed in between, and no other candidate is
# tried for it.
#
# A candidate's `trust --show` is read at most once per run for the search, through
# _WT_MISE_SHOWN, so a second file never re-reads it; the re-check always reads afresh. A
# candidate whose read fails is out for the run, with one "cannot vouch" line: trust still
# needs a successful read of the vouching candidate, so that can only carry fewer files.
#
# Ordinary refusals are collected and printed together at the end. A failed read of <dest> or
# of the worktree list, a failed trust or untrust, and a failed re-check read stop at once,
# because nothing said afterwards can be believed; the one call still made then is the
# untrust of a file that was just trusted.
_wt_mise_trust() {
  emulate -L zsh
  typeset -g _WT_MISE_CARRIED=0
  (( $+commands[mise] )) || return 0
  local main="$1" dest="$2" base="${3:-}" dshow cshow line rel dp cp c vouch reason basedir="" listed=0
  local none="it matches no trusted copy in this repository's checkouts"
  local symlink="it is a symlink or not a regular file"
  local -a dlines refused cands
  local dnow cnow
  typeset -gA _WT_MISE_SHOWN
  _WT_MISE_SHOWN=()

  dshow="$(_wt_mise_show "$dest")" || {
    print -ru2 -- "wt: cannot read mise's trust status for $(_wt_tilde "$dest") — trusting nothing."
    return 1
  }
  dlines=( ${(f)dshow} )

  for line in $dlines; do
    [[ "$line" == untrusted$'\t'* ]] || continue
    rel="${line#untrusted$'\t'}"
    dp="$dest/$rel"

    if (( ! listed )); then
      _wt_mise_candidates "$main" "$dest" "$base" || return 1
      cands=( $_WT_MISE_CANDS ) basedir="$_WT_MISE_BASEDIR" listed=1
    fi

    reason="" vouch=""
    if ! _wt_mise_plain "$dest" "$rel"; then
      reason="$symlink"
    else
      for c in $cands; do
        _wt_mise_plain "$c" "$rel" || continue
        if (( ! $+_WT_MISE_SHOWN[$c] )); then
          if cshow="$(_wt_mise_show "$c")"; then
            _WT_MISE_SHOWN[$c]="$cshow"
          else
            _WT_MISE_SHOWN[$c]="!"
            print -ru2 -- "wt: cannot read mise's trust status for $(_wt_tilde "$c") — it cannot vouch."
          fi
        fi
        [[ "${_WT_MISE_SHOWN[$c]}" == "!" ]] && continue
        [[ $'\n'"${_WT_MISE_SHOWN[$c]}"$'\n' == *$'\n'"trusted"$'\t'"$rel"$'\n'* ]] || continue
        cmp -s -- "$c/$rel" "$dp" || continue
        vouch="$c"
        break
      done
      [[ -n "$vouch" ]] || reason="$none"
    fi

    if [[ -z "$reason" ]]; then
      cp="$vouch/$rel"
      if ! command mise trust "$dp" >/dev/null 2>&1 </dev/null; then
        _wt_mise_trust_report "$main" "$dest" "$basedir" $refused
        print -ru2 -- "wt: mise trust failed for $(_wt_tilde "$dp") — trusting nothing more."
        return 1
      fi
      if ! dnow="$(_wt_mise_show "$dest")"; then
        _wt_mise_withdraw "$main" "$dest" "$basedir" "$rel" \
          "wt: cannot read mise's trust status for $(_wt_tilde "$dest") — trusting nothing." $refused
        return 1
      fi
      if ! cnow="$(_wt_mise_show "$vouch")"; then
        _wt_mise_withdraw "$main" "$dest" "$basedir" "$rel" \
          "wt: cannot read mise's trust status for $(_wt_tilde "$vouch") — trusting nothing." $refused
        return 1
      fi
      if cmp -s -- "$cp" "$dp" \
         && [[ $'\n'"$dnow"$'\n' == *$'\n'"trusted"$'\t'"$rel"$'\n'* ]] \
         && [[ $'\n'"$cnow"$'\n' == *$'\n'"trusted"$'\t'"$rel"$'\n'* ]]; then
        print -r -- "wt: mise trust carried to $(_wt_tilde "$dp") (trusted in $(_wt_tilde "$vouch"))"
        (( _WT_MISE_CARRIED++ ))
        continue
      fi
      _wt_mise_withdraw "$main" "$dest" "$basedir" "$rel" "" $refused || {
        print -ru2 -- "wt: $(_wt_tilde "$dp") changed while wt was trusting it — trusting nothing more."
        return 1
      }
      reason="it changed while wt was trusting it"
    fi
    refused+=( "$reason"$'\t'"$rel" )
  done

  (( $#refused )) || return 0
  _wt_mise_trust_report "$main" "$dest" "$basedir" $refused
  return 1
}

# _wt_do_prepare <main> <dest> <branch> <slug> [<base-branch>] — copy missing manifest
# entries, carry mise trust (see _wt_mise_trust for <base-branch>), then run the project
# setup hook. The UNLOCKED routine: `wt` calls it under the lock
# it already holds, and `wt-prepare` is the locked wrapper. It must not lock itself
# (per-process locks, see _wt_lock).
_wt_do_prepare() {
  emulate -L zsh
  local main="$1" dest="$2" branch="$3" slug="$4" base="${5:-}" qb
  qb="$(_wt_q "$branch")"

  # Validate the hook before copying, so a misconfigured repository changes nothing.
  _wt_hook_check "$main" >/dev/null 2>&1
  local hrc=$?
  if (( hrc == 1 )); then
    _wt_hook_check "$main"          # re-run for the message
    print -ru2 -- "    The worktree exists — fix the hook, then: wt-prepare $qb && wt $qb"
    return 1
  fi

  _wt_manifest "$main" "$dest" || {
    print -ru2 -- "    The worktree exists — fix .worktreeinclude, then: wt-prepare $qb && wt $qb"
    return 1
  }

  local entry
  for entry in $_WT_CARRY; do
    [[ -e "$dest/$entry" || -L "$dest/$entry" ]] && continue
    if ! { mkdir -p -- "$dest/${entry:h}" && cp -pR -- "$main/$entry" "$dest/$entry" }; then
      rm -rf -- "$dest/$entry"
      print -ru2 -- "wt: copying .worktreeinclude entry '$entry' into $dest failed."
      print -ru2 -- "    The worktree exists — fix the copy, then: wt-prepare $qb && wt $qb"
      return 1
    fi
  done

  _wt_mise_trust "$main" "$dest" "$base" || {
    print -ru2 -- "    The worktree exists — review the mise config above, then: wt-prepare $qb && wt $qb"
    return 1
  }

  if ! _wt_hook_run "$main" "$dest" "$branch" "$slug" setup; then
    print -ru2 -- "wt: .worktreehook setup failed for $dest."
    print -ru2 -- "    The worktree exists — fix it, then: wt-prepare $qb && wt $qb"
    return 1
  fi
  return 0
}

# _wt_mise_reopen_carry <main> <dest> <branch> — on a reopen, run the same carry as a creation
# (spec §6), with no base branch: what it can vouch for is trusted, and what it cannot is
# reported. A reopen never stops and never runs a hook, so it always returns 0. A carry that
# left something untrusted prints the opening-anyway line; one that trusted a file prints the
# never-prepared line, because a creation that stopped at the mise step never ran its setup
# hook and the reopen would otherwise open it silently. Either sets _WT_NOTICE, so `wt-prompt`
# keeps the popup open for it.
_wt_mise_reopen_carry() {
  emulate -L zsh
  local qb
  qb="$(_wt_q "$3")"
  if ! _wt_mise_trust "$1" "$2"; then
    print -ru2 -- "wt: opening $(_wt_tilde "$2") anyway — its shells load no project mise config until the files above are trusted."
    typeset -g _WT_NOTICE=1
  fi
  if (( ${_WT_MISE_CARRIED:-0} )); then
    print -ru2 -- "wt: if this worktree was never prepared, run: wt-prepare $qb"
    typeset -g _WT_NOTICE=1
  fi
  return 0
}

# wt-prepare <branch> — re-run preparation against an existing worktree.
#
# The recovery path for a partial copy or a failed setup hook; `wt` on an existing
# worktree reopens: it carries mise trust and skips the copy and the setup hook. It never touches a Herdr workspace, so it
# may run while the target is live.
wt-prepare() {
  emulate -L zsh
  local branch="$1"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt-prepare <branch>"; return 1; }
  local slug="${branch//\//-}" main common dest
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  [[ -d "$dest" ]] || { print -ru2 -- "wt-prepare: $dest does not exist."; return 1; }
  _wt_lock "$common" "$slug" || return 1
  {
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1
    _wt_do_prepare "$main" "$dest" "$branch" "$slug" || return 1
    print -r -- "✓ prepared $dest"
  } always {
    _wt_unlock
  }
}

# wt — spin up (or reopen) a git worktree for the current repo in its own Herdr
# workspace. Complements `dev`, which only *finds* existing checkouts; `wt` *creates*
# one first, as a sibling under the same org dir so `dev`'s repo glob picks it up. The
# worktree dir is named after the branch, with any "/" flattened to "-" so the path
# stays valid (curato + "feature/foo" → ~/Code/Netronix/curato-feature-foo).
#   wt test                worktree ../<repo>-test        on branch "test"
#   wt feature/foo         worktree ../<repo>-feature-foo on branch "feature/foo"
#   wt hotfix origin/main  branch "hotfix" from an explicit start point
# Run from anywhere inside the repo (or one of its worktrees).
#
# A new branch starts from the *caller's* HEAD, matching plain `git worktree add -b`.
# Pass a start point to override.
#
# Creation runs under the per-target lock (see _wt_lock) and pre-validates the hook,
# so a misconfigured repository leaves no worktree and no branch behind. Preparation
# is the shared, unlocked `_wt_do_prepare`. The caller's Herdr handoff runs OUTSIDE
# the lock and only on success, so a long-lived workspace never holds the lock and a
# failed setup never opens a half-built worktree.
_wt_create_or_prepare() {
  emulate -L zsh
  local branch="$1" start="${2-}"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt <branch> [start-point]"; return 1; }
  local slug="${branch//\//-}" qb main common dest base=""
  qb="$(_wt_q "$branch")"
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  _wt_lock "$common" "$slug" || return 1
  {
    local created=1
    if [[ -d "$dest" ]]; then
      _wt_assert_worktree "$main" "$dest" "$branch" || return 1
      print -ru2 -- "wt: reopening $dest"; created=
      _wt_mise_reopen_carry "$main" "$dest" "$branch"
    else
      # Pre-validate before creating anything; _wt_hook_run still re-checks.
      _wt_hook_check "$main" >/dev/null 2>&1
      (( $? == 1 )) && { _wt_hook_check "$main"; return 1 }

      if _wt_git -C "$main" show-ref --quiet --verify "refs/heads/$branch"; then
        [[ -z "$start" ]] || {
          print -ru2 -- "wt: branch $qb already exists — drop the start point."; return 1 }
        _wt_git worktree add --lock --reason "$(_wt_herdr_lock_reason)" "$dest" "$branch" || return 1
      else
        # `base` (the branch whose checkout may vouch for mise config) is set only here, when
        # wt makes the branch; `from` is just the words for the message below.
        local from
        if [[ -n "$start" ]]; then
          base="$start" from="$start"
        elif base="$(_wt_git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
          from="$base"
        else
          base="" from="detached@$(_wt_git rev-parse --short HEAD 2>/dev/null)"
        fi
        print -r -- "wt: branching $qb from $from"
        _wt_git worktree add --lock --reason "$(_wt_herdr_lock_reason)" "$dest" -b "$branch" ${start:+"$start"} || return 1
      fi
    fi

    [[ -n "$created" ]] && { _wt_do_prepare "$main" "$dest" "$branch" "$slug" "$base" || return 1 }
  } always {
    _wt_unlock
  }

  typeset -g _WT_DEST="$dest"
}

# The `wt` command itself: create or reopen through the locked lifecycle above, then
# open the checkout as a native Herdr worktree workspace.
wt() {
  [[ -n "${1:-}" ]] || { print -ru2 -- "usage: wt <branch> [start-point]"; return 1; }
  _WT_NOTICE=
  _wt_create_or_prepare "$@" || return 1
  dev "$_WT_DEST"
}

# wt-prompt — interactive surface for Herdr's worktree popup. Kept tiny: everything
# else stays in wt, so the TUI cannot grow a second lifecycle implementation.
wt-prompt() {
  emulate -L zsh
  local branch
  print -n -- "Branch: "
  IFS= read -r branch || branch=""
  if [[ -z "$branch" ]]; then
    print -ru2 -- "wt: cancelled (no branch entered)."
    return 1
  fi
  wt "$branch"
  local rc=$?
  # Failures and the reopen's untrusted-config report are the lines Michael must be able to read; the popup
  # closes with the command, so hold it open for them.
  if (( rc != 0 )) || [[ -n "${_WT_NOTICE:-}" ]]; then
    print -r -- "Press Enter to close."
    IFS= read -r || true
  fi
  return $rc
}

# _wt_assert_worktree <root> <dest> <branch> — succeed only if <dest> is a worktree
# registered to <root> and currently on <branch>, so `wt` (reopen) and `wt-rm` refuse
# husks and slug collisions. Paths are resolved before comparison: git reports real
# paths, and ~/Code may sit behind a symlink.
_wt_assert_worktree() {
  emulate -L zsh
  local root="$1" dest="$2" branch="$3"
  local -a recs paths; local p
  recs=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} )
  for p in ${${(M)recs:#worktree *}#worktree }; do paths+=( "${p:A}" ); done
  if (( ! ${paths[(Ie)${dest:A}]} )); then
    print -ru2 -- "wt: $dest is not a registered worktree of $root."
    print -ru2 -- "    Leftover directory? Remove it, or use a different branch name."
    return 1
  fi
  local have; have="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)"
  if [[ "$have" != "$branch" ]]; then
    print -ru2 -- "wt: $dest is on '${have:-a detached HEAD}', not '$branch'."
    print -ru2 -- "    Branch names differing only by '/' vs '-' share one directory."
    return 1
  fi
}

# _wt_herdr_read <is-default> <session> — load one running session's workspace and pane
# lists into _WT_HWS and _WT_HPANES. 0 loaded, 3 server not running, 1 unusable answer.
_wt_herdr_read() {
  emulate -L zsh
  local session="$2" kind out rc
  # Always --session, the default included: a bare call follows HERDR_SOCKET_PATH or
  # HERDR_SESSION, which can name another session than the one being read.
  local -a hargs=(--session "$session")
  for kind in workspace pane; do
    out="$(command herdr $hargs $kind list 2>&1)"; rc=$?
    if (( rc )) || ! print -r -- "$out" | jq -e . >/dev/null 2>&1; then
      print -ru2 -- "wt-rm: Herdr session '$session' returned an invalid $kind list — refusing."
      return 1
    fi
    print -r -- "$out" | jq -e 'type == "object" and .error.code? == "server_not_running"' \
      >/dev/null 2>&1 && return 3
    if ! print -r -- "$out" | jq -e --arg k "${kind}s" \
        'type == "object" and (.result[$k] | type == "array") and (has("error") | not)' \
        >/dev/null 2>&1; then
      print -ru2 -- "wt-rm: Herdr session '$session' returned an unexpected $kind list — refusing."
      return 1
    fi
    if [[ "$kind" == workspace ]]; then typeset -g _WT_HWS="$out"; else typeset -g _WT_HPANES="$out"; fi
  done
  return 0
}

_wt_herdr_label() {
  print -r -- "$_WT_HWS" | jq -r --arg w "$1" \
    '[.result.workspaces[] | select(.workspace_id == $w) | (.label // "")][0] // ""' 2>/dev/null
}

# _wt_herdr_classify <dest> — from the loaded session, _WT_OWN is every workspace whose
# provenance is exactly <dest>; _WT_FOREIGN describes every other pane or workspace in it.
# Pane cwd follows `cd`, so it never makes a workspace own.
_wt_herdr_classify() {
  emulate -L zsh
  local dest="$1" i
  local -a recs
  typeset -ga _WT_OWN _WT_FOREIGN
  _WT_OWN=() _WT_FOREIGN=()
  recs=( ${(0)"$(print -r -- "$_WT_HWS" | jq -j '
    .result.workspaces[]
    | select((.worktree.checkout_path? | type) == "string" and (.worktree.checkout_path | length) > 0)
    | (.workspace_id | if type == "string" and length > 0 then . else error("workspace without id") end),
      "\u0000", .worktree.checkout_path, "\u0000"')"} ) || return 1
  (( ${#recs} % 2 == 0 )) || return 1
  for (( i = 1; i <= ${#recs}; i += 2 )); do
    if [[ "${recs[i+1]:A}" == "$dest" ]]; then
      _WT_OWN+=( "${recs[i]}" )
    elif [[ "${recs[i+1]:A}" == "$dest"/* ]]; then
      _WT_FOREIGN+=( "workspace ${recs[i]} '$(_wt_herdr_label "${recs[i]}")' is for ${recs[i+1]}, inside the checkout" )
    fi
  done
  recs=( ${(0)"$(print -r -- "$_WT_HPANES" | jq -j --arg d "$dest" '
    .result.panes[]
    | select((.cwd | type) == "string" and (.cwd == $d or (.cwd | startswith($d + "/"))))
    | (.workspace_id | if type == "string" and length > 0 then . else error("pane without workspace id") end),
      "\u0000", (.pane_id // "?" | tostring), "\u0000", .cwd, "\u0000"')"} ) || return 1
  (( ${#recs} % 3 == 0 )) || return 1
  for (( i = 1; i <= ${#recs}; i += 3 )); do
    (( ${_WT_OWN[(Ie)${recs[i]}]} )) && continue
    _WT_FOREIGN+=( "pane ${recs[i+1]} of workspace ${recs[i]} '$(_wt_herdr_label "${recs[i]}")' is at ${recs[i+2]}" )
  done
  return 0
}

# A stopped session's session.json can restore panes into the checkout later. Herdr's
# versioned state is never rewritten here: detect a reference and require the session
# to be started so the public close API can remove it. Return 0 match, 1 no match or
# no state, 2 unreadable or unknown schema.
_wt_stopped_herdr_has_checkout() {
  emulate -L zsh
  local session="$1" session_dir="$2" dest="${3:A}" n
  # Own line: a `local` expands all its arguments before assigning any, so on the line
  # above `$session_dir` would be the caller's.
  local state="$session_dir/session.json"
  [[ -e "$state" ]] || return 1
  if [[ ! -r "$state" ]] || ! jq -e \
      'type == "object" and .version == 3 and (.workspaces | type == "array")' \
      "$state" >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: stopped Herdr session '$session' has unreadable or unknown persisted state — refusing."
    return 2
  fi
  n="$(jq -r --arg d "$dest" '
    [.workspaces[]
      | select([.. | objects | (.cwd?, .checkout_path?)
                | select(type == "string" and (. == $d or startswith($d + "/")))]
               | length > 0)]
    | length
  ' "$state")" || {
    print -ru2 -- "wt-rm: could not inspect stopped Herdr session '$session' — refusing."
    return 2
  }
  (( n > 0 )) && return 0
  return 1
}

# Close the checkout's own Herdr workspaces, after refusing if anything else is in it.
# Spec: docs/superpowers/specs/2026-10-01-herdr-wt-simplification-design.md §1.
_wt_stop_herdr_workspaces() {
  emulate -L zsh
  setopt local_options pipe_fail
  (( $+commands[herdr] )) || return 0
  (( $+commands[jq] )) || {
    print -ru2 -- "wt-rm: jq is unavailable, so Herdr workspace state cannot be verified — refusing."
    return 1
  }
  local dest="${1:A}" listing rc count i name is_default running session_dir sock caller="" default_name="" state id close_out f
  local -a tname tdefault trunning tdir hargs
  local -A own
  listing="$(command herdr session list --json 2>&1)"; rc=$?
  if (( rc )) || ! print -r -- "$listing" | jq -e \
      'type == "object" and (.sessions | type == "array") and
       all(.sessions[]; (.name | type == "string" and length > 0) and
                        (.default | type == "boolean") and
                        (.running | type == "boolean") and
                        (.session_dir | type == "string" and length > 0) and
                        ((.socket_path // "") | type == "string"))' \
      >/dev/null 2>&1; then
    print -ru2 -- "wt-rm: Herdr returned an invalid session list — refusing."
    return 1
  fi
  count="$(print -r -- "$listing" | jq -r '.sessions | length')" || return 1
  for (( i = 0; i < count; i++ )); do
    name="$(print -r -- "$listing" | jq -er --argjson i "$i" '.sessions[$i].name')" || return 1
    is_default="$(print -r -- "$listing" | jq -r --argjson i "$i" '.sessions[$i].default | tostring')" || return 1
    running="$(print -r -- "$listing" | jq -r --argjson i "$i" '.sessions[$i].running | tostring')" || return 1
    session_dir="$(print -r -- "$listing" | jq -er --argjson i "$i" '.sessions[$i].session_dir')" || return 1
    sock="$(print -r -- "$listing" | jq -r --argjson i "$i" '.sessions[$i].socket_path // ""')" || return 1
    if [[ "$is_default" != true && "$name" != "${HERDR_SESSION:-}" ]]; then
      print -ru2 -- "wt-rm: Herdr session '$name' exists, and wt-rm handles only the default session — refusing."
      print -ru2 -- "    Stop and delete it (herdr session delete $(_wt_q "$name")), then retry command wt-rm."
      return 1
    fi
    [[ "$is_default" == true ]] && default_name="$name"
    [[ -n "${HERDR_SOCKET_PATH:-}" && "$sock" == "$HERDR_SOCKET_PATH" ]] && caller="$name"
    tname+=( "$name" ); tdefault+=( "$is_default" ); trunning+=( "$running" ); tdir+=( "$session_dir" )
  done
  [[ -n "$caller" ]] || caller="$default_name"

  # Pass 1: every refusal is decided before anything closes.
  for (( i = 1; i <= ${#tname}; i++ )); do
    name="${tname[i]}"
    if [[ "${trunning[i]}" != true ]]; then
      _wt_stopped_herdr_has_checkout "$name" "${tdir[i]}" "$dest"; state=$?
      case "$state" in
        0)
          print -ru2 -- "wt-rm: stopped Herdr session '$name' still remembers $dest — refusing."
          if [[ "${tdefault[i]}" == true ]]; then
            print -ru2 -- "    Start it with: herdr    then retry command wt-rm."
          else
            print -ru2 -- "    Start it with: herdr session attach $(_wt_q "$name")    then retry command wt-rm."
          fi
          return 1 ;;
        1) continue ;;
        *) return 1 ;;
      esac
    fi
    _wt_herdr_read "${tdefault[i]}" "$name"; state=$?
    if (( state == 3 )); then
      print -ru2 -- "wt-rm: Herdr session '$name' reported running but its API is unreachable — refusing."
      return 1
    fi
    (( state == 0 )) || return 1
    _wt_herdr_classify "$dest" || {
      print -ru2 -- "wt-rm: could not read Herdr workspace state in session '$name' — refusing."
      return 1
    }
    if (( ${#_WT_FOREIGN} )); then
      print -ru2 -- "wt-rm: other Herdr workspaces in session '$name' are using $dest — refusing."
      for f in $_WT_FOREIGN; do print -ru2 -- "    $f"; done
      print -ru2 -- "    Move them out of the checkout or close them, then retry command wt-rm."
      return 1
    fi
    if [[ "$name" == "$caller" && -n "${HERDR_WORKSPACE_ID:-}" ]] \
       && (( ${_WT_OWN[(Ie)$HERDR_WORKSPACE_ID]} )); then
      print -ru2 -- "wt-rm: this shell runs in Herdr workspace $HERDR_WORKSPACE_ID, which belongs to $dest — run wt-rm from another workspace."
      return 1
    fi
    own[$name]="${(j: :)_WT_OWN}"
  done

  # Pass 2: close the own workspaces, then confirm nothing is left in the checkout.
  for (( i = 1; i <= ${#tname}; i++ )); do
    [[ "${trunning[i]}" == true ]] || continue
    name="${tname[i]}"
    hargs=(--session "$name")
    for id in ${(s: :)own[$name]}; do
      close_out="$(command herdr $hargs workspace close "$id" 2>&1)"; rc=$?
      if (( rc )) \
        || { [[ -n "$close_out" ]] && ! print -r -- "$close_out" | jq -e . >/dev/null 2>&1; } \
        || { [[ -n "$close_out" ]] && print -r -- "$close_out" | jq -e \
               'type == "object" and has("error")' >/dev/null 2>&1; }; then
        print -ru2 -- "wt-rm: could not close Herdr workspace '$id' in session '$name' — refusing to remove $dest."
        return 1
      fi
    done
    _wt_herdr_read "${tdefault[i]}" "$name"; state=$?
    if (( state == 3 )); then
      print -ru2 -- "wt-rm: Herdr session '$name' became unreachable before workspace closure could be verified — refusing."
      return 1
    fi
    (( state == 0 )) || return 1
    _wt_herdr_classify "$dest" || return 1
    if (( ${#_WT_OWN} || ${#_WT_FOREIGN} )); then
      print -ru2 -- "wt-rm: Herdr session '$name' still has workspace(s) at $dest after close — refusing."
      return 1
    fi
  done
  return 0
}

# _wt_branch_content_merged — true when <branch> would add nothing to <base>.
#
# `git branch -d` asks an ancestry question, which a squash-merge (GitLab's default)
# answers no by construction. This asks instead whether merging would still change
# anything: `merge-tree --write-tree` merges in memory, and if the resulting tree is
# the base's own tree the branch contributes nothing.
#
# Do not compare the two tip trees (`git diff base branch`) instead: that holds only
# while the base's tip IS the squash commit, and stops working after the next
# unrelated merge.
#
# Both the local base and the remote's default branch count. Fails closed: no base,
# an unmergeable branch, or a git without --write-tree all keep the branch.
_wt_branch_content_merged() {
  emulate -L zsh
  local main="$1" branch="$2" base merged want mb
  local -a bases
  base="$(_wt_git -C "$main" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
    && bases+=("$base")
  base="$(_wt_git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" \
    && bases+=("$base")
  (( ${#bases} )) || return 1
  for base in $bases; do
    [[ -n "$base" && "$base" != "$branch" ]] || continue
    # Require a real diff against the merge-base: wt-rm never force-deletes a branch
    # carrying commits the base lacks, however empty they are.
    mb="$(_wt_git -C "$main" merge-base "$base" "$branch" 2>/dev/null)" || continue
    _wt_git -C "$main" diff --quiet "$mb" "$branch" 2>/dev/null && continue
    merged="$(_wt_git -C "$main" merge-tree --write-tree "$base" "$branch" 2>/dev/null)" || continue
    merged="${merged%%$'\n'*}"
    want="$(_wt_git -C "$main" rev-parse "$base^{tree}" 2>/dev/null)" || continue
    [[ -n "$merged" && "$merged" == "$want" ]] && return 0
  done
  return 1
}

# _wt_worktree_record <root> <dest> — Git's record of the worktree at <dest>, quietly.
# 0 registered (its branch, or "" when detached, in _WT_REC_BRANCH), 1 not registered,
# 2 Git's worktree list cannot be read. An empty list is a failed read: the main
# checkout is always in a real one.
_wt_worktree_record() {
  emulate -L zsh
  local root="$1" dest="${2:A}" rec wt_path rc in_target=0 found=0
  local -a fields
  typeset -g _WT_REC_BRANCH=""
  fields=( ${(0)"$(_wt_git -C "$root" worktree list --porcelain -z 2>/dev/null)"} ); rc=$?
  (( rc || ! ${#fields} )) && return 2
  for rec in $fields; do
    if [[ "$rec" == 'worktree '* ]]; then
      wt_path="${rec#worktree }"
      in_target=0
      [[ "${wt_path:A}" == "$dest" ]] && { in_target=1; found=1 }
    elif (( in_target )) && [[ "$rec" == 'branch refs/heads/'* ]]; then
      _WT_REC_BRANCH="${rec#branch refs/heads/}"
    fi
  done
  (( found )) && return 0
  return 1
}

# _wt_rm_lock_class <main> <dest> — 0 Herdr-owned (crossed with Git's double force),
# 1 unlocked, 2 refused: another owner's lock, or lock state that cannot be read.
_wt_rm_lock_class() {
  emulate -L zsh
  _wt_git_lock_state "$1" "$2"
  case $? in
    0) [[ "$_WT_GIT_LOCK_REASON" == "$(_wt_herdr_lock_reason)" ]] && return 0
       print -ru2 -- "wt-rm: $2 is locked for another reason: ${_WT_GIT_LOCK_REASON:-<no reason>}"
       print -ru2 -- "    Unlock it yourself only if that owner no longer needs it."
       return 2 ;;
    1) return 1 ;;
    *) return 2 ;;
  esac
}

# _wt_rm_branch <main> <branch> <qb> — delete a removed worktree's branch if its work
# is merged; keeping it is not a failure.
_wt_rm_branch() {
  emulate -L zsh
  local main="$1" branch="$2" qb="$3"
  # -d first, stderr suppressed: its refusal is not a verdict, since a squash-merged
  # branch fails -d. Only if the content test also declines is the work unmerged.
  if ! _wt_git -C "$main" branch -d "$branch" 2>/dev/null; then
    if _wt_branch_content_merged "$main" "$branch" \
       && _wt_git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
      print -r -- "✓ deleted branch $qb (squash-merged — its content is already in the base)"
    else
      print -ru2 -- "wt-rm: branch $qb kept (not fully merged) — inspect or merge it before deleting it explicitly."
    fi
  fi
  return 0
}

# _wt_rm_registration <main> <dest> <branch> <qb> — finish a removal that deleted the
# checkout but not Git's registration of it. Runs under wt-rm's lock, when $dest is
# not a directory.
#
# Absence is proven, not inferred: a denied stat fails exactly like a missing path, and
# Git's own prunable test with it. $dest's parent also holds the main checkout, so a
# listing that lacks the main checkout is a listing that failed.
_wt_rm_registration() {
  emulate -L zsh
  local main="$1" dest="$2" branch="$3" qb="$4"
  local -a names
  if [[ -e "$dest" || -L "$dest" ]]; then
    print -ru2 -- "wt-rm: $dest does not exist."
    return 1
  fi
  names=( "${dest:h}"/*(DN:t) )
  if (( ! ${names[(Ie)${main:t}]} || ${names[(Ie)${dest:t}]} )); then
    print -ru2 -- "wt-rm: cannot confirm $dest is gone — ${dest:h} cannot be listed reliably. Refusing."
    return 1
  fi
  _wt_worktree_record "$main" "$dest"
  case $? in
    0) ;;
    1) print -ru2 -- "wt-rm: $dest does not exist."; return 1 ;;
    *) print -ru2 -- "wt-rm: cannot read Git's worktree list — refusing."; return 1 ;;
  esac
  if [[ "$_WT_REC_BRANCH" != "$branch" ]]; then
    print -ru2 -- "wt-rm: Git's registration of $dest is on '${_WT_REC_BRANCH:-a detached HEAD}', not '$branch' — refusing."
    return 1
  fi

  local herdr_owned=0
  _wt_rm_lock_class "$main" "$dest"
  case $? in
    0) herdr_owned=1 ;;
    1) ;;
    *) return 1 ;;
  esac
  _wt_stop_herdr_workspaces "$dest" || return 1

  print -ru2 -- "wt-rm: $dest is already gone — finishing its removal without re-running teardown."
  print -ru2 -- "    If it was deleted by hand rather than by an interrupted wt-rm, reclaim its resources yourself."
  local -a remove_args
  remove_args=(worktree remove "$dest")
  (( herdr_owned )) && remove_args=(worktree remove --force --force "$dest")
  if ! _wt_git -C "$main" $remove_args; then
    print -ru2 -- "wt-rm: removing Git's registration of $dest failed — it remains; branch $qb kept."
    print -ru2 -- "    Fix the obstruction Git reported above, then retry: wt-rm $qb"
    return 1
  fi
  print -r -- "✓ removed Git's registration of $dest"
  _wt_rm_branch "$main" "$branch" "$qb"
}

# wt-rm <branch> — retire a worktree made by `wt`. Run from another checkout of the
# same repo, never from inside the one being removed.
#
# Each step is guarded right before it happens, and every check fails closed:
#   1. check 1 (_wt_clean), hook validation and the lock classification, then the mise trust
#      carry (_wt_mise_trust, only when the hook is valid): all before anything is
#      disrupted, the carry last because it is the one that writes
#   2. stop the checkout's Herdr workspaces: a live process holding the directory
#      open is how a husk is left behind, so this must come first
#   3. check 2, because shutdown can flush files (a live app writing on exit)
#   4. the mise trust re-check (_wt_mise_show, read-only, only when the hook is valid),
#      because shutdown can also rewrite a git-ignored mise config check 2 cannot see;
#      then the .worktreehook teardown verb, idempotent so a retry re-runs it
#   5. check 3, tying non-ignored teardown output to its cause
#   6. release the checkout's Codex sessions (`xreview-rpc release`): the daemon keeps a
#      thread's MCP helpers running in the checkout for ~60 s after its TUI goes. Only
#      exit 0 or 5 continues; any other status may have left a session archived.
#   7. check 4 (`wt-teardown scan`), last before Git deletes files: it reads the OS,
#      which Git and Herdr cannot see. After teardown because stopping project
#      services is what teardown is for. It re-scans every 0.5 s for up to 5 s, since
#      some processes exit only after their workspace closes. A heuristic, not a proof.
#
# A checkout that is gone while Git still registers it — a removal that failed after
# deleting it — skips hook validation, the mise trust checks, checks 1-4, teardown and the release (steps 1 and 3-7):
# _wt_rm_registration proves the absence, reruns the lock classification and step 2,
# and removes only the registration.
#
# Runs under the per-target lock, released in an `always` block. An interrupt is not
# covered by it; see the interruption note above _wt_hook_check for why no INT/TERM
# trap is installed.
wt-rm() {
  emulate -L zsh
  local branch="$1"
  [[ -n "$branch" ]] || { print -ru2 -- "usage: wt-rm <branch>"; return 1; }
  local slug="${branch//\//-}" qb main common dest rel_dir=""
  qb="$(_wt_q "$branch")"
  main="$(_wt_primary)" || return 1
  common="$(_wt_git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dest="${main:h}/${main:t}-${slug}"

  _wt_lock "$common" "$slug" || return 1
  {
    [[ -d "$dest" ]] || { _wt_rm_registration "$main" "$dest" "$branch" "$qb"; return }
    _wt_assert_worktree "$main" "$dest" "$branch" || return 1

    local here; here="$(_wt_git rev-parse --path-format=absolute --show-toplevel 2>/dev/null)"
    [[ "${here:A}" == "${dest:A}" ]] && {
      print -ru2 -- "wt-rm: you're inside $dest — run this from another checkout."; return 1 }

    # Check 1 — before anything is disrupted. `*`, not `2`, so that anything which
    # is not a definite 0 fails closed rather than reading as "clean".
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: $dest has uncommitted changes — commit, stash or discard them first."; return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean — refusing."
         _wt_git -C "$dest" status --porcelain >/dev/null; return 1 ;;
    esac

    # Hook configuration, still before anything is disrupted. Its status is kept: only a
    # valid hook (0) opts the repository in to the mise trust checks below.
    local -i hook_rc
    _wt_hook_check "$main" >/dev/null 2>&1
    hook_rc=$?
    (( hook_rc == 1 )) && { _wt_hook_check "$main"; return 1 }

    # Classify the Git lock before stopping anything. Only our exact reason
    # authorizes the double-force removal; any other lock is a preservation request.
    local herdr_owned=0
    _wt_rm_lock_class "$main" "$dest"
    case $? in
      0) herdr_owned=1 ;;
      1) ;;
      *) return 1 ;;
    esac

    # Mise trust, last of the checks that write nothing and before the first Herdr call: the
    # teardown hook runs mise in $dest, and a config nobody has looked at must not load
    # there. Carries what an already-trusted checkout vouches for; refuses the rest.
    if (( hook_rc == 0 )) && ! _wt_mise_trust "$main" "$dest"; then
      print -ru2 -- "wt-rm: nothing was closed or removed — review the mise config above, then: wt-rm $qb"
      return 1
    fi

    # Close the checkout's own Herdr workspaces; refuse first if anything else is in it (spec §1).
    _wt_stop_herdr_workspaces "$dest" || return 1

    # Check 2 — closing the workspaces can flush files into the checkout.
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: closing Herdr workspaces left changes in $dest — inspect it, then retry."; return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean after closing Herdr workspaces — refusing."; return 1 ;;
    esac

    # Mise trust again, read-only: closing the workspaces can rewrite a git-ignored mise config
    # that check 2 does not see, and the hook must not run against one nobody has trusted.
    if (( hook_rc == 0 )); then
      local mise_line mise_shown
      local -a mise_untrusted
      if ! mise_shown="$(_wt_mise_show "$dest")"; then
        print -ru2 -- "wt-rm: cannot read mise's trust status for $(_wt_tilde "$dest") — teardown not run, Herdr workspaces closed."
        print -ru2 -- "    Review the mise config, then retry: wt-rm $qb"
        return 1
      fi
      for mise_line in ${(f)mise_shown}; do
        [[ "$mise_line" == untrusted$'\t'* ]] && mise_untrusted+=( "${mise_line#untrusted$'\t'}" )
      done
      if (( $#mise_untrusted )); then
        print -ru2 -- "wt-rm: $(_wt_tilde "$dest") has untrusted mise config (${(j:, :)mise_untrusted}) — teardown not run, Herdr workspaces closed."
        print -ru2 -- "    Review the mise config, then retry: wt-rm $qb"
        return 1
      fi
    fi

    if ! _wt_hook_run "$main" "$dest" "$branch" "$slug" teardown; then
      print -ru2 -- "wt-rm: .worktreehook teardown failed — $dest kept, Herdr workspaces closed."
      print -ru2 -- "    Fix it and retry: wt-rm $qb    (teardown is idempotent)"
      print -ru2 -- "    Or resume work with: wt-prepare $qb && wt $qb"
      return 1
    fi

    # Check 3 — ties non-ignored hook output to its cause, before Git's more
    # generic removal refusal appears one step later.
    _wt_clean "$dest"
    case $? in
      0) ;;
      1) print -ru2 -- "wt-rm: teardown left changes in $dest — removal aborted. Resources may already be reclaimed."
         print -ru2 -- "    Hook output must be git-ignored or written outside the worktree."
         return 1 ;;
      *) print -ru2 -- "wt-rm: cannot determine whether $dest is clean after teardown — refusing. Resources may already be reclaimed."
         return 1 ;;
    esac

    # Release the checkout's Codex sessions, which check 4 would otherwise find: the daemon
    # unloads an idle thread, and stops its MCP helpers, only ~60 s after its TUI goes. Exit
    # 5 is the command's own statement that the daemon is unreachable and no restore is owed
    # here; every other failure, a killed release included, may have left a session archived,
    # so the checkout stays for the retry to restore it. Spec:
    # docs/superpowers/specs/2026-10-15-wt-rm-codex-session-release-design.md
    local rel_line
    local -i rel_rc
    rel_dir="$(command mktemp -d "${TMPDIR:-/tmp}/wt-rm-release.XXXXXX")" || {
      print -ru2 -- "wt-rm: cannot create a scratch directory to release Codex sessions — refusing."
      return 1
    }
    # stdout (the "released <id>" lines) goes to a file and stderr is kept whole for a
    # refusal; its "waiting for ..." progress lines (the lock held by another release, the
    # ephemeral wait of up to 90 s) reach the terminal at once so a wait never looks like a
    # hang. pipestatus[1] is the release's own status, a signal's 128+n included.
    { command xreview-rpc release --dir "$dest" 2>&1 >"$rel_dir/out" } \
      | command tee "$rel_dir/err" \
      | command grep --line-buffered '^xreview-rpc: waiting for ' >&2
    rel_rc=${pipestatus[1]}
    # Reported for every status, so an id released before a later failure is not lost.
    for rel_line in ${(f)"$(<$rel_dir/out)"}; do
      [[ "$rel_line" == "released "* ]] && print -r -- "✓ released Codex session ${rel_line#"released "}"
    done
    case $rel_rc in
      0) ;;
      5) print -ru2 -- "wt-rm: the Codex daemon is not reachable — continuing; check 4 decides." ;;
      *) print -ru2 -- "wt-rm: could not release the Codex sessions in $dest (status $rel_rc) — removal aborted. Resources may already be reclaimed."
         for rel_line in ${(f)"$(<$rel_dir/err)"}; do print -ru2 -- "    $rel_line"; done
         print -ru2 -- "    Then retry: wt-rm $qb"
         return 1 ;;
    esac

    # Check 4 — the last witness before Git deletes anything, and the only one that
    # asks the OS. After teardown, so a repository that stops its own services is
    # not refused. What the snapshot cannot see: `_scan` in
    # dot_local/bin/executable_wt-teardown.
    local busy line polls=0
    while :; do
      busy="$(WT_WORKTREE="$dest" command wt-teardown scan)" || {
        print -ru2 -- "wt-rm: could not scan for processes still in $dest — refusing."
        return 1
      }
      [[ -z "$busy" ]] && break
      (( polls == 10 )) && break
      command sleep 0.5
      (( ++polls ))
    done
    if [[ -n "$busy" ]]; then
      print -ru2 -- "wt-rm: $dest is still in use by a running process after waiting 5 s — removal aborted. Resources may already be reclaimed."
      for line in ${(f)busy}; do print -ru2 -- "    $line"; done
      print -ru2 -- "    Herdr's workspaces for this checkout are closed already; these are still in it."
      print -ru2 -- "    Stop them — from .worktreehook teardown if the project starts them — then retry: wt-rm $qb"
      return 1
    fi

    # Removal is the third post-shutdown failure mode (hook-protocol design §9.3). The
    # message reports what Git actually left, and offers only a route that works from it.
    local -a remove_args
    remove_args=(worktree remove "$dest")
    # The Git lock stays in force until removal: unlocking first opens an interrupt
    # window that leaves the checkout unprotected. The double-force form crosses it
    # and is used only for the exact lock reason above.
    (( herdr_owned )) && remove_args=(worktree remove --force --force "$dest")
    if ! _wt_git $remove_args; then
      local left=0 linked=0 working=0 reg top head listing lrc
      local -a entries
      [[ -e "$dest" || -L "$dest" ]] && left=1
      _wt_worktree_record "$main" "$dest"; reg=$?
      # The link is gone only if a listing of $dest, whose status is checked, lacks it: a
      # failed stat proves nothing, so a failed listing leaves the state unknown.
      if (( reg == 0 && left )); then
        listing="$(unset CLICOLOR_FORCE LS_COLORS; QUOTING_STYLE=literal LC_ALL=C command ls -A -- "$dest" 2>/dev/null)"; lrc=$?
        entries=( ${(f)listing} )
        if (( lrc )); then
          reg=2
        elif (( ${entries[(Ie).git]} )); then
          linked=1
        fi
      fi
      # A registered checkout that keeps its .git link is "kept" only when Git confirms it:
      # each read must succeed, not merely print the expected answer.
      if (( reg == 0 && linked )); then
        if top="$(_wt_git -C "$dest" rev-parse --path-format=absolute --show-toplevel 2>/dev/null)" \
           && head="$(_wt_git -C "$dest" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
           && [[ "${top:A}" == "${dest:A}" && "$head" == "$branch" ]]; then
          working=1
        else
          reg=2
        fi
      fi
      if (( reg == 2 )); then
        print -ru2 -- "wt-rm: removing $dest failed, and Git's state cannot be read to tell what remains. Herdr workspaces closed, teardown done; branch $qb kept."
        print -ru2 -- "    Check $dest and \`git worktree list\` yourself before retrying."
      elif (( reg == 0 && working )); then
        print -ru2 -- "wt-rm: removing $dest failed — worktree kept, Herdr workspaces closed. Resources may already be reclaimed."
        print -ru2 -- "    Fix the obstruction and retry: wt-rm $qb    (teardown is idempotent)"
        print -ru2 -- "    Or resume work with: wt-prepare $qb && wt $qb"
      elif (( reg == 0 && left )); then
        print -ru2 -- "wt-rm: removing $dest failed partway — the checkout is partly deleted and no longer a working checkout, but Git's registration of it remains. Herdr workspaces closed, teardown done; branch $qb kept."
        print -ru2 -- "    Fix the obstruction Git reported above, delete what is left in $dest yourself, then finish with: wt-rm $qb"
      elif (( reg == 0 )); then
        print -ru2 -- "wt-rm: removing $dest failed partway — the checkout is deleted, but Git's registration of it remains. Herdr workspaces closed, teardown done; branch $qb kept."
        print -ru2 -- "    Fix the obstruction Git reported above, then finish with: wt-rm $qb"
      elif (( left )); then
        print -ru2 -- "wt-rm: removing $dest failed partway — Git's registration of it is removed, but the directory remains and is no longer a worktree. Herdr workspaces closed, teardown done; branch $qb kept."
        print -ru2 -- "    Inspect what is left in $dest and delete it yourself, then delete the branch if its work is merged: git branch -d $qb"
      else
        print -ru2 -- "wt-rm: removing $dest failed partway — Git's registration of it is removed, and nothing is left at $dest. Herdr workspaces closed, teardown done; branch $qb kept."
        print -ru2 -- "    Delete the branch if its work is merged: git branch -d $qb"
      fi
      return 1
    fi
    print -r -- "✓ removed worktree $dest"

    _wt_rm_branch "$main" "$branch" "$qb"

    [[ -d "$dest" ]] \
      && print -ru2 -- "wt-rm: $dest still exists (files recreated during removal) — remove it manually."
    return 0
  } always {
    _wt_unlock
    [[ -n "$rel_dir" ]] && command rm -rf -- "$rel_dir"
  }
}

# chezmoi apply and update deploy only origin's main (spec 2026-10-16, sandbox write boundary,
# section 3). The checkout cannot prove what was reviewed: a sandboxed command can commit to
# it, hide files from git status, add replace refs or forge objects. So the checkout must be a
# clean main equal to origin's, and chezmoi reads a fresh clone of that commit instead of it.
# The previews run the working tree's code too (modify_ scripts, template output calls), so
# diff, status, cat, verify, dump, archive and execute-template take the same path. merge and
# merge-all write into the source, which a temporary clone would lose: they are refused.
# Origin is the pinned URL below, never the checkout's remote.origin.url, which the sandbox can
# write. CHEZMOI_REVIEWED_ORIGIN overrides it from the wrapper's own environment, for the suite.
# --dirty-ok runs the working tree anyway, for a deliberate local change.
# _chezmoi_short <token> <letters> <subcommand>: true when <token> is a single-dash option group
# that names one of <letters> before a letter taking a value (the rest of the group is that
# value). Which letters take a value depends on the subcommand (chezmoi 2.73.2): -f is --format
# for dump and archive but --file for execute-template, -p is --path-style for status and
# --promptString for execute-template but --purge for init, -i is --init for execute-template,
# -d and -C take a value only for init. A letter wrongly counted as a value would hide a later
# -S from the scan, so only the letters that are values for that subcommand stop it.
_chezmoi_short() {
  emulate -L zsh
  local t=${1#-} c vals
  [[ $1 == -[!-]* ]] || return 1
  case ${3:-} in
    execute-template) vals=cDoSWp ;;
    dump|archive) vals=cDoSWxif ;;
    status) vals=cDoSWxip ;;
    init) vals=cDoSWxidC ;;
    *) vals=cDoSWxi ;;
  esac
  while [[ -n $t ]]; do
    c=${t[1]}; t=${t[2,-1]}
    [[ $2 == *$c* ]] && return 0
    [[ $vals == *$c* ]] && return 1
  done
  return 1
}
# _chezmoi_help <args>: true when an exact -h or --help token, or a short group with h ahead of
# any value letter and no =, comes before any --. The caller never forwards these arguments, it
# runs `chezmoi help <subcommand>`, so a wrong answer here costs a help page or a normal check,
# never an apply. Every = form (--help=false, -h=false, -vh=false) is not help: pflag reads them
# as help=false and runs the command, so they take the normal checks.
_chezmoi_help() {
  emulate -L zsh
  local a
  for a in "$@"; do
    [[ $a == -- ]] && return 1
    [[ $a == (-h|--help) ]] && return 0
    [[ $a != *=* ]] && _chezmoi_short "$a" h "$1" && return 0
  done
  return 1
}
chezmoi() {
  # The caller's options (SH_GLOB, KSH_ARRAYS, EXTENDED_GLOB, NO_GLOB...) would break the
  # patterns and array indexing below, so every wrapper function runs under zsh's defaults.
  emulate -L zsh
  local -a args=("$@")
  local sub=${1:-} a i
  if _chezmoi_help "$@"; then
    # No extended glob here: `emulate -L zsh` leaves EXTENDED_GLOB off, where a trailing `#` is a
    # literal. A plain word is a letter or digit first, then only letters, digits and hyphens.
    if [[ $sub == [A-Za-z0-9]* && $sub != *[^A-Za-z0-9-]* ]]; then command chezmoi help "$sub"; else command chezmoi help; fi
    return
  fi
  # chezmoi takes global options before the subcommand, some with a value, and a parser that
  # misses one would read the value as the subcommand and let apply through. So a command
  # that names one of the commands handled below must put the subcommand first. An empty first
  # argument counts too: cobra skips "" when it looks for the subcommand, so `chezmoi "" init
  # --apply` runs `init --apply`. (A whitespace-only word, an upper-case name or an abbreviation
  # is an unknown command to cobra, which runs a `chezmoi-<name>` plugin from PATH: `chezmoi " "
  # apply` ran `chezmoi- `. That does not get past the gate on the default PATH: no directory
  # on it is sandbox-writable after this branch's write-set change. direnv can add one while
  # Michael is in a repository (PATH_add, layout node, a mise _.path), where a sandbox-written
  # `chezmoi-<name>` would run if he typed that unknown subcommand.)
  if [[ $sub == -* || ( $# -gt 0 && -z $sub ) ]]; then
    for a in apply update diff status cat verify dump archive execute-template merge merge-all init edit; do
      if (( ${args[(Ie)$a]} )); then
        print -u2 "chezmoi: put the subcommand first, e.g. chezmoi $a -v"
        return 1
      fi
    done
    command chezmoi "$@"; return
  fi
  case $sub in
    apply|update|diff|status|cat|verify|dump|archive|execute-template) ;;
    merge|merge-all) ;;
    init|edit)
      # Every spelling that would apply the working tree: --apply, --one-shot, --watch (each
      # also as --flag=<value>) and -a anywhere in a short-option group.
      for a in "${args[@]:1}"; do
        if [[ $a == --apply || $a == --apply=* ]] || _chezmoi_short "$a" a "$sub"; then
          print -u2 "chezmoi: $sub --apply is refused; run chezmoi apply, which deploys origin's main"
          return 1
        fi
        if [[ $sub == init && ( $a == --one-shot || $a == --one-shot=* ) ]]; then
          print -u2 "chezmoi: init --one-shot is refused; run chezmoi apply, which deploys origin's main"
          return 1
        fi
        if [[ $sub == edit && ( $a == --watch || $a == --watch=* ) ]]; then
          print -u2 "chezmoi: edit --watch is refused; run chezmoi apply, which deploys origin's main"
          return 1
        fi
        # edit --init (long form only; -i on edit is --include) recreates the config from the
        # checkout's .chezmoi.toml.tmpl, which is what refusing init protects. Any value is refused.
        if [[ $sub == edit && ( $a == --init || $a == --init=* ) ]]; then
          print -u2 "chezmoi: edit --init is refused; run chezmoi apply --init, which renders the config from origin's main"
          return 1
        fi
      done
      if [[ $sub == init ]]; then
        # init renders the checkout's .chezmoi.toml.tmpl into the config every later apply trusts.
        print -u2 "chezmoi: init is refused; run chezmoi apply --init, which renders the config from origin's main"
        return 1
      fi
      command chezmoi "$@"; return ;;
    *) command chezmoi "$@"; return ;;
  esac
  # Every git read below judges the real objects, never a replacement.
  local -x GIT_NO_REPLACE_OBJECTS=1
  if (( ${args[(Ie)--dirty-ok]} )); then
    command chezmoi "${(@)args:#--dirty-ok}"; return
  fi
  if [[ $sub == (merge|merge-all) ]]; then
    print -u2 "chezmoi: refusing $sub: it writes the merged result into the source, and a temporary clone would lose it (chezmoi $sub --dirty-ok runs on the working tree)"
    return 1
  fi
  for (( i = 1; i <= $#args; i++ )); do
    a=${args[i]}
    # An option that picks the source or the configuration would undo the choice below.
    if [[ $a == (--source|--source=*|--working-tree|--working-tree=*|--config|--config=*) ]] \
       || _chezmoi_short "$a" SWc "$sub"; then
      print -u2 "chezmoi: refusing $sub with $a: the wrapper chooses the source (--dirty-ok passes everything through)"
      return 1
    fi
    # --mode symlink would link the targets into the clone, which is removed afterwards.
    if [[ $a == --mode=* && $a != --mode=file ]] || [[ $a == --mode && ${args[i+1]:-} != file ]]; then
      print -u2 "chezmoi: refusing $sub with $a ${args[i+1]:-}: only --mode file works from a temporary clone (--dirty-ok passes everything through)"
      return 1
    fi
    # update's own flags would be forwarded to apply, which does not know them.
    if [[ $sub == update ]] && { [[ $a == (--apply|--apply=*|--recurse-submodules|--recurse-submodules=*) ]] \
       || _chezmoi_short "$a" a "$sub" }; then
      print -u2 "chezmoi: refusing update with $a: update-only flags are not supported: the wrapper always pulls origin's main and then applies it"
      return 1
    fi
  done
  local src st want head url tmp base verb=applies act=applying
  [[ $sub == (apply|update) ]] || { verb="runs on"; act="running $sub on" }
  local -a g
  url=${CHEZMOI_REVIEWED_ORIGIN:-git@github.com:michaelrigart/dotfiles.git}
  src=$(command chezmoi source-path) || return
  g=(git -c core.fsmonitor=false -C "$src")
  local hint="  (chezmoi $sub --dirty-ok $verb the working tree anyway)"
  [[ $("${g[@]}" symbolic-ref -q --short HEAD) == main ]] \
    || { print -u2 "chezmoi: refusing $sub: $src is not on main"; print -u2 -- $hint; return 1 }
  st=$("${g[@]}" status --porcelain --untracked-files=all) || return
  if [[ -n $st ]]; then
    print -u2 "chezmoi: refusing $sub: $src has uncommitted or untracked changes:"
    print -u2 -r -- "$st"
    print -u2 -- $hint
    return 1
  fi
  if [[ $sub == update ]]; then
    # The refspec moves refs/remotes/origin/main with the pull; otherwise the checkout reads
    # "ahead" of a stale origin/main and the push guard lists the merged commits as outgoing.
    "${g[@]}" pull -q --ff-only "$url" +refs/heads/main:refs/remotes/origin/main || { print -u2 "chezmoi: git pull --ff-only failed in $src"; return 1 }
  fi
  # -C /: no repository, so no checkout configuration (url rewrites included) reaches these.
  want=$(git -C / ls-remote "$url" refs/heads/main) || { print -u2 "chezmoi: refusing $sub: cannot read origin's main"; print -u2 -- $hint; return 1 }
  want=${want%%$'\t'*}
  [[ $want =~ '^[0-9a-f]{40}([0-9a-f]{24})?$' ]] || { print -u2 "chezmoi: refusing $sub: origin has no main"; print -u2 -- $hint; return 1 }
  head=$("${g[@]}" rev-parse HEAD) || return
  [[ $head == $want ]] || {
    print -u2 "chezmoi: refusing $sub: $src is at ${head[1,12]}, origin's main is ${want[1,12]}; pull or push first"
    print -u2 -- $hint
    return 1
  }
  # The clone lives where the sandbox cannot write (~/.cache is outside its write set), and
  # chezmoi writes its scripts there too: nothing sandboxed can change them between the check
  # and the apply.
  base=${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-apply
  mkdir -p -m 700 "$base" && tmp=$(mktemp -d "$base/run.XXXXXX") || return
  {
    git -C / clone -q --depth 1 --branch main --template= -- "$url" "$tmp/src" \
      || { print -u2 "chezmoi: cannot clone origin's main"; return 1 }
    [[ $(git -C "$tmp/src" rev-parse HEAD) == $want ]] \
      || { print -u2 "chezmoi: origin's main moved during the clone; run it again"; return 1 }
    print -u2 "chezmoi: $act origin's main ${want[1,12]} from a fresh clone"
    [[ $sub == update ]] && args[${args[(i)update]}]=apply
    mkdir -p "$tmp/tmp" && TMPDIR="$tmp/tmp" command chezmoi --source "$tmp/src" "${args[@]}"
  } always {
    rm -rf -- "$tmp"
  }
}
