#!/usr/bin/env zsh

# Set XDG Base Directory Specification environment variables
test "$XDG_CACHE_HOME"  || export XDG_CACHE_HOME="$HOME/.cache"
test "$XDG_CONFIG_HOME" || export XDG_CONFIG_HOME="$HOME/.config"
test "$XDG_DATA_HOME"   || export XDG_DATA_HOME="$HOME/.local/share"
test "$XDG_STATE_HOME"  || export XDG_STATE_HOME="$HOME/.local/state"
test "$XDG_BIN_HOME"    || export XDG_BIN_HOME="$HOME/.local/bin"
test "$XDG_LIB_HOME"    || export XDG_LIB_HOME="$HOME/.local/lib"

# Set ARCHFLAGS to force target builds
export ARCHFLAGS="-arch $(uname -m)"

# Homebrew configuration. FIRST, because `brew shellenv` PREPENDS /opt/homebrew/bin:
# anything put on PATH before it ends up behind Homebrew, which is how Homebrew's codex
# came to shadow the ~/.local/bin/codex launcher. shellenv also exports HOMEBREW_PREFIX,
# so nothing below calls `brew --prefix` (which can reach the network).
eval "$(/opt/homebrew/bin/brew shellenv zsh)"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_BUNDLE_FILE="$XDG_CONFIG_HOME/homebrew/Brewfile"

# Then the user's own bins, in FRONT of Homebrew: ~/.local/bin first, then krew.
# tests/zshenv.test.sh pins this order.
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
export PATH=$XDG_BIN_HOME:$PATH

# NOTE: TERM is intentionally NOT forced here — Ghostty sets xterm-ghostty
# locally (full features). Terminfo-poor remotes are handled per-tool: ssh via
# Ghostty's ssh-env/ssh-terminfo, Teleport via the tsh() wrapper in zsh/functions.

# Set ZSH compdump file. No ${HOST}: it varies (this cache holds dumps named 0.0.0.0 and
# fenrir), and every new name costs a full compinit.
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

# Path to oh-my-zsh installation.
export ZSH="$XDG_DATA_HOME/oh-my-zsh"

# Set language environment
export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Bundler config vars
export BUNDLE_USER_CACHE="$XDG_CACHE_HOME/bundler/cache"
export BUNDLE_USER_CONFIG="$XDG_CONFIG_HOME/bundler/config"
export BUNDLE_USER_PLUGIN="$XDG_CACHE_HOME/bundler/plugin"

# GEMRC file location
export GEMRC="$XDG_CONFIG_HOME/gem/config"
export GEM_SPEC_CACHE="$XDG_CACHE_HOME/gem/specs"

# Starship config location
export STARSHIP_CONFIG=$XDG_CONFIG_HOME/starship/config.toml

# Ruby jemalloc
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/jemalloc/lib"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/jemalloc/include"
export RUBY_CONFIGURE_OPTS="--with-jemalloc=$HOMEBREW_PREFIX/opt/jemalloc"
