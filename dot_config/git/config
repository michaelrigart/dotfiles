[user]
    name = Michaël Rigart
    email = michael@netronix.be
    signingkey = ~/.config/git/signing.pub
[core]
    pager = delta
    hooksPath = ~/.config/git/hooks
    excludesfile = ~/.config/git/gitignore_global
[color "branch"]
    local = yellow
    remote = blue
[color "diff"]
    meta = yellow
    frag = magenta
[color "status"]
    changed = yellow
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[alias]
    st = status
    ci = commit
    co = checkout
    di = diff
    dc = diff --cached
    amend = commit --amend
    aa = add --all
    head = !git l -1
    h = !git head
    r = !git --no-pager l -20
    ra = !git r --all
    ff = merge --ff-only
    l = log --graph --abbrev-commit --date=relative --pretty=\"format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset\"
    la = !git l --all
    fa = fetch --all
    pom = push origin main
[merge]
    tool = vimdiff
    conflictStyle = zdiff3
[commit]
    gpgsign = true
    template = ~/.config/git/templates/gitmessage
    verbose = true
[rebase]
    autoSquash = true
    updateRefs = true
[rerere]
    enabled = true
[init]
	templatedir = ~/.config/git/templates
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[pull]
	ff = only
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    algorithm = histogram
[safe]
    bareRepository = explicit
