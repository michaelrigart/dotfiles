[user]
    name = Michaël Rigart
    email = michael@netronix.be
    signingkey = ~/.config/git/signing.pub
[core]
    pager = delta
    excludesfile = ~/.config/git/gitignore_global
    filemode = true
[color]
    ui = auto
[color "branch"]
    current = green
    local = yellow
    remote = blue
[color "diff"]
    meta = yellow
    frag = magenta
    old = red
    new = green
[color "status"]
    added = green
    changed = yellow
    untracked = red
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[alias]
    st = status
    ci = commit
    co = checkout
    di = diff
    dc = diff --cached
    amend = commit --amend
    aa = add --all
    head = !git l -1
    h = !git head
    r = !git --no-pager l -20
    ra = !git r --all
    ff = merge --ff-only
    l = log --graph --abbrev-commit --date=relative
    la = !git l --all
    fa = fetch --all
    pom = push origin main
[format]
    pretty=format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset
[merge]
    tool = vimdiff
    conflictStyle = zdiff3
[commit]
    gpgsign = true
    template = ~/.config/git/templates/gitmessage
[init]
	templatedir = ~/.config/git/templates
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[pull]
	ff = only
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    algorithm = histogram
