#!/bin/zsh
# close-own-tab — close the app tab this script's terminal is in.
#
# For the helper a key starts in a tab of its own (open-space --pick): the app leaves a shell
# behind when such a command ends, so a helper with nothing left to say closes its tab itself.
# Outside the app's terminals it does nothing.
#
# It runs unsandboxed, so its PATH is pinned before anything runs: a folder the caller's PATH
# puts first (a repository's mise _.path) must not supply herdr-app or jq.
PATH=$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin
emulate -L zsh
[[ -n "${HC_TERMINAL_ID:-}" ]] || exit 0
tab=$(command herdr-app ls | jq -r --arg t "$HC_TERMINAL_ID" \
  'first(.spaces[].tabs[] | select(any(.terminals[]; .terminal == $t)) | .id) // empty')
[[ -n $tab ]] || exit 0
command herdr-app do tab.close "$(jq -nc --arg id "$tab" '{id: $id, confirmed: true}')" >/dev/null
