#!/bin/zsh
# wt-app --prompt               — `wt`, asking for the branch. The app's new-worktree key and the
#                                 space menu's New worktree run this in a popup (mods/popup),
#                                 which closes when it ends.
# wt-app <branch> [start-point] — hands over to `wt`. This plain form and --no-focus remain for
#                                 sessions recorded with the path (their system prompt and
#                                 --settings name it), until the TUI is retired.
# wt-app --no-focus <branch> .. — the same, leaving the user's focus where it was.
#
# `wt` (~/.config/zsh/functions) makes the checkout under its own lifecycle and, from an app
# terminal, `dev` opens it as a space (open-space). Run from inside the repository or one of its
# worktrees, as with `wt`. It keeps the caller's PATH: it is `wt`.

prompt= nofocus=
while [[ "${1:-}" == --prompt || "${1:-}" == --no-focus ]]; do
  [[ $1 == --prompt ]] && prompt=1 || nofocus=1
  shift
done

# The popup closes with this command, so what Michael must be able to read is held open as
# wt-prompt does in the TUI: a failure, and the lines a reopen leaves in _WT_NOTICE (the
# untrusted-config report, the never-prepared line after a carry). Only --prompt has a popup.
hold() {
  [[ -n $prompt ]] || return 0
  print -r -- "Press Enter to close."
  IFS= read -r || true
}

if [[ -n $prompt ]]; then
  print -n -- "Branch: "
  IFS= read -r branch || branch=""
  [[ -n $branch ]] || { print -ru2 -- "wt-app: cancelled (no branch entered)."; exit 1 }
  set -- "$branch"
fi
[[ -n "${1:-}" ]] || { print -ru2 -- "usage: wt-app [--no-focus] <branch> [start-point] | wt-app [--no-focus] --prompt"; exit 1 }

source "$HOME/.config/zsh/functions" || { hold; exit 1 }
(( $+functions[wt] )) || {
  print -ru2 -- "wt-app: ~/.config/zsh/functions no longer defines wt."; hold; exit 1 }

wt ${nofocus:+--no-focus} "$@"
rc=$?
if (( rc != 0 )) || [[ -n "${_WT_NOTICE:-}" ]]; then hold; fi
exit $rc
