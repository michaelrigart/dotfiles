#!/bin/zsh
# wt-app --prompt               — `wt-prompt`, the TUI's popup surface: it asks for the branch and
#                                 holds on what must be read. The app's new-worktree key and the
#                                 space menu's New worktree run this in a popup (mods/popup),
#                                 which closes when it ends.
# wt-app <branch> [start-point] — hands over to `wt`. This plain form and --no-focus remain for
#                                 sessions recorded with the path (their system prompt and
#                                 --settings name it), until the TUI is retired.
# wt-app --no-focus <branch> .. — the same, leaving the user's focus where it was.
#
# `wt` (~/.config/zsh/functions) makes the checkout under its own lifecycle and, from an app
# terminal, `dev` opens it as a space (open-space). Run from inside the repository or one of its
# worktrees, as with `wt`. It keeps the caller's PATH: it is `wt`.

prompt= nofocus=
while [[ "${1:-}" == --prompt || "${1:-}" == --no-focus ]]; do
  [[ $1 == --prompt ]] && prompt=1 || nofocus=1
  shift
done
usage="usage: wt-app [--no-focus] <branch> [start-point] | wt-app --prompt"
[[ -z $prompt || -z $nofocus ]] || { print -ru2 -- "$usage"; exit 1 }
[[ -n $prompt || -n "${1:-}" ]] || { print -ru2 -- "$usage"; exit 1 }

# The popup closes with this command, so a failure before wt-prompt takes over is held open
# the way wt-prompt holds its own.
hold() {
  print -r -- "Press Enter to close."
  IFS= read -r || true
}

source "$HOME/.config/zsh/functions" || { [[ -z $prompt ]] || hold; exit 1 }

if [[ -n $prompt ]]; then
  (( $+functions[wt-prompt] )) || {
    print -ru2 -- "wt-app: ~/.config/zsh/functions no longer defines wt-prompt."; hold; exit 1 }
  wt-prompt
  exit $?
fi

(( $+functions[wt] )) || {
  print -ru2 -- "wt-app: ~/.config/zsh/functions no longer defines wt."; exit 1 }

wt ${nofocus:+--no-focus} "$@" || exit 1
