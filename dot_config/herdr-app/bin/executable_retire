#!/bin/zsh
# retire <worktree-folder> — retire one `wt` worktree for the app. The menu's "Retire
# worktree" runs this in a tab of its own, never inside a space it closes.
#
# In this order:
#   1. The refusals that make `retire <folder>` act on the same folder as `wt-rm <branch>`:
#      not the main checkout, not a detached HEAD, and the folder is where wt puts the
#      branch's worktree. Nothing else is checked here.
#   2. `checkout-spaces list`: which app spaces are the checkout's, and their resume records,
#      kept for a reopen. An unreachable app refuses; nothing is closed or removed.
#   3. wt-rm <branch> from the main checkout. It is the one that checks (clean, hook, lock,
#      busy agents, editors), prints the resume commands, closes the checkout's app spaces
#      through `checkout-spaces close` and removes the checkout. Retire closes no space itself.
#   4. wt-rm succeeded and wrote nothing to stderr: close this tab. Warnings go to stderr, but
#      so do a clean run's archive report and teardown hooks, so the tab usually waits for
#      Enter. After a failure its output stays; if the spaces listed in step 2 did close and the
#      checkout is still there, Enter reopens the worktree's space with its agents resumed.
#      A refusal before any close leaves the spaces open: there is nothing to reopen.
#
# RETIRE_WT_RM replaces the wt-rm command; for the tests only.
emulate -L zsh
# no_multios: with it, `1>&3 | tee` would also send stdout down the pipe.
setopt pipe_fail no_multios

here=${0:A:h}
wt_rm=${RETIRE_WT_RM:-$HOME/.local/bin/wt-rm}
refuse() {
  print -ru2 -- "retire: refusing — $*"
  print -ru2 -- "retire: nothing was closed or removed."
  exit 1
}

(( $# == 1 )) || { print -ru2 -- "usage: retire <worktree-folder>"; exit 1 }
folder=${1:A}
[[ -d $folder ]] || refuse "no such folder: $folder"

source "$HOME/.config/zsh/functions" || exit 1
for fn in _wt_git _wt_primary; do
  (( $+functions[$fn] )) || refuse "~/.config/zsh/functions no longer defines $fn."
done
[[ -x $wt_rm ]] || refuse "$wt_rm is not executable."

# --- 1. The folder wt-rm would act on --------------------------------------------------
main=$(builtin cd -q -- "$folder" && _wt_primary) || refuse "$folder is not in a git repository."
[[ $folder != ${main:A} ]] || refuse "$folder is the main checkout, not a linked worktree."
branch=$(_wt_git -C "$folder" symbolic-ref --quiet --short HEAD 2>/dev/null) \
  || refuse "$folder is on a detached HEAD."
# wt-rm acts on the sibling folder wt makes for the branch and on nothing else.
[[ $folder == "${main:A:h}/${main:A:t}-${branch//\//-}" ]] \
  || refuse "$folder is not where wt puts the worktree of '$branch'."

# --- 2. The checkout's app spaces ------------------------------------------------------
listing=$("$here/checkout-spaces" list "$folder") || refuse "cannot read the app's spaces (is the window open?)."
spaces=( $(jq -r '.spaces[]' <<<"$listing") )
records=$(jq -c .records <<<"$listing")

# --- 3. wt-rm --------------------------------------------------------------------------
print -r -- "retire: running wt-rm $branch from $main"
# stderr goes through tee: it stays on screen and is kept to see whether wt-rm warned.
errs=$(mktemp "${TMPDIR:-/tmp}/retire.XXXXXX") || exit 1
trap 'rm -f "$errs"' EXIT
{ (builtin cd -q -- "$main" && "$wt_rm" "$branch") 2>&1 1>&3 3>&- | tee "$errs" >&2; rc=${pipestatus[1]} } 3>&1

# --- 4. Outcome ------------------------------------------------------------------------
if (( rc == 0 )); then
  if [[ ! -s $errs ]]; then "$here/close-own-tab"; exit 0; fi
  print -ru2 -- ""
  print -n -- "retire: wt-rm succeeded but warned (above). Press Enter to close this tab. "
  read -r && "$here/close-own-tab"
  exit 0
fi

print -ru2 -- ""
print -ru2 -- "retire: wt-rm failed (status $rc); its output is above."
(( $#spaces )) || { print -ru2 -- "retire: the checkout had no app spaces; there is nothing to reopen."; exit $rc }
[[ -d $folder ]] || { print -ru2 -- "retire: $folder is gone; there is nothing to reopen."; exit $rc }
now=$("$here/checkout-spaces" list "$folder") \
  || { print -ru2 -- "retire: cannot read the app's spaces; not offering a reopen."; exit $rc }
if [[ -n $(jq -r --argjson s "$(jq -nc '$ARGS.positional' --args $spaces)" '.spaces[] | select(. as $i | $s | index($i))' <<<"$now") ]]; then
  print -ru2 -- "retire: the app spaces are still open; there is nothing to reopen."
  exit $rc
fi
print -n -- "retire: Enter reopens the space with its agents resumed, Ctrl-C leaves it closed. "
read -r || exit $rc

reopen=()
for want in claude codex; do
  # First record of each agent: a space's agents tab holds one of each.
  rec=$(jq -c --arg a "$want" 'map(select(.app == $a)) | first // empty' <<<"$records")
  [[ -n $rec ]] || continue
  if "$here/session-written" "$want" "$(jq -r .id <<<"$rec")"; then pick=cmd; else pick=fresh; fi
  reopen+=( --$want-cmd "$(jq -r --arg k $pick '.[$k]' <<<"$rec")" )
done
"$here/open-space" "${reopen[@]}" "$folder"
exit $rc
