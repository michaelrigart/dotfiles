{{- /* Identity is read LIVE from scutil, not from chezmoi's .hostname: .hostname is
     captured once at `chezmoi init` and never refreshed, so after a rename it reports
     the old name forever and a guard built on it could never fire. */ -}}
{{- $live := output "scutil" "--get" "ComputerName" | trim -}}
{{- $hn := output "scutil" "--get" "HostName" | trim -}}
{{- if not (has $live .known_hostnames) -}}
{{-   fail (printf "unknown machine %q — add it to .chezmoidata/machines.toml" $live) -}}
{{- end -}}
{{- /* HostName is checked too: it is what hostname(1) and therefore Borg archive
     naming resolve to, so ComputerName=fenrir with HostName=hercules would silently
     back up under the wrong identity. Unset prints "HostName: not set" on exit 0. */ -}}
{{- if hasPrefix "HostName: not set" $hn -}}
{{-   fail (printf "HostName is unset on %q — run: sudo scutil --set HostName %s" $live $live) -}}
{{- end -}}
{{- if ne $hn $live -}}
{{-   fail (printf "identity mismatch: ComputerName %q but HostName %q" $live $hn) -}}
{{- end -}}

# tap repositories and their packages
#
# Inline comments record where a package is actually used, so a future audit can
# tell a live dependency from a leftover. Undocumented entries are self-evident.
# pkgconf and poppler are deliberately NOT declared: they arrive transitively via
# vips/hdf5/libmatio, and declaring them would promote them to permanent
# top-level requirements they aren't.

tap "basecamp/tap"
tap "satococoa/tap"
tap "skyhook-io/tap"

# ansible: managed by mise (~/.config/mise/config.toml), not Homebrew, so provisioning
# repos can pin their own version via a project mise.toml.
brew "arping"                          # edge-node network diagnostics
brew "asitop"
brew "awscli"
brew "azure-cli"
brew "borgbackup"                      # Vorta requires it. The borgbackup-fuse variant
                                       # was dropped 2026-08-28: it exists only for
                                       # `borg mount`, which needs a macFUSE kernel
                                       # extension that was never approved on either
                                       # machine, so mount has never worked. Everything
                                       # else — backup, restore, check, prune, extract —
                                       # is unaffected.
brew "btop"
brew "chezmoi"
brew "coreutils"
brew "direnv"
brew "exiftool"                        # Trainvault lib/active_storage/exif_analyzer.rb (mini_exiftool); Curato
brew "eza"
