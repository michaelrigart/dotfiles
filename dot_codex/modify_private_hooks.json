{{- /* chezmoi:modify-template */ -}}
{{- /* Own ~/.codex/hooks.json so the Herdr registration survives reprovisioning.
       Without an owner here the codex hook SCRIPT and features.hooks would both
       deploy while the registration connecting them never did — cold restore
       silently dead, every visible artifact present and correct.

       Merge-preserving: any other SessionStart hook is kept, and only Herdr's own
       entry is added. Shape mirrors what `herdr integration install codex` writes,
       observed rather than guessed: a `session` argument, timeout 10, and an
       absolute path to the script.                                              */ -}}
{{- $cfg := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $cfg = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $hooks := dict -}}
{{- if hasKey $cfg "hooks" -}}{{- $hooks = get $cfg "hooks" -}}{{- end -}}
{{- $start := list -}}
{{- if hasKey $hooks "SessionStart" -}}{{- $start = get $hooks "SessionStart" -}}{{- end -}}
{{- $cmd := printf "bash '%s/.codex/herdr-agent-state.sh' session" .chezmoi.homeDir -}}
{{- /* The pane-map hook reconciles herdr's session ids from the pane titles. Herdr's own
       hook exits inside the daemon (no pane environment there), so this is the one that
       reports. Spec: docs/superpowers/specs/2026-09-26-xreview-codex-daemon-design.md §6. */ -}}
{{- /* Pinned to the system interpreter (F3): this hook runs inside the Codex daemon,
       where PATH must not be able to shadow python3. */ -}}
{{- $mapCmd := printf "/usr/bin/python3 '%s/.codex/herdr-codex-pane-map.py'" .chezmoi.homeDir -}}
{{- /* Drop any existing entry of ours first, so re-applying cannot duplicate either. */ -}}
{{- $kept := list -}}
{{- range $start -}}
{{-   $ours := false -}}
{{-   range (get . "hooks" | default list) -}}
{{-     $c := get . "command" | default "" -}}
{{-     if or (contains "herdr-agent-state.sh" $c) (contains "herdr-codex-pane-map.py" $c) -}}
{{-       $ours = true -}}
{{-     end -}}
{{-   end -}}
{{-   if not $ours -}}{{- $kept = append $kept . -}}{{- end -}}
{{- end -}}
{{- $entry := dict "hooks" (list (dict "type" "command" "command" $cmd "timeout" 10)) -}}
{{- $mapEntry := dict "hooks" (list (dict "type" "command" "command" $mapCmd "timeout" 10)) -}}
{{- $hooks = set $hooks "SessionStart" (append (append $kept $entry) $mapEntry) -}}
{{- $cfg = set $cfg "hooks" $hooks -}}
{{ $cfg | toPrettyJson }}
