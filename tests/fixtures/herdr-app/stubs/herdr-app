#!/bin/sh
# Stub herdr-app for tests/herdr-app.test.sh: logs every call to $STUB_LOG and answers from the fixture
# $STUB_LS, minus the spaces a `space.close` has closed since. `ls` fails when $STUB_LS_DOWN is set.
echo "herdr-app $*" >> "$STUB_LOG"
case "$1" in
  status) [ -z "$STUB_DOWN" ] || exit 1; echo '{"errors":[]}' ;;
  ls)
    [ -z "${STUB_LS_DOWN:-}" ] || exit 1
    jq --rawfile c "$STUB_DIR/closed" \
      '($c | split("\n")) as $x | .spaces |= map(select(.id as $i | $x | index($i) | not))' "$STUB_LS" ;;
  do)
    case "$2" in
      space.close)
        jq -r .id <<EOT >> "$STUB_DIR/closed"
$3
EOT
        # The app forgets nothing itself, but resume's records follow its terminals: gone
        # once the space is, so retire has to have read them first.
        rm -f "$HERDR_APP_HOME/shared.json"
        echo '{}' ;;
      space.new) echo '{"space":"spNEW","tab":"tbNEW","terminal":"tNEW1"}' ;;
      tab.new) echo '{"space":"spNEW","tab":"tbNEW2","terminal":"tNEW2"}' ;;
      *) echo '{}' ;;
    esac ;;
  *) echo '{}' ;;
esac
