# Targets chezmoi removes from $HOME. chezmoi acts on these only while this file
# exists, so entries stay permanently — a removal entry is a tombstone, not stale
# configuration. Removing an absent path is a no-op.

# Zellij, retired 2026-08-30. Removes the config, the dev layout and the
# vim-zellij-navigator WASM that .chezmoiexternal.toml used to fetch beneath it.
.config/zellij

# The subagent statusline, retired 2026-09-30: it never rendered.
.claude/subagent-statusline.sh

# LazyVim starter leftovers: an example spec that returns {} before loading anything,
# and the starter README.
.config/nvim/lua/plugins/example.lua
.config/nvim/README.md

# Left behind by the retired oh-my-zsh mise plugin. oh-my-zsh puts $ZSH/cache/completions
# first in fpath, so this stale copy shadows the Homebrew _mise and is never regenerated.
.local/share/oh-my-zsh/cache/completions/_mise
